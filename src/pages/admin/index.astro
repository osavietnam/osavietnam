---
import { readAdminSession } from '../../lib/admin-auth';

export const prerender = false;
const authenticated = Boolean(readAdminSession(Astro.request));
Astro.response.headers.set('Cache-Control', 'no-store, private');
Astro.response.headers.set('X-Frame-Options', 'DENY');
Astro.response.headers.set('Referrer-Policy', 'same-origin');
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <title>Content Studio | OSA Việt Nam</title>
  <style>
    :root{font-family:"Be Vietnam Pro",Inter,system-ui,sans-serif;color:#183f2c;background:#123c2a;--green:#176143;--soft:#edf4ef;--gold:#9c7b3f;--ink:#183f2c;--muted:#65786e;--line:#d3dfd7;--paper:#fbfcfa;--danger:#9c3535}*{box-sizing:border-box}body{margin:0;min-width:320px}button,input,textarea,select{font:inherit}button{cursor:pointer}[hidden]{display:none!important}
    .page{min-height:100vh;padding:clamp(.75rem,2vw,2rem);background:radial-gradient(circle at 80% 10%,rgba(214,190,122,.18),transparent 28rem),linear-gradient(145deg,rgba(9,52,35,.96),rgba(23,83,57,.9)),url('/images/emblem-color-transparent.png') center/28rem no-repeat}.studio{width:min(1480px,100%);min-height:calc(100vh - clamp(1.5rem,4vw,4rem));margin:auto;overflow:hidden;border:1px solid #ffffff40;border-radius:16px;background:var(--paper);box-shadow:0 28px 80px #00000047}
    .studio-head{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.5rem 1rem 4.75rem;border-bottom:1px solid var(--line);position:relative}.emblem{position:absolute;left:1.4rem;width:2.55rem;height:2.55rem;object-fit:contain}.eyebrow{margin:0 0 .15rem;color:var(--green);font-size:.74rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}h1,h2,h3{font-family:Georgia,"Noto Serif",serif}.studio-head h1{margin:0;font-size:clamp(1.45rem,2vw,2rem);font-weight:600}.head-actions,.editor-actions{display:flex;align-items:center;gap:.55rem}
    .btn{border:1px solid #b8cbbf;border-radius:8px;padding:.68rem 1rem;color:var(--ink);background:#fff;font-weight:750;line-height:1.1;text-decoration:none}.btn:hover{border-color:var(--green);background:#f4f8f5}.btn-primary{color:#fff;border-color:var(--green);background:var(--green)}.btn-primary:hover{color:#fff;background:#0f5137}.btn-danger{color:var(--danger);border-color:#e5c5c5;background:#fffafa}.btn-icon{width:2.65rem;height:2.65rem;padding:0;font-size:1.15rem}
    .workspace{display:grid;grid-template-columns:minmax(18rem,27rem) minmax(0,1fr);min-height:calc(100vh - 7.1rem)}.index{border-right:1px solid var(--line);background:#f6f9f6;display:flex;flex-direction:column;min-height:0}.search-deck{display:grid;grid-template-columns:1fr 8rem;gap:.5rem;padding:.85rem;border-bottom:1px solid var(--line);background:var(--soft)}.control{position:relative}.control span{position:absolute;left:.85rem;top:50%;transform:translateY(-50%);color:#60766a}.control input,.control select{width:100%;height:3rem;border:1px solid #b8cbbf;border-radius:9px;color:var(--ink);background:white;outline:none}.control input{padding:0 .8rem 0 2.35rem}.control select{padding:0 .65rem}.control input:focus,.control select:focus,.field input:focus,.field textarea:focus{border-color:var(--green);box-shadow:0 0 0 3px #1761431c}
    .post-list{overflow:auto;flex:1}.post-row{width:100%;display:block;padding:1rem 1.2rem;text-align:left;border:0;border-bottom:1px solid #e0e8e2;background:transparent}.post-row:hover,.post-row.is-active{background:#fff;box-shadow:inset 3px 0 var(--green)}.post-row h3{margin:0 0 .35rem;font-family:inherit;font-size:.94rem;line-height:1.45}.post-meta{display:flex;justify-content:space-between;align-items:center;gap:.75rem;color:var(--muted);font-size:.73rem}.status{border-radius:999px;padding:.12rem .45rem;font-size:.64rem;font-weight:800;text-transform:uppercase;white-space:nowrap}.status.published{color:#176143;background:#dceee3}.status.draft{color:#8a6a2f;background:#f3ead3}.empty{padding:3rem 1.5rem;color:var(--muted);text-align:center}
    .editor{min-width:0;background:#fff}.editor-empty{min-height:70vh;display:grid;place-content:center;gap:.5rem;color:var(--muted);text-align:center}.doc-icon{color:var(--gold);font-size:2.2rem}.editor-empty strong{color:var(--ink);font-family:Georgia,serif;font-size:1.15rem}.editor-form{height:100%;display:flex;flex-direction:column}.editor-titlebar{padding:1.25rem 1.5rem .6rem}.editor-titlebar h2{margin:.15rem 0;font-size:1.45rem}.editor-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;padding:.8rem 1.5rem 1.5rem;overflow:auto}.field{display:grid;gap:.38rem}.field.full{grid-column:1/-1}.field label{color:#3f5a4b;font-size:.78rem;font-weight:800}.field input,.field textarea{width:100%;border:1px solid #c4d0c8;border-radius:7px;padding:.72rem .78rem;color:#203d2e;background:#fff;outline:none}.field textarea{resize:vertical;line-height:1.65}.body-field textarea{min-height:18rem;font-family:Georgia,"Noto Serif",serif;font-size:1rem}.publish-card{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.8rem 1rem;border:1px solid var(--line);border-radius:8px;background:#f7faf8}.publish-card select{border:1px solid #b8cbbf;border-radius:7px;padding:.55rem .7rem;background:white}.editor-footer{margin-top:auto;min-height:70px;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.85rem 1.5rem;border-top:1px solid var(--line);background:#fbfcfb}.message{margin:.5rem 0;color:var(--danger);font-size:.83rem;min-height:1.2rem}.message.ok{color:var(--green)}
    .login-wrap{min-height:calc(100vh - 7rem);display:grid;place-content:center;padding:2rem}.login-card{width:min(27rem,90vw);padding:2.25rem;border:1px solid var(--line);border-radius:14px;background:#fff;box-shadow:0 18px 60px #082a231f}.login-emblem{display:block;width:4.5rem;height:4.5rem;margin:0 auto 1.25rem}.login-card h1{margin:0 0 .4rem;text-align:center}.login-card>p{margin:0 0 1.6rem;color:var(--muted);text-align:center}.login-card .field{margin-top:.9rem}.login-card .btn-primary{width:100%;margin-top:.4rem;padding:.85rem}
    @media(max-width:820px){.page{padding:0}.studio{min-height:100vh;border-radius:0}.studio-head{padding-left:1rem}.studio-head .emblem,.head-label .eyebrow{display:none}.head-actions .btn:first-child{display:none}.workspace{grid-template-columns:1fr}.index{border-right:0}.index.has-selection{display:none}.editor:not(.has-selection){display:none}.editor-fields{grid-template-columns:1fr}.field.full{grid-column:auto}.editor-footer{align-items:stretch;flex-direction:column}.editor-actions{justify-content:flex-end}}
  </style>
</head>
<body>
<main class="page"><section class="studio">
  {authenticated ? <>
    <header class="studio-head">
      <img class="emblem" src="/images/emblem-color-transparent.png" alt="" />
      <div class="head-label"><p class="eyebrow">Biên tập trực tiếp · Tin tức</p><h1>Bài viết</h1></div>
      <div class="head-actions"><a class="btn" href="/tin-tuc/" target="_blank" rel="noopener">Xem trang ↗</a><button class="btn btn-primary" id="new-post" type="button">+ Thêm bài</button><button class="btn btn-icon" id="logout" type="button" aria-label="Đăng xuất" title="Đăng xuất">×</button></div>
    </header>
    <div class="workspace">
      <aside class="index" id="index-panel">
        <div class="search-deck"><label class="control"><span>⌕</span><input id="search" type="search" placeholder="Tìm bài viết…" /></label><label class="control"><select id="status-filter" aria-label="Lọc trạng thái"><option value="">Tất cả</option><option value="published">Đã đăng</option><option value="draft">Bản nháp</option></select></label></div>
        <div class="post-list" id="post-list"><p class="empty">Đang tải…</p></div>
      </aside>
      <section class="editor" id="editor-panel">
        <div class="editor-empty" id="editor-empty"><span class="doc-icon">▤</span><strong>Chọn một bài để biên tập</strong><span>Hoặc tạo bài mới ngay trên trang này.</span></div>
        <form class="editor-form" id="post-form" hidden>
          <input type="hidden" id="post-id" />
          <div class="editor-titlebar"><p class="eyebrow">Nội dung bài viết</p><h2 id="editor-title">Tạo bài viết</h2></div>
          <div class="editor-fields">
            <div class="field full"><label for="title">Tiêu đề</label><input id="title" required maxlength="255" /></div>
            <div class="field"><label for="slug">Slug</label><input id="slug" maxlength="180" placeholder="tự tạo từ tiêu đề" pattern="[a-z0-9-]*" /></div>
            <div class="field"><label for="author">Tác giả</label><input id="author" maxlength="160" /></div>
            <div class="field full"><label for="excerpt">Mô tả ngắn</label><textarea id="excerpt" rows="3"></textarea></div>
            <div class="field full body-field"><label for="body">Nội dung bài viết</label><textarea id="body" rows="14" required></textarea></div>
            <div class="field full"><div class="publish-card"><label for="status">Trạng thái xuất bản</label><select id="status"><option value="draft">Bản nháp</option><option value="published">Xuất bản ngay</option></select></div></div>
          </div>
          <footer class="editor-footer"><p class="message" id="post-message" role="status"></p><div class="editor-actions"><button class="btn btn-danger" id="delete-post" type="button" hidden>Xóa bài</button><button class="btn" id="cancel-edit" type="button">Hủy</button><button class="btn btn-primary" id="save-post" type="submit">Lưu bài viết</button></div></footer>
        </form>
      </section>
    </div>
  </> :
    <div class="login-wrap"><form class="login-card" id="login-form"><img class="login-emblem" src="/images/emblem-color-transparent.png" alt="" /><h1>Content Studio</h1><p>Đăng nhập để quản trị nội dung OSA Việt Nam</p><div class="field"><label for="username">Tên đăng nhập</label><input id="username" name="username" autocomplete="username" required autofocus /></div><div class="field"><label for="password">Mật khẩu</label><input id="password" name="password" type="password" autocomplete="current-password" required /></div><p class="message" id="login-message" role="alert"></p><button class="btn btn-primary" type="submit">Đăng nhập</button></form></div>
  }
</section></main>
<script is:inline define:vars={{ authenticated }}>
  const request=async(url,options={})=>{const response=await fetch(url,{...options,headers:{'content-type':'application/json',...(options.headers||{})}});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Có lỗi xảy ra.');return data};
  if(!authenticated){document.querySelector('#login-form')?.addEventListener('submit',async event=>{event.preventDefault();const message=document.querySelector('#login-message'),submit=event.currentTarget.querySelector('button[type="submit"]');message.textContent='';submit.disabled=true;try{await request('/api/admin/session',{method:'POST',body:JSON.stringify({username:document.querySelector('#username').value,password:document.querySelector('#password').value})});location.reload()}catch(error){message.textContent=error.message;submit.disabled=false}})}else{
    let posts=[],activeId='';const byId=id=>document.getElementById(id);const fields=Object.fromEntries(['post-id','title','slug','author','excerpt','body','status'].map(id=>[id,byId(id)]));const form=byId('post-form'),empty=byId('editor-empty'),list=byId('post-list'),indexPanel=byId('index-panel'),editorPanel=byId('editor-panel'),message=byId('post-message');
    const showEditor=(post=null)=>{activeId=post?.id||'';fields['post-id'].value=activeId;fields.title.value=post?.title||'';fields.slug.value=post?.slug||'';fields.author.value=post?.author||'';fields.excerpt.value=post?.excerpt||'';fields.body.value=post?.body||'';fields.status.value=post?.status||'draft';byId('editor-title').textContent=post?post.title:'Tạo bài viết';byId('delete-post').hidden=!post;message.textContent='';message.classList.remove('ok');empty.hidden=true;form.hidden=false;indexPanel.classList.add('has-selection');editorPanel.classList.add('has-selection');render();requestAnimationFrame(()=>fields.title.focus())};
    const closeEditor=()=>{activeId='';form.reset();form.hidden=true;empty.hidden=false;indexPanel.classList.remove('has-selection');editorPanel.classList.remove('has-selection');render()};
    const filteredPosts=()=>{const query=byId('search').value.trim().toLocaleLowerCase('vi'),status=byId('status-filter').value;return posts.filter(post=>(!status||post.status===status)&&(!query||`${post.title} ${post.author||''}`.toLocaleLowerCase('vi').includes(query)))};
    const render=()=>{list.replaceChildren();const visible=filteredPosts();if(!visible.length){const node=document.createElement('p');node.className='empty';node.textContent=posts.length?'Không tìm thấy bài phù hợp.':'Chưa có bài viết.';list.append(node);return}visible.forEach(post=>{const row=document.createElement('button');row.type='button';row.className=`post-row${String(post.id)===String(activeId)?' is-active':''}`;const title=document.createElement('h3');title.textContent=post.title;const meta=document.createElement('div');meta.className='post-meta';const author=document.createElement('span');author.textContent=post.author||'OSA Việt Nam';const badge=document.createElement('span');badge.className=`status ${post.status}`;badge.textContent=post.status==='published'?'Đã đăng':'Bản nháp';meta.append(author,badge);row.append(title,meta);row.onclick=()=>showEditor(post);list.append(row)})};
    const load=async(selectId='')=>{list.innerHTML='<p class="empty">Đang tải…</p>';try{posts=(await request('/api/admin/posts')).posts;render();if(selectId){const selected=posts.find(post=>String(post.id)===String(selectId));if(selected)showEditor(selected)}}catch(error){list.innerHTML='';const node=document.createElement('p');node.className='empty message';node.textContent=error.message;list.append(node)}};
    form.addEventListener('submit',async event=>{event.preventDefault();if(!form.reportValidity())return;const save=byId('save-post');save.disabled=true;message.textContent='Đang lưu…';message.classList.remove('ok');const id=fields['post-id'].value,data={title:fields.title.value,slug:fields.slug.value,author:fields.author.value,excerpt:fields.excerpt.value,body:fields.body.value,status:fields.status.value};try{const result=await request(id?`/api/admin/posts/${id}`:'/api/admin/posts',{method:id?'PUT':'POST',body:JSON.stringify(data)});message.textContent=fields.status.value==='published'?'Đã lưu và xuất bản.':'Đã lưu bản nháp.';message.classList.add('ok');await load(result.id||id)}catch(error){message.textContent=error.message}finally{save.disabled=false}});
    byId('delete-post').onclick=async()=>{const id=fields['post-id'].value;if(!id||!confirm(`Xóa “${fields.title.value}”?`))return;try{await request(`/api/admin/posts/${id}`,{method:'POST',body:JSON.stringify({action:'delete'})});closeEditor();await load()}catch(error){message.textContent=error.message}};byId('new-post').onclick=()=>showEditor();byId('cancel-edit').onclick=closeEditor;byId('search').oninput=render;byId('status-filter').onchange=render;byId('logout').onclick=async()=>{await request('/api/admin/session',{method:'POST',body:JSON.stringify({action:'logout'})});location.reload()};load();
  }
</script>
</body></html>
