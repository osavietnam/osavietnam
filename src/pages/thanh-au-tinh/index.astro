}

/* Timeline refinement: a quiet vertical spine with compact, readable events. */
.tl-wrap { max-width: 112rem; padding: 1rem 2rem 6rem; }
.tl-flow {
  position: absolute;
  overflow: visible;
  top: 0;
  left: 50%;
  width: 12px;
  height: calc(100% - 4rem);
  transform: translateX(-50%);
  pointer-events: none;
  z-index: 0;
}
.tl-flow path {
  fill: none;
  stroke: rgba(123,167,188,.9);
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-dasharray: 4 5;
  animation: timeline-flow 2.8s linear infinite;
  filter: drop-shadow(0 0 3px rgba(123,167,188,.6));
}
.tl-row, .tl-era { position: relative; z-index: 1; }
.tl-wrap.timeline-reveal .tl-row,
.tl-wrap.timeline-reveal .tl-era {
  opacity: 0;
  transition: opacity .5s ease, transform .6s cubic-bezier(.22, 1, .36, 1);
}
.tl-wrap.timeline-reveal .tl-left { transform: translateX(-1.8rem); transition: transform .6s cubic-bezier(.22, 1, .36, 1); }
