const timelineVi = (value?: string) => value ? (PDF_TIMELINE_VI[value] ?? value) : undefined;

type TimelineOverride = Partial<{
  year: string;
  augEn: string;
  augVi: string;
  worldEn: string;
  worldVi: string;
  eraEn: string;
  eraVi: string;
  major: boolean;
}>;

const TIMELINE_OVERRIDES = timelineOverridesSource as Record<string, TimelineOverride>;
const EDITABLE_TIMELINE: TlEntry[] = PDF_TIMELINE.map((source, index) => {
  const id = `timeline-${String(index + 1).padStart(3, '0')}`;
  const patch = TIMELINE_OVERRIDES[id] ?? {};
  const aug = patch.augEn ?? source.aug;
  const world = patch.worldEn ?? source.world;
  const era = patch.eraEn ?? source.era;
  return {
    ...source,
    id,
    year: patch.year ?? source.year,
    aug,
    augVi: patch.augVi ?? timelineVi(aug),
    world,
    worldVi: patch.worldVi ?? timelineVi(world),
    era,
    eraVi: patch.eraVi ?? timelineVi(era),
    major: patch.major ?? source.major,
  };
});

interface TlGroup {
  year: string;
  era?: string;
  eraVi?: string;
  entries: TlEntry[];
  major: boolean;
}

const PDF_TIMELINE_GROUPS = EDITABLE_TIMELINE.reduce<TlGroup[]>((groups, row) => {
  const current = groups[groups.length - 1];
  if (current?.year === row.year) {
    current.entries.push(row);
    current.major ||= Boolean(row.major);
    current.era ??= row.era;
    current.eraVi ??= row.eraVi;
  } else {
    groups.push({ year: row.year, era: row.era, eraVi: row.eraVi, entries: [row], major: Boolean(row.major) });
  }
  return groups;
}, []);

