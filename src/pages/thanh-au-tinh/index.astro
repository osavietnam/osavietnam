<BaseLayout
  title="Thánh Augustinô thành Hippô"
  banner="thanh-au-tinh"
  bodyClass="no-sidebar page-thanh-au-tinh"
  type="article"
  description="Tiểu sử và niên biểu Thánh Augustinô thành Hippô — Tổ Phụ Dòng Augustinô, Giám Mục, Tiến Sĩ Hội Thánh."
>

<!-- ── Hero ── -->
<div class="aug-hero">
  <div class="aug-hero-text">
    <p class="aug-eyebrow" data-oe-target="ph" data-oe="eyebrow">{taPh.eyebrow}</p>
    <h1 class="aug-name" data-oe-target="ph" data-oe="name" data-oe-html="true" set:html={taPh.name.replace('\n','<br>')}></h1>
    <div class="aug-rule" aria-hidden="true"><span class="aug-rule-ornament">✦</span></div>
    <div class="aug-meta">
      <span class="aug-dates" data-oe-target="ph" data-oe="dates">{taPh.dates}</span>
      <span class="aug-sep" aria-hidden="true">·</span>
      <span class="rank-badge rank-solemn aug-feast" data-oe-target="ph" data-oe="feast">{taPh.feast}</span>
    </div>
    <blockquote class="aug-motto">
      <span data-oe-target="ph" data-oe="motto">{taPh.motto}</span>
      <cite data-oe-target="ph" data-oe="mottoCite" data-oe-html="true" set:html={taPh.mottoCite}></cite>
    </blockquote>
  </div>
  <figure class="aug-portrait" aria-label="Chân dung Thánh Augustinô">
    <div class="aug-arch-frame">
      <img src="/db/saints/images/st-augustine-of-hippo.jpg" alt="Thánh Augustinô thành Hippô" loading="eager" decoding="async" />
    </div>
    <figcaption>Giám Mục · Tiến Sĩ Hội Thánh</figcaption>
  </figure>
</div>

<!-- ── Tab bar ── -->
<div class="aug-tab-bar shared-tab-bar" role="tablist" aria-label="Nội dung trang">
  <button class="aug-tab-btn shared-tab-btn active" role="tab" id="tab-tieu-su-btn"
    aria-controls="panel-tieu-su" aria-selected="true" data-tab="tieu-su">
    TIỂU SỬ
  </button>
  <button class="aug-tab-btn shared-tab-btn" role="tab" id="tab-nien-bieu-btn"
    aria-controls="panel-nien-bieu" aria-selected="false" data-tab="nien-bieu">
    NIÊN BIỂU
  </button>
  <button class="aug-tab-btn shared-tab-btn" role="tab" id="tab-tac-pham-btn"
    aria-controls="panel-tac-pham" aria-selected="false" data-tab="tac-pham">
    TÁC PHẨM
  </button>
  <button class="aug-tab-btn shared-tab-btn" role="tab" id="tab-bach-khoa-btn"
    aria-controls="panel-bach-khoa" aria-selected="false" data-tab="bach-khoa">
    BÁCH KHOA TOÀN THƯ
  </button>
</div>

<!-- ── Panel 1: Tiểu Sử ── -->
<div class="aug-panel" id="panel-tieu-su" role="tabpanel" aria-labelledby="tab-tieu-su-btn">
  <CollectionProseInlineEditor
    collection="thanh-chan-phuoc"
    entryId={entry.id}
    label="Sửa tiểu sử Thánh Augustinô"
  />
  <div class="article-shell" id="aug-bio-overview">
    <article class="prose"><Content /></article>
  </div>
  <AugustineLifeLibrary />
</div>

<!-- ── Panel 2: Niên Biểu ── -->
<div class="aug-panel timeline-vietnamese" id="panel-nien-bieu" role="tabpanel" aria-labelledby="tab-nien-bieu-btn" hidden>
  <div class="tl-toolbar" aria-label="Tùy chọn niên biểu">
    <button id="timeline-life-filter" class="tl-life-filter" type="button" aria-label="Ẩn các sự kiện khác" title="Ẩn các sự kiện khác" aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16l-6.2 7.1v4.6l-3.6 1.8v-6.4z" /></svg>
    </button>
    <button id="timeline-language-toggle" class="tl-language-switch" type="button" aria-label="Đổi ngôn ngữ niên biểu" aria-pressed="true">
      <span>EN</span><i aria-hidden="true"></i><span>VN</span>
    </button>
  </div>

  <div class="tl-wrap">
    <svg class="tl-flow" viewBox="0 0 10 100" preserveAspectRatio="none" aria-hidden="true">
      <path d="M5 0 V100" pathLength="100" />
    </svg>
    {PDF_TIMELINE_GROUPS.map((group, i) => {
      const showEra = group.era && (i === 0 || group.era !== PDF_TIMELINE_GROUPS[i - 1].era);
      const augEntries = group.entries.filter((row) => row.aug);
      const worldEntries = group.entries.filter((row) => row.world);
      return (
        <>
          {showEra && (
            <div class="tl-era">
              <span><span class="tl-en">{group.era}</span><span class="tl-vi">{group.eraVi}</span></span>
              <button class="tl-era-toggle" type="button" aria-label="Thu gọn giai đoạn" aria-expanded="true">−</button>
            </div>
          )}
          <div
            class={`tl-row${group.major ? ' tl-major' : ''}${group.entries.length > 1 ? ' tl-row-branched' : ''}`}
            data-has-aug={augEntries.length ? 'true' : 'false'}
            data-has-world={worldEntries.length ? 'true' : 'false'}
          >
            <!-- Left: Augustine -->
            <div class="tl-side tl-left">
              <div class="tl-branch-list">
                {augEntries.map((row) => <p class="tl-text tl-text-aug" data-timeline-id={row.id} data-timeline-side="aug" data-timeline-year={row.year} data-timeline-major={row.major ? 'true' : 'false'} data-timeline-era-en={row.era || ''} data-timeline-era-vi={row.eraVi || ''}><span class="tl-en">{row.aug}</span><span class="tl-vi">{row.augVi}</span></p>)}
              </div>
            </div>

            <!-- Center: year pill + node -->
            <div class="tl-center">
              <div class={`tl-node${group.major ? ' tl-node-major' : ''}`}></div>
              <span class="tl-year">{group.year}</span>
            </div>

            <!-- Right: World -->
            <div class="tl-side tl-right">
              <div class="tl-branch-list">
                {worldEntries.map((row) => <p class="tl-text tl-text-world" data-timeline-id={row.id} data-timeline-side="world" data-timeline-year={row.year} data-timeline-major={row.major ? 'true' : 'false'} data-timeline-era-en={row.era || ''} data-timeline-era-vi={row.eraVi || ''}><span class="tl-en">{row.world}</span><span class="tl-vi">{row.worldVi}</span></p>)}
              </div>
            </div>
          </div>
        </>
      );
    })}
  </div>

  <p class="tl-source citation-reference">
    Markus, Robert A. "Life, Culture, and Controversies of Augustine." In <em>Augustine through the Ages: An Encyclopedia</em>, edited by A. D. Fitzgerald, 498–504. Grand Rapids, MI: Eerdmans, 1999.
  </p>
</div>

<dialog class="timeline-inline-dialog" id="timelineInlineDialog" aria-labelledby="timelineInlineTitle">
  <form method="dialog" class="timeline-inline-form" id="timelineInlineForm">
    <header>
      <div>
        <small>Biên tập trực tiếp · Niên biểu</small>
        <h2 id="timelineInlineTitle">Sự kiện</h2>
