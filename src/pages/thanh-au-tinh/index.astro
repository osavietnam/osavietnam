const WORK_SOURCE_EXPLANATIONS: Record<string, string> = {
  'Contra Academicos': 'Also called De Academicis; cf. G. Madec, Introduction, 31, 149, 159. The dates for the dialogues could refer to the time of the dialogues or to the time when they were written down. G. Madec, "L historicite des Dialogues de Cassiciacum," REtAug 32 (1986): 207-31, esp. 223-24.',
  'De animae quantitate': 'Also entitled De quantitate animae.',
  'De arithmetica [lost]': 'See the note for De musica.',
  'De geometrica [lost]': 'See the note for De musica.',
  'De philosophia [lost]': 'See the note for De musica.',
  'Breviculus conlationis cum Donatistis': 'Written before De gratia Testamenti Novi; see ep. 139.3.',
  'Ad catholicos fratres': 'Also called De unitate ecclesiae. See M. Moreau, "Saint Augustin et la dialectique," AugLex, 1:808-15.',
  'De civitate Dei': 'Books 1-3 were finished by September 413; books 4-5 by 415 (ep. 169). In 417 Augustine was working on book 11 (Orosius, hist., prol.). Books 15-16 were written after Quaestiones in Heptateuchum and Locutiones; in 425 he was working on book 18 (ep. 184A.3.5). The work was finished by 427.',
  'Confessiones': 'Cf. A. Solignac, Confessiones, BA 13, 45-54.',
  'De continentia': 'Cf. D. Hunter, "The Date and Purpose of Augustine’s De continentia," AugStud 26, no. 2 (1995): 7-24; and M. Rackett, "Anti-Pelagian Polemic in Augustine’s De continentia," AugStud 26, no. 2 (1995): 25-50.',
  'De correctione Donatistarum': 'Cf. Goldbacher, CSEL 58, p. 47.',
  'Ad Cresconium grammaticum partis Donati': 'See Retr. 2.26. On Cresconius, see J. Pepin, Saint Augustin et la dialectique (Villanova: Villanova University, 1976); A. C. De Veer, BA 31:48-50.',
  'De dialectica': 'See the note for De musica. Cf. J. Pinborg, "Das Sprachdenken der Stoa und Augustins Dialektik," Classica et Mediaevalia 23 (1962): 148-77; Augustine, De dialectica, trans. with introduction and notes by B. Darell Jackson; text by J. Pinborg (Dordrecht-Boston, 1975); J. Pepin, Saint Augustin et la dialectique (Villanova, 1976).',
  'De diversis quaestionibus octoginta tribus': 'Some of these questions were written in Thagaste, others while Augustine was in the monastery in Hippo.',
  'De doctrina Christiana': 'Cf. G. Madec, Introduction, 161. Books 1-3, 25, and 37 were written just after Augustine was ordained a bishop, perhaps before April 4; the remainder was written at the time of the Retractationes.',
  'Contra Donatistas [lost]': 'Also called Contra partem Donati post gesta; cf. ep. 139.3; written before De gratia Testamenti Novi.',
  'De octo Dulcitii quaestionibus': 'Cf. O. Perler and J. L. Maier, Les voyages, 373-78; A. Mutzenbecher, "Zur Datierung von Aug. De octo Dulcitii qq," SE 19 (1969-70): 365-79.',
  'Gesta cum Emerito': 'G. Madec, "Introduction," 156-57.',
  'Enarrationes in Psalmos': 'Cf. H. Rondet, "Essais sur la chronologie des Enarrationes in Psalmos," BLE 61 (1960): 111-27. Commentary on Psalms 1-32 is dated to 392; Psalms 119-133 to 406-7. In 415 Augustine wrote on Psalms 67, 71, and 77; in 422 he wrote on Psalm 118 in 32 sermons.',
  'Enchiridion ad Laurentium': 'Written after Jerome’s death (September 420).',
  'Epistulae': 'See the separate list for the Epistles. The new Divjak letters have their own enumeration: epp. 1*-29*.',
  'Contra duas epistulas Pelagianorum': 'Brought to Pope Boniface by Alypius; cf. c. Jul. imp. 1.85; 2.178.',
  'Epistulae ad Romanos inchoata expositio': 'This work resulted from conversations at the First Council of Carthage (June 26, 394). Cf. Perler-Maier, Les voyages, 162-63.',
  'Expositio epistulae ad Galatas': 'Written in Hippo after the First Council of Carthage.',
  'Contra Faustum Manicheum': 'See G. Madec, Introduction, 151-53, for a discussion of the date.',
  'Contra Felicem Manicheum': 'See the discussion of the difficulties with this date in G. Madec, Introduction.',
  'De fide et symbolo': 'Delivered to the bishops gathered at the council of Hippo. Cf. Madec, Introduction, 40.',
  'Acta contra Fortunatum Manicheum': 'Possidius 6; retr. 1.16.1/2.',
  'Contra Gaudentium': 'Dated by M.-F. Berrouard, arguing from ep. 23A*. Written after Augustine’s encounter with Emeritus; BA 46B:541.',
  'De gestis Pelagii': 'Written at the end of 416 or beginning of 417: Y.-M. Duval, BA 46B:430ff.',
  'De grammatica [lost]': 'See the note for De musica. Cf. V. Law, "St. Augustine’s De grammatica: Lost or Found?" RechAug 19 (1984): 155-83, on vestiges in the so-called Ars Augustini pro fratrum mediocritate breviata; cf. U. Pisani, "Gli scritti grammaticali attribuiti a S. Agostino," Augustinianum 25 (1985): 361-83.',
  'De gratia Christi et de peccato originali': 'Written in Carthage: Perler-Maier, Les voyages, 344.',
  'Contra Hilarum [lost]': 'Cf. G. Madec, Introduction, 93. Although lost, this work was still known in Mainz in the ninth century: E. Dekkers, "Sur la diffusion au moyen age des oeuvres moins connues d’Augustin," in Homo spiritalis, 446-59.',
  'In Johannis evangelium tractatus': 'Cf. M. Le Landais, Etudes augustiniennes (Paris, 1953), 9-15; A.-M. La Bonnardiere dates tr. 1-16 to 406/407 with Jo. ep. tr.; D. E. Wright discusses tr. 20-22; M.-F. Berrouard dates tr. 17-19 and 23-54 to 414 and tr. 20-22 to 419/420. Tractates 55-124 were written beginning in 419.',
  'De libero arbitrio': 'Books 2 and 3 were finished at Hippo between 391 and 395; cf. G. Madec, Introduction, 34, 42, 160.',
  'Contra litteras Petiliani': 'See B. Quinot, BA 30:17-41.',
  'De moribus ecclesiae catholicae et de moribus Manichaeorum': 'Finished after returning to Africa; cf. G. Madec, Introduction, 35, 160.',
  'De musica': 'This work was completed in Thagaste; cf. G. Madec, Introduction, 31-33, 36. The Disciplinarum libri also included De arithmetica, De dialectica, De geometrica, De grammatica, De philosophia, and De rhetorica. Of these latter works, composed in Milan in Lent 387 (14 March-25 April), several have not survived.',
  'De natura et gratia': 'M.-F. Berrouard, "Les lettres 6* et 19* de s. Augustin," REtAug 27 (1981): 264-67; Y.-M. Duval, BA 46B:511, and "La date du De natura de Pelage," REtAug 36 (1990): 257-83.',
  'Contra nescio quem Donatistam [lost]': 'Cf. G. Madec, Introduction, 93. The title should be corrected to refer to the Donatists of Moxor, according to the Indiculus of Possidius 6.10; see D. De Bruyne, "Une enigme dans la liste des ecrits d’Augustin redigee par Possidius?" MA 1:317-19.',
  'De nuptiis et concupiscentia': 'Book 1 in 418/419; book 2 in 420/421. See M.-F. Berrouard, "Un tournant dans la vie de l’Eglise d’Afrique," REtAug 31 (1985): 46-70; "Alypius," AugLex 1:260-65.',
  'De ordine': 'At Cassiciacum. Perler-Maier, Les voyages, 189-190. See note 2.',
  'De peccatorum meritis et remissione et de baptismo parvulorum': 'Cf. M. Moreau, "Le dossier Marcellinus dans la Correspondance de St. Augustin," RechAug 9 (1973): 139; E. Refoule, "Datation du premier concile de Carthage," REtAug 1963, 41-49; B. Delaroche, "La datation du De peccatorum meritis et remissione," REtAug 41 (1995): 37-57.',
  'De perfectione iustitiae hominis': 'Includes the Definitiones of Caelestius.',
  'De dono perseverantiae': 'With De praedestinatione sanctorum, this is one work; BA 24:437, n. 1.',
  'De praedestinatione sanctorum': 'With De dono perseverantiae, this is one work; BA 24:437, n. 1.',
  'Probationum et testimoniorum contra Donatistas [lost]': 'Cf. G. Madec, Introduction, 93. Although lost, this work was still known in Mainz in the ninth century; see E. Dekkers, "Sur la diffusion au moyen age des oeuvres moins connues d’Augustin," in Homo spiritalis, 450.',
  'Quaestiones in Heptateuchum': 'Qu. Gen. (book 1); Qu. Exod. (book 2); Qu. Lev. (book 3); Qu. Num. (book 4); Qu. Deut. (book 5); Qu. Josh. (book 6); Qu. Judg. (book 7).',
  'De octo quaestionibus ex Veteri Testamento': 'Authenticity controversial; defended and edited (edition reprinted in CCSL) by D. De Bruyne, MA 2:327-40.',
  'Regula: objurgatio': 'After L. Verheijen, La Regie de saint Augustin (Paris, 1967), and G. Lawless, Saint Augustine and His Monastic Rule, the ordo monasterii, objurgatio, and praeceptum may be accepted as authentic; critical texts at Verheijen, 1:148-52, 1:105-7, and 1:417-37; reprinted in Lawless, Rule, 74-108.',
  'Regula: ordo monasterii': 'After L. Verheijen, La Regie de saint Augustin (Paris, 1967), and G. Lawless, Saint Augustine and His Monastic Rule, the ordo monasterii, objurgatio, and praeceptum may be accepted as authentic; critical texts at Verheijen, 1:148-52, 1:105-7, and 1:417-37; reprinted in Lawless, Rule, 74-108.',
  'Regula: praeceptum': 'After L. Verheijen, La Regie de saint Augustin (Paris, 1967), and G. Lawless, Saint Augustine and His Monastic Rule, the ordo monasterii, objurgatio, and praeceptum may be accepted as authentic; critical texts at Verheijen, 1:148-52, 1:105-7, and 1:417-37; reprinted in Lawless, Rule, 74-108.',
  'De rhetorica [lost]': 'See the note for De musica. Cf. K. Barwick, "Augustins Schrift de rhetorica und Hermagoras von Temnos," Philologus 105 (1961): 186-218.',
  'Sermones': 'The Sermones post Maurinos [et post Morinum] reperti are designated by conventional abbreviations, e.g. s. Den., s. Frang., s. Guelf.; most are published in MA 1, 774-89. Others, especially s. Lambot, have appeared in RevBen and REtAug. For details, see Verbraken, supplemented by the list at AugLex 1:xxxix.',
  'Contra sermonem Arianorum': 'Cf. M.-F. Berrouard, "L’activite de s. Augustin du 11 septembre au 1er decembre 419 d’apres la lettre 23A*," Les lettres de s. Augustin decouvertes par Johannes Divjak (Paris, 1983), 301-27, esp. 310.',
  'Ad Simplicianum': 'A. Mutzenbecher, CCL 57:xviii and CCL 44:xxx-xxxiii; cf. G. Madec, Introduction, 142-44, 161. This was Augustine’s first work as a bishop.',
  'Soliloquia': 'See the note for Contra Academicos.',
  'De Trinitate': 'Cf. G. Madec, Introduction, 78-79, 162.',
  'De unico baptismo contra Petilianum': 'A. C. De Veer, "La date du De unico baptismo de saint Augustin," REtAug 10 (1964): 35-38.',
  'De vera religione': 'See G. Madec, "Le De civitate Dei comme De vera religione," in Interiorita e intenzionalita nel De civitate Dei di Sant’Agostino (Rome, 1991), 7-33.'
};

