/* Inline timeline editor: only activated while the local Admin API is available. */
.timeline-inline-trigger {
  position: absolute;
  z-index: 6;
  top: .35rem;
  right: .35rem;
  width: 2.7rem;
  height: 2.7rem;
  display: grid;
  place-items: center;
  padding: 0;
  border: 1px solid rgba(233,193,118,.5);
  border-radius: 50%;
  color: #e9c176;
  background: #102118;
  font: 600 1.15rem/1 var(--font-ui);
  cursor: pointer;
}
.timeline-inline-trigger:hover,
.timeline-inline-trigger:focus-visible { color: #102118; background: #e9c176; outline: 2px solid rgba(233,193,118,.28); outline-offset: 2px; }
.timeline-inline-admin .tl-text[data-timeline-id] { padding-right: 3.5rem; }

.timeline-inline-dialog {
  width: min(72rem, calc(100vw - 2.4rem));
  max-height: calc(100dvh - 2.4rem);
  padding: 0;
  overflow: auto;
  border: 1px solid rgba(233,193,118,.34);
  border-radius: 12px;
  color: var(--ink-cream);
  background: #101c18;
  box-shadow: 0 2rem 5rem rgba(0,0,0,.46);
}
.timeline-inline-dialog::backdrop { background: rgba(3,7,12,.72); backdrop-filter: blur(4px); }
.timeline-inline-form > header,
.timeline-inline-form > footer { display: flex; align-items: center; gap: 1rem; padding: 1.25rem 1.5rem; }
.timeline-inline-form > header { justify-content: space-between; border-bottom: 1px solid rgba(233,193,118,.18); }
.timeline-inline-form > header small { display: block; margin-bottom: .25rem; color: #e9c176; font: 600 .9rem/1.4 var(--font-ui); letter-spacing: .1em; text-transform: uppercase; }
.timeline-inline-form > header h2 { margin: 0; color: var(--ink-cream); font: 600 1.9rem/1.25 var(--font-display); }
.timeline-inline-close { width: 3rem; height: 3rem; padding: 0; border: 0; border-radius: 50%; color: var(--ink-cream-soft); background: transparent; font: 300 2.4rem/1 var(--font-ui); cursor: pointer; }
.timeline-inline-close:hover { color: #e9c176; background: rgba(233,193,118,.1); }
.timeline-inline-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; padding: 1.5rem; }
.timeline-inline-fields label { min-width: 0; display: flex; flex-direction: column; gap: .45rem; }
.timeline-inline-fields label > span { color: var(--ink-cream-soft); font: 500 1rem/1.35 var(--font-ui); }
.timeline-inline-fields input[type="text"],
.timeline-inline-fields textarea { width: 100%; border: 1px solid rgba(233,193,118,.26); border-radius: 7px; padding: .8rem .9rem; color: var(--ink-cream); background: #0b1612; font: 400 1.1rem/1.55 var(--font-ui); resize: vertical; }
.timeline-inline-fields input:focus,
.timeline-inline-fields textarea:focus { border-color: #e9c176; outline: 2px solid rgba(233,193,118,.16); }
.timeline-inline-year { max-width: 15rem; }
.timeline-inline-major { align-self: end; flex-direction: row !important; align-items: center; min-height: 3.7rem; }
.timeline-inline-major input { width: 1.35rem; height: 1.35rem; accent-color: #c99a49; }
.timeline-inline-form > footer { justify-content: flex-end; border-top: 1px solid rgba(233,193,118,.18); }
.timeline-inline-form > footer p { flex: 1; margin: 0; color: var(--ink-cream-soft); font: 500 .95rem/1.4 var(--font-ui); }
.timeline-inline-form > footer p.is-error { color: #ff9d91; }
.timeline-inline-form > footer button:not(.timeline-inline-close) { min-height: 3.2rem; padding: .65rem 1rem; border: 1px solid rgba(233,193,118,.38); border-radius: 7px; color: var(--ink-cream); background: transparent; font: 600 1rem/1 var(--font-ui); cursor: pointer; }
.timeline-inline-form > footer .timeline-inline-save { color: #102118; background: #e9c176; border-color: #e9c176; }
.timeline-inline-form button:disabled { opacity: .5; cursor: wait; }
html[data-theme="light"] .timeline-inline-dialog { color: #183e2c; background: #fffdf8; border-color: rgba(24,62,44,.26); }
html[data-theme="light"] .timeline-inline-form > header,
html[data-theme="light"] .timeline-inline-form > footer { border-color: rgba(24,62,44,.14); }
html[data-theme="light"] .timeline-inline-form > header h2 { color: #183e2c; }
html[data-theme="light"] .timeline-inline-fields label > span,
html[data-theme="light"] .timeline-inline-form > footer p { color: #50685a; }
html[data-theme="light"] .timeline-inline-fields input[type="text"],
html[data-theme="light"] .timeline-inline-fields textarea { color: #183e2c; background: #fff; border-color: rgba(24,62,44,.24); }
html[data-theme="light"] .timeline-inline-trigger { color: #fff; background: #27664c; border-color: #27664c; }
@media (max-width: 640px) {
  .timeline-inline-fields { grid-template-columns: 1fr; padding: 1.2rem; }
  .timeline-inline-year { max-width: none; }
  .timeline-inline-major { align-self: auto; }
  .timeline-inline-form > footer { flex-wrap: wrap; padding: 1rem 1.2rem; }
  .timeline-inline-form > footer p { flex-basis: 100%; }
}
</style>

<script define:vars={{ phJson: taPh }}>
document.getElementById('backBtn')?.remove();

// Tab switching
const tabBtns = document.querySelectorAll('.aug-tab-btn');
const panels = document.querySelectorAll('.aug-panel');
const timelineWrap = document.querySelector('.tl-wrap');
let timelineObserver;

function revealTimeline() {
  if (!timelineWrap || timelineWrap.classList.contains('timeline-reveal')) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  timelineWrap.classList.add('timeline-reveal');
  timelineObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      entry.target.classList.toggle('is-visible', entry.isIntersecting);
    });
  }, { rootMargin: '0px 0px -10% 0px', threshold: .08 });
  timelineWrap.querySelectorAll('.tl-row, .tl-era').forEach(item => timelineObserver.observe(item));
}

function activateTab(tab, updateUrl = false) {
  const button = Array.from(tabBtns).find(item => item.dataset.tab === tab);
  const panel = document.getElementById(`panel-${tab}`);
  if (!button || !panel) return;
  tabBtns.forEach(item => {
    item.classList.toggle('active', item === button);
    item.setAttribute('aria-selected', String(item === button));
  });
  panels.forEach(item => { item.hidden = item !== panel; });
  if (updateUrl && window.location.hash !== `#${tab}`) history.pushState(null, '', `#${tab}`);
  requestAnimationFrame(() => {
    const tabBar = button.closest('.aug-tab-bar');
    if (!tabBar || tabBar.scrollWidth <= tabBar.clientWidth) return;
    const barRect = tabBar.getBoundingClientRect();
    const buttonRect = button.getBoundingClientRect();
    let left = tabBar.scrollLeft;
    if (buttonRect.left < barRect.left) left -= barRect.left - buttonRect.left;
    if (buttonRect.right > barRect.right) left += buttonRect.right - barRect.right;
    tabBar.scrollTo({ left: Math.max(0, left), behavior: updateUrl ? 'smooth' : 'auto' });
  });
  if (tab === 'nien-bieu') requestAnimationFrame(revealTimeline);
}

tabBtns.forEach(btn => btn.addEventListener('click', () => activateTab(btn.dataset.tab, true)));
const tabFromHash = () => {
  const hash = window.location.hash.slice(1);
  if (hash === 'thu-vien-tieu-su') return 'tieu-su';
  if (hash === 'thu-vien-tac-pham') return 'tac-pham';
  if (hash === 'thu-vien-bach-khoa') return 'bach-khoa';
  if (hash.startsWith('bach-khoa-entry-')) return 'bach-khoa';
  return hash;
};
const requestedTab = tabFromHash();
if (requestedTab === 'tieu-su' || requestedTab === 'nien-bieu' || requestedTab === 'tac-pham' || requestedTab === 'bach-khoa') activateTab(requestedTab);
else history.replaceState(null, '', '#tieu-su');
window.addEventListener('popstate', () => activateTab(tabFromHash() || 'tieu-su'));
window.addEventListener('hashchange', () => activateTab(tabFromHash() || 'tieu-su'));

const worksFilter = document.getElementById('works-filter');
const worksList = document.getElementById('works-list');
const worksSort = document.getElementById('works-sort');
const resetWorksNumbering = (showAll = worksList?.classList.contains('show-all') ?? false) => {
  let current = 0;
  const rows = worksList ? worksList.querySelectorAll('[data-work-major]') : [];
  rows.forEach((row) => {
    if (!showAll && row.getAttribute('data-work-major') === 'false') return;
    const number = row.querySelector('.work-no');
    if (number) number.textContent = String(++current).padStart(2, '0');
  });
};
resetWorksNumbering();
const workFullLabels = document.querySelectorAll('.work-main [data-work-full]');
const closeWorkTooltips = () => workFullLabels.forEach((item) => item.classList.remove('show-work-tooltip'));
workFullLabels.forEach((item) => {
  const toggleTooltip = () => {
    if (item.scrollWidth <= item.clientWidth) return;
    const opening = !item.classList.contains('show-work-tooltip');
    closeWorkTooltips();
    item.classList.toggle('show-work-tooltip', opening);
  };
  item.addEventListener('click', toggleTooltip);
  item.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      toggleTooltip();
    }
  });
});
document.addEventListener('click', (event) => {
  if (!(event.target instanceof Element) || !event.target.closest('.work-main [data-work-full]')) closeWorkTooltips();
});
const workTextMenus = document.querySelectorAll('.work-text-menu');
const closeWorkTextMenus = () => workTextMenus.forEach((menu) => {
  menu.classList.remove('is-open', 'is-hover-open');
  menu.querySelector('.work-text-trigger')?.setAttribute('aria-expanded', 'false');
});
workTextMenus.forEach((menu) => {
  const trigger = menu.querySelector('.work-text-trigger');
  const links = menu.querySelector('.work-links');
  let hoverCloseTimer;
  const keepHoverMenuOpen = () => {
    clearTimeout(hoverCloseTimer);
    menu.classList.add('is-hover-open');
  };
  menu.addEventListener('pointerenter', (event) => {
    if (event.pointerType === 'touch') return;
    keepHoverMenuOpen();
  });
  menu.addEventListener('pointerleave', (event) => {
    if (event.pointerType === 'touch') return;
    hoverCloseTimer = setTimeout(() => menu.classList.remove('is-hover-open'), 700);
  });
  links?.addEventListener('pointerenter', keepHoverMenuOpen);
  trigger?.addEventListener('click', () => {
    const opening = !menu.classList.contains('is-open');
    closeWorkTextMenus();
    clearTimeout(hoverCloseTimer);
    menu.classList.remove('is-hover-open');
    menu.classList.toggle('is-open', opening);
    trigger.setAttribute('aria-expanded', String(opening));
    if (!opening) trigger.blur();
  });
});
document.addEventListener('click', (event) => {
  if (!(event.target instanceof Element) || !event.target.closest('.work-text-menu')) closeWorkTextMenus();
});
document.addEventListener('keydown', (event) => {
  if (event.key === 'Escape') closeWorkTextMenus();
});
worksFilter?.addEventListener('change', () => {
  if (!worksList || !(worksFilter instanceof HTMLSelectElement)) return;
  const showAll = worksFilter.value === 'all';
  worksList.classList.toggle('show-all', showAll);
  resetWorksNumbering(showAll);
});
worksSort?.addEventListener('change', () => {
  if (!worksList || !(worksSort instanceof HTMLSelectElement)) return;
  const rows = Array.from(worksList.querySelectorAll('[data-work-major]'));
  const mode = worksSort.value;
  const year = (row) => Number(row.getAttribute('data-work-date')?.match(/\d{3,4}/)?.[0] ?? 9999);
  const pl = (row) => Number(row.getAttribute('data-work-pl')?.match(/\d+/)?.[0] ?? 9999);
  rows.sort((a, b) => {
    if (mode === 'name') return (a.getAttribute('data-work-latin') ?? '').localeCompare(b.getAttribute('data-work-latin') ?? '');
    if (mode === 'pl') return pl(a) - pl(b) || (a.getAttribute('data-work-latin') ?? '').localeCompare(b.getAttribute('data-work-latin') ?? '');
    return year(a) - year(b) || (a.getAttribute('data-work-latin') ?? '').localeCompare(b.getAttribute('data-work-latin') ?? '');
  });
  rows.forEach((row) => worksList.appendChild(row));
  resetWorksNumbering();
});

// ── Inline edit ───────────────────────────────────────────────────
const timelinePanel = document.getElementById('panel-nien-bieu');
const timelineToolbar = document.querySelector('.tl-toolbar');
const syncTimelineOptions = () => timelineToolbar?.classList.toggle('show', window.scrollY > 500);
window.addEventListener('scroll', syncTimelineOptions, { passive: true });
syncTimelineOptions();
const timelineLanguageToggle = document.getElementById('timeline-language-toggle');
timelineLanguageToggle?.addEventListener('click', () => {
  const vietnamese = timelinePanel?.classList.toggle('timeline-vietnamese') ?? false;
  timelineLanguageToggle.setAttribute('aria-pressed', String(vietnamese));
});
document.querySelectorAll('.tl-era-toggle').forEach((button) => {
  button.addEventListener('click', () => {
    const era = button.closest('.tl-era');
    const rows = [];
    let item = era?.nextElementSibling;
    while (item && !item.classList.contains('tl-era')) {
      if (item.classList.contains('tl-row')) rows.push(item);
      item = item.nextElementSibling;
    }
    const collapsed = !rows[0]?.classList.contains('tl-era-collapsed');
    rows.forEach((row) => row.classList.toggle('tl-era-collapsed', collapsed));
    button.setAttribute('aria-expanded', String(!collapsed));
    button.setAttribute('aria-label', collapsed ? 'Mở rộng giai đoạn' : 'Thu gọn giai đoạn');
    button.textContent = collapsed ? '+' : '−';
  });
});
const timelineLifeFilter = document.getElementById('timeline-life-filter');
timelineLifeFilter?.addEventListener('click', () => {
  const lifeOnly = timelinePanel?.classList.toggle('timeline-life-only') ?? false;
  timelineLifeFilter.setAttribute('aria-pressed', String(lifeOnly));
  timelineLifeFilter.setAttribute('aria-label', lifeOnly ? 'Hiện lại các sự kiện khác' : 'Ẩn các sự kiện khác');
  timelineLifeFilter.setAttribute('title', lifeOnly ? 'Hiện lại các sự kiện khác' : 'Ẩn các sự kiện khác');
  document.querySelectorAll('.tl-right').forEach(item => {
    item.setAttribute('aria-hidden', String(lifeOnly));
    item.toggleAttribute('hidden', lifeOnly);
  });
  document.querySelectorAll('.tl-row[data-has-aug="false"]').forEach(item => item.toggleAttribute('hidden', lifeOnly));
});

const ADMIN = `${window.location.protocol}//${window.location.hostname}:4322`;

/* Inline editor for timeline events. */
(() => {
  const dialog = document.getElementById('timelineInlineDialog');
  if (!dialog) return;

  const form = document.getElementById('timelineInlineForm');
  const title = document.getElementById('timelineInlineTitle');
  const year = document.getElementById('timelineInlineYear');
  const major = document.getElementById('timelineInlineMajor');
  const eventVi = document.getElementById('timelineInlineVi');
  const eventEn = document.getElementById('timelineInlineEn');
  const eraVi = document.getElementById('timelineInlineEraVi');
  const eraEn = document.getElementById('timelineInlineEraEn');
  const message = document.getElementById('timelineInlineMessage');
  const save = form?.querySelector('.timeline-inline-save');
  let active = null;

  const setMessage = (text = '', isError = false) => {
    message.textContent = text;
    message.classList.toggle('is-error', isError);
  };
  const closeEditor = () => { active = null; dialog.close(); };

  const openEditor = text => {
    const id = text.dataset.timelineId;
    const side = text.dataset.timelineSide;
    if (!id || !side) return;
    active = { id, side };
    title.textContent = side === 'aug' ? 'Sự kiện cuộc đời Thánh Augustinô' : 'Sự kiện đương thời';
    year.value = text.dataset.timelineYear || '';
    major.checked = text.dataset.timelineMajor === 'true';
    eventEn.value = text.querySelector('.tl-en')?.textContent?.trim() || '';
    eventVi.value = text.querySelector('.tl-vi')?.textContent?.trim() || '';
    eraEn.value = text.dataset.timelineEraEn || '';
    eraVi.value = text.dataset.timelineEraVi || '';
    setMessage('');
    dialog.showModal();
    requestAnimationFrame(() => eventVi.focus());
  };

  const addTriggers = () => {
    document.querySelectorAll('.tl-text[data-timeline-id]').forEach(text => {
      if (text.querySelector('.timeline-inline-trigger')) return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'timeline-inline-trigger';
      button.setAttribute('aria-label', 'Sửa sự kiện này');
      button.title = 'Sửa trực tiếp sự kiện';
      button.textContent = '✎';
      button.addEventListener('click', event => {
        event.preventDefault();
        event.stopPropagation();
        openEditor(text);
      });
      text.appendChild(button);
    });
  };

  fetch(ADMIN + '/api/studio/timeline').then(response => {
    if (!response.ok) throw new Error('Admin API unavailable');
    document.body.classList.add('timeline-inline-admin');
    addTriggers();
  }).catch(() => dialog.remove());

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    if (!active || !form.reportValidity()) return;
    save.disabled = true;
    setMessage('Đang lưu…');
    const patch = {
      year: year.value.trim(),
      major: major.checked,
      eraEn: eraEn.value.trim(),
      eraVi: eraVi.value.trim(),
      [active.side === 'aug' ? 'augEn' : 'worldEn']: eventEn.value.trim(),
      [active.side === 'aug' ? 'augVi' : 'worldVi']: eventVi.value.trim(),
    };
    try {
      const response = await fetch(ADMIN + '/api/studio/timeline', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: active.id, patch }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || `HTTP ${response.status}`);
      setMessage('Đã lưu. Đang cập nhật niên biểu…');
      setTimeout(() => location.reload(), 350);
    } catch (error) {
      save.disabled = false;
      setMessage(error instanceof Error ? error.message : 'Không thể lưu thay đổi', true);
    }
  });

  document.getElementById('timelineInlineClose')?.addEventListener('click', closeEditor);
  document.getElementById('timelineInlineCancel')?.addEventListener('click', closeEditor);
  dialog.addEventListener('click', event => { if (event.target === dialog) closeEditor(); });
})();

const oeBar      = null;
const oeEditBtn  = document.getElementById('oe-edit-btn');
const oeSaveRow  = document.getElementById('oe-save-row');
const oeCancelBtn = document.getElementById('oe-cancel-btn');
const oeSaveBtn   = document.getElementById('oe-save-btn');
const oeMsg       = document.getElementById('oe-msg');

fetch(ADMIN + '/api/page-headers').then(r => {
  if (r.ok && oeBar) oeBar.removeAttribute('hidden');
}).catch(() => {});

let editing = false;

function enterEditMode() {
  editing = true;
  document.body.classList.add('oe-editing');
  document.querySelectorAll('[data-oe]').forEach(el => {
    el.setAttribute('contenteditable', 'true');
    el.dataset.oeOrig = el.dataset.oeHtml ? el.innerHTML : el.textContent;
  });
  oeEditBtn?.setAttribute('hidden', '');
  oeSaveRow?.removeAttribute('hidden');
  if (oeMsg) oeMsg.textContent = '';
}

function exitEditMode() {
  editing = false;
  document.body.classList.remove('oe-editing');
  document.querySelectorAll('[data-oe]').forEach(el => el.removeAttribute('contenteditable'));
  oeEditBtn?.removeAttribute('hidden');
  oeSaveRow?.setAttribute('hidden', '');
}

function cancelEdit() {
  document.querySelectorAll('[data-oe]').forEach(el => {
    const orig = el.dataset.oeOrig;
    if (orig !== undefined) {
      if (el.dataset.oeHtml) el.innerHTML = orig;
      else el.textContent = orig;
    }
  });
  exitEditMode();
}

async function saveEdit() {
  if (oeMsg) oeMsg.textContent = 'Đang lưu…';
  const data = Object.assign({}, phJson);
  document.querySelectorAll('[data-oe-target="ph"][data-oe]').forEach(el => {
    data[el.dataset.oe] = el.dataset.oeHtml ? el.innerHTML.trim() : el.textContent.trim();
  });
  try {
    const r = await fetch(ADMIN + '/api/page-headers/thanh-au-tinh', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    });
    if (r.ok) { if (oeMsg) oeMsg.textContent = 'Đã lưu!'; setTimeout(exitEditMode, 900); }
    else if (oeMsg) oeMsg.textContent = 'Lỗi khi lưu';
  } catch { if (oeMsg) oeMsg.textContent = 'Không kết nối được admin server'; }
}

oeEditBtn  ?.addEventListener('click', enterEditMode);
oeCancelBtn?.addEventListener('click', cancelEdit);
oeSaveBtn  ?.addEventListener('click', saveEdit);

</script>
