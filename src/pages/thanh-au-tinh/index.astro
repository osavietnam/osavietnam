      <label class="works-filter shared-filter-control" for="works-filter"><span>Hiển thị</span><select id="works-filter" aria-label="Hiển thị tác phẩm"><option value="major">Tác phẩm chính</option><option value="all">Hiển thị tất cả</option></select></label>
      <label class="works-sort shared-filter-control" for="works-sort"><span>Sắp xếp</span><select id="works-sort" aria-label="Sắp xếp tác phẩm"><option value="year">Năm</option><option value="name">Tên Latin</option><option value="pl">Trích PL</option></select></label>
    </div>
  </div>
  <div class="works-list shared-index-surface shared-index-surface--works" id="works-list" role="list">
    <div class="work-row work-row-head" aria-hidden="true">
      <span>STT</span><span>NĂM</span><span>TÁC PHẨM</span><span>VIẾT TẮT</span><span>TRÍCH PL</span><span>BẢN VĂN</span>
    </div>
    {WORKS_BY_DATE.map((work, index) => (
      <article class="work-row" role="listitem" data-work-major={work.isMajor ? 'true' : 'false'} data-work-date={work.date} data-work-latin={work.latin} data-work-pl={work.pl ?? ''}>
        <span class="work-no">{String(index + 1).padStart(2, '0')}</span>
        <div class="work-date">{work.date}</div>
        <div class="work-main"><em data-work-full={work.latin} title={work.latin} tabindex="0">{work.latin}</em><span class="work-title-en" data-work-full={work.english} title={work.english} tabindex="0">{work.english}</span><span class="work-title-vi" data-work-full={work.vietnamese} title={work.vietnamese} tabindex="0">{work.vietnamese}</span></div>
        <code>{work.abbr}</code>
        <span class="work-pl" title="Patrologia Latina">
          <span>{work.pl ?? 'PL —'}</span>
          {AUGUSTINUS_PL_NOTES[work.abbr] && <small class="work-pl-note" title="Theo chỉ mục Latin của Augustinus.it">{AUGUSTINUS_PL_NOTES[work.abbr]}</small>}
        </span>
        <div class="work-text-menu">
          <button class="work-text-trigger" type="button" aria-expanded="false" aria-label={`Chọn bản văn của ${work.latin}`}>
            <span>BẢN VĂN</span>
            <svg width="11" height="7" viewBox="0 0 11 7" aria-hidden="true"><path d="m1 1 4.5 4.5L10 1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="work-links" aria-label={`Bản văn của ${work.latin}`}>
            {WORK_TEXT_LATIN_LINKS[work.abbr]
              ? <a class="work-link-lat" href={WORK_TEXT_LATIN_LINKS[work.abbr]} target="_blank" rel="noopener noreferrer" title={`Đọc ${work.latin} bằng tiếng Latin trên Augustinus.it`}>LAT</a>
              : <button class="work-link-lat" disabled title="Chưa có bản văn Latin tại Augustinus.it">LAT</button>}
            <button class="work-link-eng" disabled title="Sẽ thêm liên kết English">ENG</button>
            {WORK_TEXT_VI_LINKS[work.abbr]
              ? <a class="work-link-vi" href={WORK_TEXT_VI_LINKS[work.abbr]} title={`Đọc ${work.vietnamese} bằng tiếng Việt`}>VN</a>
              : <button class="work-link-vi" disabled title="Sẽ thêm bản văn tiếng Việt">VN</button>}
          </div>
        </div>
      </article>
    ))}
  </div>
  <p class="tl-source citation-reference works-sources">Fitzgerald, Allan D., and John C. Cavadini, eds. <em>Augustine Through the Ages: An Encyclopedia</em>. Grand Rapids, MI: Eerdmans, 1999.</p>
  </div>
  <AugustineLifeLibrary kind="works" />
</div>

<!-- ── Panel 4: Bách Khoa Toàn Thư ── -->
