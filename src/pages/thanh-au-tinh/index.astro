    </header>
    <div class="timeline-inline-fields">
      <label class="timeline-inline-year"><span>Năm</span><input id="timelineInlineYear" type="text" required /></label>
      <label class="timeline-inline-major"><input id="timelineInlineMajor" type="checkbox" /><span>Sự kiện chính</span></label>
      <label><span>Nội dung tiếng Việt</span><textarea id="timelineInlineVi" rows="4" required></textarea></label>
      <label><span>Nội dung tiếng Anh</span><textarea id="timelineInlineEn" rows="4" required></textarea></label>
      <label><span>Tên giai đoạn tiếng Việt</span><input id="timelineInlineEraVi" type="text" placeholder="Để trống nếu không bắt đầu giai đoạn mới" /></label>
      <label><span>Tên giai đoạn tiếng Anh</span><input id="timelineInlineEraEn" type="text" placeholder="Để trống nếu không bắt đầu giai đoạn mới" /></label>
    </div>
    <footer>
      <p id="timelineInlineMessage" role="status"></p>
      <button type="button" class="timeline-inline-cancel" id="timelineInlineCancel">Hủy</button>
      <button type="submit" class="timeline-inline-save">Lưu thay đổi</button>
    </footer>
  </form>
</dialog>

<!-- ── Panel 3: Tác phẩm ── -->
<div class="aug-panel works-panel" id="panel-tac-pham" role="tabpanel" aria-labelledby="tab-tac-pham-btn" hidden>
  <div id="aug-works-overview" class="aug-works-overview">
  <div class="works-head">
    <div class="works-copy">
      <p>DANH MỤC TÁC PHẨM</p>
    </div>
