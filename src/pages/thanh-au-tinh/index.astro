const WORKS_BY_DATE = WORKS.map((work) => ({
  ...work,
  vietnamese: WORK_TITLE_VI[work.abbr] ?? work.english,
  pl: Object.prototype.hasOwnProperty.call(WORK_PL_FROM_SOURCE, work.latin) ? WORK_PL_FROM_SOURCE[work.latin] : work.pl,
  note: WORK_SOURCE_EXPLANATIONS[work.latin] ?? work.note,
  isMajor: MAJOR_WORK_TITLES.has(work.latin)
})).sort((a, b) => {
  const year = (value: string) => Number(value.match(/\d{3,4}/)?.[0] ?? 9999);
  return year(a.date) - year(b.date) || a.latin.localeCompare(b.latin);
});

