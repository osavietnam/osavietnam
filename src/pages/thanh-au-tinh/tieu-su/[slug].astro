---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AugnetInlineEditor from '../../../components/AugnetInlineEditor.astro';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('augustine-life', ({ data }) => !data.draft && (import.meta.env.DEV || data.translationStatus !== 'draft'));
  const ordered = [...entries].sort((a, b) => a.data.order - b.data.order);

  return ordered.map((entry) => {
    const sameCategory = ordered.filter((item) => item.data.categorySlug === entry.data.categorySlug);
    const categoryIndex = sameCategory.findIndex((item) => item.id === entry.id);
    const previous = categoryIndex > 0 ? sameCategory[categoryIndex - 1] : null;
    const next = categoryIndex < sameCategory.length - 1 ? sameCategory[categoryIndex + 1] : null;

    return {
      params: { slug: entry.id.split('/').at(-1) },
      props: { entry, previous, next },
    };
  });
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const { code, titleEn, titleVi, category, sourceUrl, translationStatus } = entry.data;
const categoryVi: Record<string, string> = {
  'growing-up': 'Thời Niên Thiếu',
  'in-italy': 'Những Năm Tháng tại Ý',
  'in-africa-again': 'Trở Về Châu Phi',
  'augustine-in-general': 'Tổng Quan về Thánh Augustinô',
  'his-era': 'Thời Đại của Ngài',
};
const displayCategory = categoryVi[entry.data.categorySlug] ?? category;
const displayTitle = titleVi || titleEn;
const articleHref = (item: typeof entry) => `/thanh-au-tinh/tieu-su/${item.id.split('/').at(-1)}/`;
const statusLabel = {
  placeholder: 'Chưa dịch',
  draft: 'Đang dịch',
  translated: 'Đã dịch',
}[translationStatus];
---

<BaseLayout
  title={`${code} ${displayTitle}`}
  description={`${code} ${titleEn} — Life of Augustine, Augnet.`}
  bodyClass="no-sidebar page-thanh-au-tinh page-augustine-life"
  type="article"
>
  <main class="aug-life-reader">
    <nav class="aug-life-breadcrumb" aria-label="Đường dẫn">
      <a href="/thanh-au-tinh/#tieu-su">Thánh Augustinô</a>
      <span aria-hidden="true">/</span>
      <a href="/thanh-au-tinh/#thu-vien-tieu-su">Tiểu sử</a>
      <span aria-hidden="true">/</span>
      <span>{code}</span>
    </nav>

    <header class="aug-life-masthead lib-masthead">
      <div class="aug-life-meta lib-masthead-sub">
        <span class="aug-life-code">{code}</span>
        <span>{displayCategory}</span>
        <span class={`aug-life-translation-status is-${translationStatus}`} data-augnet-admin-only hidden>{statusLabel}</span>
      </div>
      <h1 class="lib-masthead-title">{displayTitle}</h1>
      <div class="lib-masthead-rule" aria-hidden="true"><span class="lib-masthead-ornament">✦</span></div>
      <a class="aug-life-source-link" href={sourceUrl} target="_blank" rel="noopener noreferrer">
        <span>Đọc bài gốc trên Augnet</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 5h5v5m0-5-8 8M19 13v6H5V5h6" /></svg>
      </a>
    </header>

    <div class="article-shell aug-life-article-shell">
      <article class={`prose aug-life-prose${translationStatus === 'placeholder' ? ' is-placeholder' : ''}`}>
        <Content />
      </article>
    </div>

    <section class="aug-life-reader-footer" aria-label="Điều hướng bài tiểu sử">
      <a class="aug-life-all-link" href="/thanh-au-tinh/#thu-vien-tieu-su">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        <span>Tất cả bài tiểu sử</span>
      </a>

      <nav class="aug-life-pager" aria-label="Bài liền kề trong chủ đề">
        {previous ? (
          <a href={articleHref(previous)} rel="prev">
            <small>← Bài trước</small>
            <strong><span>{previous.data.code}</span> {previous.data.titleVi || previous.data.titleEn}</strong>
          </a>
        ) : <span></span>}
        {next && (
          <a href={articleHref(next)} rel="next">
            <small>Bài sau →</small>
            <strong><span>{next.data.code}</span> {next.data.titleVi || next.data.titleEn}</strong>
          </a>
        )}
      </nav>
    </section>
  </main>
  <AugnetInlineEditor collection="augustine-life" entryId={entry.id} />
</BaseLayout>

<style>
  .aug-life-reader { width:min(100% - 3rem, 112rem); margin:0 auto; padding:2.4rem 0 5rem; }
  .aug-life-breadcrumb { display:flex; align-items:center; flex-wrap:wrap; gap:.65rem; margin:0 auto 3.4rem; color:var(--ink-cream-soft); font:500 1.08rem/1.4 var(--font-ui); }
  .aug-life-breadcrumb a { color:inherit; text-decoration:none; transition:color .18s; }
  .aug-life-breadcrumb a:hover { color:var(--gold); }
  .aug-life-breadcrumb > span:last-child { color:var(--gold); }
  .aug-life-masthead { max-width:92rem; margin:0 auto 4.6rem; }
  .aug-life-meta { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:.75rem; margin-bottom:1.2rem; color:var(--ink-cream-soft); font:600 1.02rem/1 var(--font-ui); letter-spacing:.06em; }
  .aug-life-meta > span + span::before { content:'·'; margin-right:.75rem; color:rgba(233,193,118,.45); }
  .aug-life-code { color:var(--gold); font-weight:800; letter-spacing:.12em; }
  .aug-life-translation-status { padding:.4rem .65rem; border-radius:999px; color:#fff; background:#5f5a53; font-weight:500; letter-spacing:.02em; }
  .aug-life-translation-status.is-draft { color:#fff; background:#80601d; }
  .aug-life-translation-status.is-translated { color:#fff; background:#2f704f; }
  .aug-life-source-link { display:inline-flex; align-items:center; gap:.55rem; margin-top:2rem; padding:.65rem .9rem; border-radius:.45rem; color:var(--gold); background:rgba(233,193,118,.075); font:600 1.08rem/1 var(--font-ui); text-decoration:none; transition:background .18s, color .18s; }
  .aug-life-source-link:hover { color:#f1d394; background:rgba(233,193,118,.13); }
  .aug-life-source-link svg { width:1.35rem; fill:none; stroke:currentColor; stroke-width:1.7; }
  .aug-life-article-shell { width:min(100%, 112rem); margin:0 auto; }
  .aug-life-prose.is-placeholder { min-height:0; padding:3.2rem 0; text-align:center; }
  .aug-life-prose.is-placeholder :global(p:first-of-type) { max-width:56rem; margin:0 auto; padding:0; border:0; background:transparent; color:rgba(201,191,169,.72); font:italic 400 1.42rem/1.65 var(--font-body); text-align:center; }
  .aug-life-prose.is-placeholder :global(p:first-of-type::first-letter) { float:none; margin:0; color:inherit; font:inherit; }
  .aug-life-reader-footer { width:min(100%, 92rem); margin:4.4rem auto 0; padding-top:2rem; border-top:1px solid rgba(233,193,118,.18); }
  .aug-life-all-link { display:inline-flex; align-items:center; gap:.6rem; color:var(--gold); font:600 1.12rem/1 var(--font-ui); text-decoration:none; }
  .aug-life-all-link svg { width:1.5rem; fill:none; stroke:currentColor; stroke-width:1.7; }
  .aug-life-pager { display:grid; grid-template-columns:1fr 1fr; gap:2.4rem; margin-top:2.2rem; }
  .aug-life-pager a { display:grid; gap:.4rem; min-width:0; padding:.7rem 0; border:0; border-radius:0; background:transparent; color:inherit; text-decoration:none; }
  .aug-life-pager a:last-child { text-align:right; }
  .aug-life-pager a:hover strong { color:var(--gold); }
  .aug-life-pager small { color:var(--ink-cream-soft); font:500 .95rem/1 var(--font-ui); text-transform:uppercase; letter-spacing:.07em; }
  .aug-life-pager strong { overflow:hidden; color:var(--ink-cream); font:600 1.18rem/1.45 var(--font-ui); text-overflow:ellipsis; white-space:nowrap; transition:color .18s; }
  .aug-life-pager strong span { margin-right:.35rem; color:var(--gold); font-size:1rem; letter-spacing:.06em; }

  :global([data-theme="light"]) .aug-life-breadcrumb { color:#5d665d; }
  :global([data-theme="light"]) .aug-life-breadcrumb > span:last-child,
  :global([data-theme="light"]) .aug-life-code,
  :global([data-theme="light"]) .aug-life-source-link,
  :global([data-theme="light"]) .aug-life-all-link,
  :global([data-theme="light"]) .aug-life-pager strong span { color:#8f6129; }
  :global([data-theme="light"]) .aug-life-pager strong { color:var(--accent); }
  :global([data-theme="light"]) .aug-life-meta,
  :global([data-theme="light"]) .aug-life-pager small { color:#5d665d; }
  :global([data-theme="light"]) .aug-life-source-link { background:rgba(156,106,46,.08); }
  :global([data-theme="light"]) .aug-life-prose.is-placeholder :global(p:first-of-type) { color:#6b6e65; }
  :global([data-theme="light"]) .aug-life-reader-footer { border-top-color:rgba(26,94,60,.18); }
  :global([data-theme="light"]) .aug-life-pager a:hover strong { color:#8f6129; }

  @media (max-width: 640px) {
    .aug-life-reader { width:min(100% - 2rem, 60rem); padding-top:1.4rem; }
    .aug-life-breadcrumb { margin-bottom:2.5rem; font-size:.98rem; }
    .aug-life-masthead { margin-bottom:3.4rem; }
    .aug-life-meta { gap:.55rem; margin-bottom:1rem; font-size:.92rem; }
    .aug-life-meta > span + span::before { margin-right:.55rem; }
    .aug-life-prose.is-placeholder { padding:2.4rem 0; }
    .aug-life-prose.is-placeholder :global(p:first-of-type) { font-size:1.28rem; }
    .aug-life-reader-footer { margin-top:3.4rem; }
    .aug-life-pager { grid-template-columns:1fr; }
    .aug-life-pager > span:empty { display:none; }
    .aug-life-pager a:last-child { text-align:left; }
    .aug-life-pager strong { white-space:normal; }
  }
</style>
