</style>

<script>
document.getElementById('backBtn')?.remove();

// Chiều cao thực tế của toàn bộ sticky stack: navbar + book bar + spacer.
// Dùng chung cho TOC, filter và footnote để mọi anchor dừng đúng vị trí.
function getTuThuatScrollOffset() {
  const bodyStyle = getComputedStyle(document.body);
  const navbar = document.querySelector<HTMLElement>('.navbar');
  const sticky = document.querySelector<HTMLElement>('.tt-book-sticky');
  const cssNavbar = Number.parseFloat(bodyStyle.getPropertyValue('--tt-navbar-height')) || 0;
  const cssBookbar = Number.parseFloat(bodyStyle.getPropertyValue('--tt-bookbar-height')) || 0;
  const cssGap = Number.parseFloat(bodyStyle.getPropertyValue('--tt-content-gap')) || 0;
  const measuredNavbar = navbar?.getBoundingClientRect().height || 0;
  const measuredSticky = sticky?.getBoundingClientRect().height || 0;
  const navbarHeight = Math.max(cssNavbar, measuredNavbar, 64);
  const stickyHeight = Math.max(cssBookbar + cssGap, measuredSticky);
  return Math.ceil(navbarHeight + stickyHeight);
}
(window as any).__ttScrollOffset = getTuThuatScrollOffset;

// Trên mobile, xếp hai floating controls dựa trên chiều cao thật để không overlap
// kể cả khi font hệ thống, zoom hoặc production CSS làm nút cao hơn dự kiến.
(function syncTuThuatFloatingControls() {
  const tocWidget = document.getElementById('docFloatToc') as HTMLElement | null;
  const filterWidget = document.getElementById('ttFilter') as HTMLElement | null;
  if (!tocWidget || !filterWidget) return;
  const mobile = window.matchMedia('(max-width: 768px)');
  const sync = () => {
    if (!mobile.matches) {
      tocWidget.style.removeProperty('left');
      tocWidget.style.removeProperty('right');
      tocWidget.style.removeProperty('bottom');
      filterWidget.style.removeProperty('left');
      filterWidget.style.removeProperty('right');
      filterWidget.style.removeProperty('bottom');
      return;
    }
    // Hai nút nằm ở hai mép viewport, cùng baseline, nên không thể overlap.
    tocWidget.style.removeProperty('right');
    tocWidget.style.removeProperty('left');
    tocWidget.style.removeProperty('bottom');
    filterWidget.style.removeProperty('right');
    filterWidget.style.removeProperty('left');
    filterWidget.style.removeProperty('bottom');
  };
  sync();
  window.addEventListener('resize', sync, { passive: true });
  mobile.addEventListener?.('change', sync);
})();

// ── Article number formatter ──
function processArticleNums(container: Element, contentSlug = container.getAttribute('data-content-slug') || '') {
  const bookNumber = contentSlug.match(/^quyen-(\d+)$/)?.[1] ?? '';
  container.querySelectorAll<HTMLParagraphElement>('p').forEach((p) => {
    if (p.closest('.footnotes')) return;
    const walker = document.createTreeWalker(p, NodeFilter.SHOW_TEXT);
    const first = walker.nextNode() as Text | null;
    if (!first) return;
    const m = first.textContent?.match(/^(\d+\.?\s)/);
    if (!m) return;
    const paragraphNumber = m[1].trim().replace(/\.$/, '');
    if (!p.id && bookNumber) p.id = `conf-${bookNumber}-${paragraphNumber}`;
    const span = document.createElement('span');
    span.className = 'article-num';
    span.textContent = m[1];
    const rest = document.createTextNode((first.textContent ?? '').slice(m[1].length));
    first.parentNode?.replaceChild(span, first);
    span.after(rest);
  });
}

// ── Lazy chapter loader ──
(function () {
  const tabs    = document.querySelectorAll<HTMLButtonElement>('.tt-book-tab[data-fragment-slug]');
  const content = document.getElementById('tt-chapter-content') as HTMLElement;
  const loading = document.getElementById('tt-chapter-loading') as HTMLElement;
  const nav     = document.querySelector<HTMLElement>('.tt-book-nav');
  const sticky  = document.querySelector<HTMLElement>('.tt-book-sticky');
  if (!tabs.length || !content) return;

  const BASE = '/tu-thuat/fragment/';
  const cache = new Map<string, string>();
  // A horizontal drag on the book strip must not become a click that loads
  // another book and scrolls the document vertically when the finger lifts.
  let dragStartX = 0;
  let dragStartY = 0;
  let suppressBookClickUntil = 0;
  nav?.addEventListener('pointerdown', (event) => {
    dragStartX = event.clientX;
    dragStartY = event.clientY;
  }, { passive: true });
  nav?.addEventListener('pointerup', (event) => {
    const horizontal = Math.abs(event.clientX - dragStartX);
    const vertical = Math.abs(event.clientY - dragStartY);
    if (horizontal > 8 && horizontal > vertical) suppressBookClickUntil = Date.now() + 320;
  }, { passive: true });
  nav?.addEventListener('click', (event) => {
    if (Date.now() < suppressBookClickUntil) {
      event.preventDefault();
      event.stopImmediatePropagation();
    }
  }, true);
  // Pre-cache bio (default content already in DOM)
  cache.set('bio', content.innerHTML);

  // Process article nums in initial content
  processArticleNums(content, 'bio');

  let loadVersion = 0;
  let activeRequest: AbortController | null = null;
  let pendingDeepLinkAnchor = '';

  const shell = document.querySelector<HTMLElement>('.article-shell');
  const navbar = document.querySelector<HTMLElement>('.navbar');

  function syncStickyMetrics() {
    const navbarHeight = navbar?.getBoundingClientRect().height ?? 65.8;
    document.body.style.setProperty('--tt-navbar-height', `${navbarHeight}px`);
  }

  syncStickyMetrics();
  document.fonts?.ready.then(syncStickyMetrics).catch(() => {});
  window.addEventListener('load', syncStickyMetrics, { once: true });
  window.addEventListener('resize', syncStickyMetrics, { passive: true });
  if ('ResizeObserver' in window) {
    const observer = new ResizeObserver(syncStickyMetrics);
    if (navbar) observer.observe(navbar);
    if (sticky) observer.observe(sticky);
  }

  function scrollToChapterStart() {
    // Đưa cả group TOC + prose về đúng vị trí dưới sticky book bar.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        syncStickyMetrics();
        const target = shell ?? content;
        const offset = getTuThuatScrollOffset();
        const top = Math.max(0, target.getBoundingClientRect().top + window.scrollY - offset);
        window.scrollTo({ top, behavior: 'instant' });
        requestAnimationFrame(() => {
          const navbarBottom = navbar?.getBoundingClientRect().bottom ?? 0;
          const stickyTop = sticky?.getBoundingClientRect().top ?? navbarBottom;
          const correction = stickyTop - navbarBottom;
          if (correction > 0.5) window.scrollBy({ top: correction, behavior: 'instant' });
        });
      });
    });
  }

  function scrollToContentAnchor(anchor: string) {
    syncStickyMetrics();
    let target: HTMLElement | null = document.getElementById(anchor);
    // Links from /chi-muc/ use a stable chapter/paragraph key because the
    // translated heading slug may change whenever its title is edited.
    const indexMatch = anchor.match(/^chi-muc-(\d+)-(\d+)$/);
    if (!target && indexMatch) {
      const chapterNumber = Number(indexMatch[1]);
      const paragraphNumber = Number(indexMatch[2]);
      const romanValues: Record<string, number> = {
        I: 1, II: 2, III: 3, IV: 4, V: 5, VI: 6, VII: 7,
        VIII: 8, IX: 9, X: 10, XI: 11, XII: 12, XIII: 13,
        XIV: 14, XV: 15, XVI: 16, XVII: 17, XVIII: 18, XIX: 19,
        XX: 20, XXI: 21, XXII: 22, XXIII: 23, XXIV: 24, XXV: 25,
        XXVI: 26, XXVII: 27, XXVIII: 28, XXIX: 29, XXX: 30,
        XXXI: 31, XXXII: 32, XXXIII: 33, XXXIV: 34, XXXV: 35,
        XXXVI: 36, XXXVII: 37, XXXVIII: 38, XXXIX: 39, XL: 40,
        XLI: 41, XLII: 42, XLIII: 43,
      };
      const chapterHeading = Array.from(content.querySelectorAll<HTMLElement>('h4')).find((heading) => {
        const match = heading.textContent?.trim().match(/^(?:Đoạn|Chương)\s+([IVXLCDM]+)/i);
        return match ? romanValues[match[1].toUpperCase()] === chapterNumber : false;
      });
      target = chapterHeading ?? null;
      if (chapterHeading) {
        let sibling = chapterHeading.nextElementSibling as HTMLElement | null;
        while (sibling && sibling.tagName !== 'H4') {
          const articleNumber = sibling.querySelector<HTMLElement>('.article-num')?.textContent?.match(/\d+/)?.[0];
          if (Number(articleNumber) === paragraphNumber) {
            target = sibling;
            break;
          }
          sibling = sibling.nextElementSibling as HTMLElement | null;
        }
      }
    }
    if (!target) return;
    const top = Math.max(
      0,
      target.getBoundingClientRect().top + window.scrollY - getTuThuatScrollOffset() - 12,
    );
    window.scrollTo({ top, behavior: 'instant' });
  }

  function revealBookTab(tab: HTMLButtonElement) {
    if (!nav) return;
    const navRect = nav.getBoundingClientRect();
    const tabRect = tab.getBoundingClientRect();
    const safeInset = 16;
    let nextLeft = nav.scrollLeft;

    if (tabRect.left < navRect.left + safeInset) {
      nextLeft -= navRect.left + safeInset - tabRect.left;
    } else if (tabRect.right > navRect.right - safeInset) {
      nextLeft += tabRect.right - (navRect.right - safeInset);
    }

    if (nextLeft !== nav.scrollLeft) {
      nav.scrollTo({ left: nextLeft, behavior: 'smooth' });
    }
  }

  function finishChapterLayout() {
    content.style.opacity = '';
    loading.hidden = true;
    const deepLinkAnchor = pendingDeepLinkAnchor;
    if (!deepLinkAnchor) scrollToChapterStart();
    requestAnimationFrame(() => requestAnimationFrame(() => requestAnimationFrame(() => {
      content.style.minHeight = '';
      if (!deepLinkAnchor) return;
      scrollToContentAnchor(deepLinkAnchor);
      pendingDeepLinkAnchor = '';
      history.replaceState(history.state, '', `${window.location.pathname}${window.location.search}#${encodeURIComponent(deepLinkAnchor)}`);
    })));
    (window as any).__ttBuildToc?.();
    (window as any).__ttBuildFilters?.();
  }

  async function loadChapter(slug: string) {
    const thisLoad = ++loadVersion;
    activeRequest?.abort();
    activeRequest = null;

    loading.hidden = false;
    content.style.minHeight = `${Math.ceil(content.getBoundingClientRect().height)}px`;
    content.style.opacity = '0.35';

    if (cache.has(slug)) {
      content.innerHTML = cache.get(slug)!;
      content.dataset.contentSlug = slug;
      processArticleNums(content, slug);
      finishChapterLayout();
      return;
    }

    const controller = new AbortController();
    activeRequest = controller;

    try {
      const resp = await fetch(`${BASE}${slug}/`, { signal: controller.signal });
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      const html = await resp.text();
      if (thisLoad !== loadVersion) return;

      const doc  = new DOMParser().parseFromString(html, 'text/html');
      const frag = doc.querySelector('.tt-fragment-content')?.innerHTML ?? '<p>Đang cập nhật…</p>';
      cache.set(slug, frag);
      content.innerHTML = frag;
      content.dataset.contentSlug = slug;
      processArticleNums(content, slug);
    } catch (error) {
      if (controller.signal.aborted || thisLoad !== loadVersion) return;
      content.innerHTML = '<p style="color:var(--ink-cream-soft);text-align:center;padding:4rem">Không thể tải nội dung. Vui lòng thử lại.</p>';
    } finally {
      if (thisLoad !== loadVersion) return;
      activeRequest = null;
      finishChapterLayout();
    }
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      if (tab.classList.contains('active')) return;
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      revealBookTab(tab); // chỉ cuộn ngang, tuyệt đối không làm trang nhảy dọc
      loadChapter(tab.dataset.fragmentSlug!);
    });
  });

  // Deep links can open a lazily loaded book and land on its exact section.
  const requestedBook = new URLSearchParams(window.location.search).get('book');
  const requestedTab = requestedBook
    ? Array.from(tabs).find((tab) => tab.dataset.fragmentSlug === requestedBook)
    : null;
  if (requestedTab) {
    try { pendingDeepLinkAnchor = decodeURIComponent(window.location.hash.slice(1)); }
    catch { pendingDeepLinkAnchor = window.location.hash.slice(1); }
    // Remove the hash while the fragment is loading so the browser cannot
    // perform a second automatic anchor jump after the content is inserted.
    if (pendingDeepLinkAnchor) {
      history.replaceState(history.state, '', `${window.location.pathname}${window.location.search}`);
    }
    tabs.forEach((tab) => tab.classList.toggle('active', tab === requestedTab));
    revealBookTab(requestedTab);
    loadChapter(requestedBook!);
  }
})();

// ── TOC list toggle (mục lục Quyển/Chương/Đoạn) ──
(function () {
  const widget = document.getElementById('docFloatToc');
  const panel  = document.getElementById('dftPanel') as HTMLElement;
  const btn    = document.getElementById('dftBtn') as HTMLButtonElement;
  const nav    = document.querySelector<HTMLElement>('.tt-book-nav');
  if (!widget || !panel || !btn) return;

  function openPanel(open: boolean) {
    panel.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
    if (open) {
      document.getElementById('ttFilterPanel')?.classList.remove('open');
      document.getElementById('ttFilterBtn')?.setAttribute('aria-expanded', 'false');
    }
  }
  function buildToc() {
    const content  = document.getElementById('tt-chapter-content');
    const dftNav   = document.getElementById('dftNav');
    const tocList  = document.getElementById('tt-toc-list');
    if (!content || !dftNav) return;
    const headings = content.querySelectorAll<HTMLElement>('h2, h3, h4');
    dftNav.innerHTML = '';
    if (tocList) tocList.innerHTML = '';
    const depthOf = (tag: string) => (tag === 'H4' ? 4 : tag === 'H3' ? 3 : 2);
    headings.forEach((h, idx) => {
      if (!h.id) h.id = `tt-h-${idx}`;
      // Float TOC panel link
      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.textContent = h.textContent ?? '';
      a.className = `bft-link bft-depth-${depthOf(h.tagName)}`;
      a.addEventListener('click', (e) => {
        e.preventDefault();
        openPanel(false);
        const offset = getTuThuatScrollOffset();
        const top = h.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo({ top, behavior: 'instant' });
      });
      dftNav.appendChild(a);
      // Sidebar TOC list item
      if (tocList) {
        const li = document.createElement('li');
        li.className = `toc-depth-${depthOf(h.tagName)}`;
        const la = document.createElement('a');
        la.href = `#${h.id}`;
        la.textContent = h.textContent ?? '';
        la.addEventListener('click', (e) => {
          e.preventDefault();
          const offset = getTuThuatScrollOffset();
          const top = h.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top, behavior: 'instant' });
        });
        li.appendChild(la);
        tocList.appendChild(li);
      }
    });
  }
  // ── Dynamic label: cập nhật tên mục đang đọc ──
  const dftLabel = document.getElementById('dftLabel');
  let headingObserver: IntersectionObserver | null = null;

  function updateDynamicLabel(headings: NodeListOf<HTMLElement>) {
    if (headingObserver) headingObserver.disconnect();
    if (!dftLabel) return;
    let activeText = 'Mục Lục';
    headingObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.boundingClientRect.top < 180) {
          activeText = (entry.target.textContent ?? '').trim();
          const short = activeText.length > 28 ? activeText.slice(0, 26) + '…' : activeText;
          dftLabel.textContent = short || 'Mục Lục';
        }
      });
    }, { rootMargin: '-10px 0px -80% 0px', threshold: 0 });
    headings.forEach((h) => headingObserver!.observe(h));
  }

  function buildTocAndLabel() {
    buildToc();
    const content = document.getElementById('tt-chapter-content');
    if (content) {
      const hs = content.querySelectorAll<HTMLElement>('h2, h3, h4');
      updateDynamicLabel(hs);
    }
  }

  btn.addEventListener('click', () => {
    const opening = !panel.classList.contains('open');
    openPanel(opening);
    if (opening) buildToc();
  });

  widget.classList.add('show');
  (window as any).__ttBuildToc = buildTocAndLabel;
  buildTocAndLabel();
})();

// ── Filter: Quyển → Đoạn (h4) → Số đoạn (số paragraph) ──
(function () {
  const widget   = document.getElementById('ttFilter');
  const panel    = document.getElementById('ttFilterPanel') as HTMLElement;
  const btn      = document.getElementById('ttFilterBtn') as HTMLButtonElement;
  const nav      = document.querySelector<HTMLElement>('.tt-book-nav');
  const selQuyen = document.getElementById('ttSelQuyen') as HTMLSelectElement;
  const selDoan  = document.getElementById('ttSelDoan') as HTMLSelectElement;
  const selSo    = document.getElementById('ttSelSo') as HTMLSelectElement;
  const tabs     = Array.from(document.querySelectorAll<HTMLButtonElement>('.tt-book-tab[data-fragment-slug]'));
  if (!widget || !panel || !btn || !selQuyen || !selDoan || !selSo) return;

  function openPanel(open: boolean) {
    panel.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
    if (open) {
      document.getElementById('dftPanel')?.classList.remove('open');
      document.getElementById('dftBtn')?.setAttribute('aria-expanded', 'false');
    }
  }
  function scrollToId(id: string) {
    const el = id ? document.getElementById(id) : null;
    if (!el) return;
    const offset = getTuThuatScrollOffset();
    const top = el.getBoundingClientRect().top + window.scrollY - offset;
    window.scrollTo({ top, behavior: 'instant' });
  }

  // Quyển: lấy từ danh sách tab
  selQuyen.innerHTML = '<option value="">— Chọn quyển —</option>' +
    tabs.map(t => `<option value="${t.dataset.fragmentSlug}">${(t.textContent ?? '').trim()}</option>`).join('');

  type Para = { id: string; num: string };
  type Doan = { id: string; text: string; paras: Para[] };
  let doans: Doan[] = [];

  function fillSo(list: Para[]) {
    selSo.innerHTML = '<option value="">— Số đoạn —</option>' +
      list.map(p => `<option value="${p.id}">${p.num}</option>`).join('');
  }

  // Dựng lại Đoạn (h4) + Số đoạn (paragraph có .article-num) theo thứ tự DOM
  function buildFilters() {
    const content = document.getElementById('tt-chapter-content');
    if (!content) return;
    doans = [];
    let cur: Doan | null = null;
    let hi = 0, pi = 0;
    content.querySelectorAll<HTMLElement>('h4, p').forEach((el) => {
      if (el.tagName === 'H4') {
        if (!el.id) el.id = `tt-h4-${hi++}`;
        cur = { id: el.id, text: (el.textContent ?? '').trim(), paras: [] };
        doans.push(cur);
      } else {
        const numSpan = el.querySelector('.article-num');
        if (!numSpan) return;
        if (!el.id) el.id = `tt-p-${pi++}`;
        const num = (numSpan.textContent ?? '').trim().replace(/\.$/, '');
        if (!cur) { cur = { id: '', text: 'Khác', paras: [] }; doans.push(cur); }
        cur.paras.push({ id: el.id, num });
      }
    });
    selDoan.innerHTML = '<option value="">— Đoạn —</option>' +
      doans.filter(d => d.id).map(d => `<option value="${d.id}">${d.text}</option>`).join('');
    fillSo(doans.flatMap(d => d.paras));
    const active = tabs.find(t => t.classList.contains('active'));
    selQuyen.value = active?.dataset.fragmentSlug ?? '';
  }

  // Đổi Quyển → nạp nội dung qua tab (giữ panel mở)
  selQuyen.addEventListener('change', () => {
    const tab = tabs.find(t => t.dataset.fragmentSlug === selQuyen.value);
    if (tab && !tab.classList.contains('active')) tab.click();
  });
  // Đổi Đoạn → cuộn tới, lọc Số đoạn theo đoạn (giữ panel mở)
  selDoan.addEventListener('change', () => {
    const id = selDoan.value;
    if (!id) { fillSo(doans.flatMap(d => d.paras)); return; }
    const d = doans.find(x => x.id === id);
    fillSo(d ? d.paras : []);
    scrollToId(id);
  });
  // Đổi Số đoạn → cuộn tới rồi đóng panel
  selSo.addEventListener('change', () => {
    scrollToId(selSo.value);
    openPanel(false);
  });

  btn.addEventListener('click', () => {
    const opening = !panel.classList.contains('open');
    openPanel(opening);
    if (opening) buildFilters();
  });
  document.addEventListener('click', (e) => {
    if (!widget.contains(e.target as Node)) openPanel(false);
  }, { capture: true });

  widget.classList.add('show');
  (window as any).__ttBuildFilters = buildFilters;
  buildFilters();
})();

// ── Reading progress bar ──
const progressBar = document.getElementById('tt-progress-bar');
if (progressBar) {
  function updateProgress() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    progressBar.style.width = docHeight > 0 ? `${(scrollTop / docHeight) * 100}%` : '0%';
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();
}

// Điều hướng footnote (offset nav + highlight 2 chiều) đã chuyển sang BaseLayout — dùng chung toàn site.

// ── Sliding TOC toggle ──
(function () {
  const shell   = document.querySelector<HTMLElement>('.article-shell.has-toc');
  const trigger = document.querySelector<HTMLButtonElement>('.toc-trigger');
  if (!shell || !trigger) return;

  // Tự Thuật dựng TOC trực tiếp trong trang (không qua TableOfContents), nên
  // gắn cùng cơ chế toggle ổn định tại đây. Khi prose reflow do đổi chiều rộng,
  // giữ heading đang đọc ở nguyên cao độ trong viewport.
  trigger.dataset.tocToggleBound = 'true';
  trigger.addEventListener('click', (event) => {
    event.stopPropagation();
    const open = !shell.classList.contains('toc-open');
    const sharedToggle = (window as Window & { __setStableTocOpen?: (shell: HTMLElement, trigger: HTMLButtonElement, open: boolean) => void }).__setStableTocOpen;
    if (sharedToggle) {
      sharedToggle(shell, trigger, open);
      return;
    }

    const headings = Array.from(shell.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id]'));
    let anchor: HTMLElement | null = null;
    if (location.hash) {
      try { anchor = document.getElementById(decodeURIComponent(location.hash.slice(1))); } catch {}
    }
    if (!anchor || !shell.contains(anchor)) {
      anchor = headings.reduce<HTMLElement | null>((best, heading) => {
        const top = heading.getBoundingClientRect().top;
        if (top > innerHeight) return best;
        if (!best) return heading;
        return Math.abs(top - 96) < Math.abs(best.getBoundingClientRect().top - 96) ? heading : best;
      }, null);
    }
    const anchorTop = anchor?.getBoundingClientRect().top ?? null;
    shell.classList.toggle('toc-open', open);
    trigger.setAttribute('aria-expanded', String(open));
    if (!anchor || anchorTop === null) return;
    const restore = () => {
      if (!anchor?.isConnected) return;
      const delta = anchor.getBoundingClientRect().top - anchorTop;
      if (Math.abs(delta) > .5) scrollBy({ top: delta, left: 0, behavior: 'instant' });
    };
    requestAnimationFrame(() => { restore(); requestAnimationFrame(restore); });
    setTimeout(restore, 80);
    setTimeout(restore, 180);
  });

  // Active link highlight via IntersectionObserver (rebuild after each chapter load)
  let observer: IntersectionObserver | null = null;
  function observeHeadings() {
    observer?.disconnect();
    const tocList = document.getElementById('tt-toc-list');
    if (!tocList) return;
    const links = Array.from(tocList.querySelectorAll<HTMLAnchorElement>('a'));
    if (!links.length) return;
    observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const id = entry.target.id;
        links.forEach(l => l.classList.toggle('is-active', l.getAttribute('href') === `#${id}`));
      });
    }, { rootMargin: '-10% 0px -80% 0px' });
    links.forEach(l => {
      const id = l.getAttribute('href')?.slice(1);
      if (id) { const el = document.getElementById(id); if (el) observer!.observe(el); }
    });
  }

  // Attach after initial buildToc
  setTimeout(observeHeadings, 100);
  const origBuildToc = (window as any).__ttBuildToc;
  (window as any).__ttBuildToc = function () {
    origBuildToc?.();
    setTimeout(observeHeadings, 100);
  };
})();

</script>
