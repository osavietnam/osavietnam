---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleLibraryLanding from '../../components/ArticleLibraryLanding.astro';
import QuoteReel from '../../components/QuoteReel.astro';
import CategoryArticleGallery from '../../components/CategoryArticleGallery.astro';
import ArticleInlineManager from '../../components/ArticleInlineManager.astro';
import ongoi from '../../data/on-goi-content.json';
import articleTaxonomy from '../../data/article-taxonomy.json';
import { BANNERS, type BannerVariant } from '../../lib/banners';

const posts = await getCollection('bai-viet', ({ data }) => !data.draft && !data.translationOf && data.language !== 'en');
const NEWS_CATEGORIES = articleTaxonomy.news.categories.map(({ label }) => label);
type NewsCategory = string;
const newsCategoryFor = (category?: string): NewsCategory | null => {
  const direct = NEWS_CATEGORIES.find((label) => label.toLocaleLowerCase('vi') === (category ?? '').toLocaleLowerCase('vi').trim());
  if (direct) return direct;
  const value = (category ?? '').toLocaleLowerCase('vi').trim();
  if (value === 'cộng đoàn' || value.includes('sinh hoạt cộng đoàn')) return 'Cộng Đoàn';
  if (value === 'dòng' || value.includes('tin dòng') || value.includes('dòng thánh augustinô')) return 'Dòng';
  if (value === 'giáo hội' || value.includes('tin giáo hội')) return 'Giáo Hội';
  if (value === 'giáo phận' || value.includes('tin giáo phận')) return 'Giáo Phận';
  return null;
};
const newsPosts = posts.filter((post) => newsCategoryFor(post.data.category) !== null);
const sorted = [...newsPosts].sort((a, b) => {
  const ad = a.data.date ? new Date(a.data.date).getTime() : 0;
  const bd = b.data.date ? new Date(b.data.date).getTime() : 0;
  return bd - ad || a.data.title.localeCompare(b.data.title);
});
const featured = sorted.find((post) => post.data.featured);
const newsBanner = BANNERS.news as BannerVariant;
const featurePool = [
  ...(featured ? [featured] : []),
  ...sorted.filter((post) => post.id !== featured?.id),
].slice(0, 5);
const featureTabs = featurePool.slice(1);
const recentPosts = sorted.filter((post) => post.id !== featured?.id).slice(0, 5);
const featureImageById = new Map(
  featurePool.map((post, index) => [post.id, [
    '/images/on-goi/demo-1.jpg',
    '/images/on-goi/demo-2.jpg',
    '/images/on-goi/demo-3.jpg',
    '/images/banners/banner-than-hoc.jpg',
    '/images/banners/banner-triet-hoc.jpg',
  ][index % 5]]),
);
const vocationQuotes = ongoi.quotes as Array<Record<string, unknown>>;
const thumbnailFor = (post: typeof sorted[number]) => {
  if (featureImageById.has(post.id)) return featureImageById.get(post.id)!;
  if (post.data.image?.src) return post.data.image.src;
  const category = (post.data.category ?? '').toLocaleLowerCase('vi');
  if (category.includes('triết')) return '/images/banners/banner-triet-hoc.jpg';
  if (category.includes('thần')) return '/images/banners/banner-than-hoc.jpg';
  if (category.includes('linh')) return '/images/banners/TolleLege.webp';
  if (category.includes('sinh hoạt cộng đoàn')) {
    const imageNumber = (post.id.split('').reduce((sum, character) => sum + character.charCodeAt(0), 0) % 3) + 1;
    return `/images/on-goi/demo-${imageNumber}.jpg`;
  }
  return '/images/on-goi/banner.avif';
};
const formatDate = (value?: Date) => value
  ? new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(new Date(value))
  : '';
const newsHref = (post: typeof sorted[number]) => `/tin-tuc/${post.id}/`;
const articleSummary = (post: typeof sorted[number]) => ({
  id: post.id,
  title: post.data.title,
  href: newsHref(post),
  category: newsCategoryFor(post.data.category) ?? 'Cộng Đoàn',
  excerpt: post.data.excerpt,
  image: thumbnailFor(post),
  date: post.data.date,
});
const featuredArticle = featured ? articleSummary(featured) : undefined;
const featuredTabs = sorted.slice(0, 10).map(articleSummary);
const latestArticles = sorted
  .filter((post) => post.id !== featured?.id)
  .map(articleSummary);
const newsCategoryGroups = NEWS_CATEGORIES.map((category) => ({
    category,
    articles: sorted
      .filter((post) => newsCategoryFor(post.data.category) === category)
      .map((post) => ({
      id: post.id,
      title: post.data.title,
      href: newsHref(post),
      excerpt: post.data.excerpt,
      date: post.data.date,
      image: thumbnailFor(post),
    })),
  }));
---

<BaseLayout title="Tin tức" bodyClass="page-news no-sidebar" banner={null}>
  <div slot="full-bleed" class="news-banner-outer">
    <div class="news-banner news-slider" data-banner-editor-container data-banner-key="news" data-banner-image-only>
      <img src={newsBanner.imageUrl} alt={newsBanner.altText ?? ''} class="news-slide active" loading="eager" />
      <button
        type="button"
        class="news-banner-image-edit"
        data-banner-inline-edit
        hidden
        aria-label="Thay ảnh banner Tin tức"
        title="Thay ảnh banner Tin tức"
      >✎</button>
      {featured && (
        <article class="news-masthead">
          <div class="news-masthead-head">
            <div class="masthead-identity">
              <p class="news-eyebrow">Dòng Thánh Augustinô — OSA<br />Cộng Đoàn Việt Nam</p>
              <img src="/images/emblem.svg" alt="" class="news-masthead-emblem" aria-hidden="true" />
            </div>
            <h1 class="news-title">{featured.data.title}</h1>
          </div>
          <div class="news-masthead-foot">
            {featured.data.excerpt && <p class="news-masthead-quote">{featured.data.excerpt}</p>}
            <cite class="news-masthead-cite">
              {featured.data.date && <time datetime={new Date(featured.data.date).toISOString()}>{formatDate(featured.data.date)}</time>}
            </cite>
            <a class="news-feature-readmore" href={`/tin-tuc/${featured.id}/`}>
              Đọc thêm <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      )}
    </div>
  </div>

  <ArticleLibraryLanding
    class="journal-page"
    eyebrow="Dòng Thánh Augustinô"
    title="Tin Tức"
    labelledBy="news-library-title"
    featured={featuredArticle}
    tabs={featuredTabs}
    latest={latestArticles}
    showTitles
    showLatestTitles
    showCategories={false}
    showAuthors={false}
  >

    <section class="news-category-library" aria-labelledby="news-library-title">
      <CategoryArticleGallery
        groups={newsCategoryGroups}
        rowTitle="Theo Chuyên Mục"
        idPrefix="news-category"
        showTitles
        showFilters
        showCategories={false}
        showAuthorFilters={false}
      />
    </section>

    <section class="journal-live journal-live-province" data-journal-reveal aria-labelledby="journal-province-title">
      <header class="journal-live-master lib-masthead">
        <p class="lib-masthead-sub">Nguồn tin</p>
        <h1 id="journal-province-title" class="lib-masthead-title">Tỉnh Dòng Úc Châu</h1>
        <div class="lib-masthead-rule" aria-hidden="true"><span class="lib-masthead-ornament">✦</span></div>
      </header>
      <div class="journal-frame-shell">
        <div class="journal-frame-viewport">
          <iframe
            class="journal-frame journal-frame-province"
            data-province-news-frame
            src="/api/province-news.html?theme=dark"
            title="Tin tức Tỉnh Dòng Úc Châu"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
      <div class="journal-frame-controls journal-frame-controls-province" aria-label="Điều khiển nội dung Tỉnh Dòng" hidden style="display:none">
        <button class="journal-frame-control" type="button" data-province-news-frame-back hidden>← Quay lại danh sách</button>
      </div>
    </section>

    <section class="journal-live journal-live-central" data-journal-reveal aria-labelledby="journal-live-title">
      <header class="journal-live-master lib-masthead">
        <p class="lib-masthead-sub">Nguồn tin</p>
        <h1 id="journal-live-title" class="lib-masthead-title">Trung Ương Dòng</h1>
        <div class="lib-masthead-rule" aria-hidden="true"><span class="lib-masthead-ornament">✦</span></div>
      </header>
      <div class="journal-frame-shell">
        <div class="journal-frame-viewport">
          <iframe
            class="journal-frame"
            data-central-news-frame
            src="/api/central-news.html?theme=dark"
            title="Tin tức Trung Ương Dòng"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
      <div class="journal-frame-controls" aria-label="Điều khiển nội dung Trung Ương Dòng" hidden style="display:none">
        <button class="journal-frame-control" type="button" data-news-frame-back hidden>← Quay lại danh sách</button>
      </div>
    </section>

    {false && (<section class="news-vocation-tail" aria-label="Liên hệ Ơn gọi">
      <QuoteReel quotes={vocationQuotes} />
      <section class="og-cta">
        <div class="og-cta-band">
          <div class="og-cta-seal">
            <img src="/images/emblem.svg" alt="" class="og-cta-emblem og-cta-emblem--dark" aria-hidden="true" />
            <img src="/images/emblem-color-transparent.png" alt="" class="og-cta-emblem og-cta-emblem--light" aria-hidden="true" />
            <p class="og-cta-org">OSA Việt Nam</p>
          </div>
          <span class="og-cta-vline" aria-hidden="true"></span>
          <div class="og-cta-contact">
            <p class="og-cta-contact-label">Liên Hệ Ơn Gọi</p>
            <a href="mailto:ongoi@osavietnam.org" class="og-btn">
              <svg width="13" height="13" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/><path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/></svg>
              Gửi email
            </a>
            <a href="mailto:ongoi@osavietnam.org" class="og-cta-email">ongoi@osavietnam.org</a>
          </div>
          <span class="og-cta-vline" aria-hidden="true"></span>
          <div class="og-ext-col">
            <p class="og-cta-contact-label">Tìm Hiểu Thêm</p>
            <a class="og-ext" href="https://www.augustinianorder.org/" target="_blank" rel="noopener noreferrer">
              <strong class="og-ext-name">Trung Ương Dòng</strong>
              <span class="og-ext-url">augustinianorder.org ↗</span>
            </a>
            <a class="og-ext" href="https://www.osa.org.au/" target="_blank" rel="noopener noreferrer">
              <strong class="og-ext-name">Tỉnh Dòng Úc Châu</strong>
              <span class="og-ext-url">osa.org.au ↗</span>
            </a>
          </div>
        </div>
      </section>
    </section>)}

  </ArticleLibraryLanding>

  <script is:inline>
    document.body.dataset.noAutoscroll = 'true';

    var newsMasthead = document.querySelector('.news-masthead');
    var newsBanner = document.querySelector('.news-banner');
    var newsActiveSlide = document.querySelector('.news-banner .news-slide.active');
    var showNewsMasthead = function () {
      if (!newsMasthead) return;
      newsMasthead.classList.remove('is-visible');
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { newsMasthead.classList.add('is-visible'); });
      });
    };
    var observeNewsMasthead = function () {
      if (!newsMasthead || !newsBanner) return;
      var mastheadObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) showNewsMasthead();
          else newsMasthead.classList.remove('is-visible');
        });
      }, { threshold: .15 });
      mastheadObserver.observe(newsBanner);
    };
    if (!newsActiveSlide || (newsActiveSlide.complete && newsActiveSlide.naturalHeight > 0)) {
      observeNewsMasthead();
    } else {
      var mastheadFallback = setTimeout(observeNewsMasthead, 4000);
      newsActiveSlide.addEventListener('load', function () { clearTimeout(mastheadFallback); observeNewsMasthead(); }, { once: true });
      newsActiveSlide.addEventListener('error', function () { clearTimeout(mastheadFallback); observeNewsMasthead(); }, { once: true });
    }

    document.querySelectorAll('.news-slider').forEach(function (panel) {
      var slides = Array.from(panel.querySelectorAll('.news-slide'));
      if (slides.length < 2) return;
      var current = 0;
      setInterval(function () {
        slides[current].classList.remove('active');
        current = (current + 1) % slides.length;
        slides[current].classList.add('active');
      }, 4500);
    });

    document.querySelectorAll('[data-journal-feature]').forEach(function (feature) {
      var items = Array.from(feature.querySelectorAll('[data-story-item]'));
      var showStory = function (item, direction) {
        var storyId = item.getAttribute('data-story-id');
        if (!storyId || feature.getAttribute('data-active-story') === storyId) return;
        var preview = feature.querySelector('.journal-preview');
        if (preview) {
          preview.classList.remove('is-switching', 'is-switching-prev', 'is-switching-next');
          void preview.offsetWidth;
          preview.classList.add('is-switching', direction < 0 ? 'is-switching-prev' : 'is-switching-next');
          window.setTimeout(function () { preview.classList.remove('is-switching'); }, 260);
        }
        feature.setAttribute('data-active-story', storyId);
        var link = feature.querySelector('[data-preview-link]');
        var image = feature.querySelector('[data-preview-image]');
        var category = feature.querySelector('[data-preview-category]');
        var date = feature.querySelector('[data-preview-date]');
        var title = feature.querySelector('[data-preview-title]');
        var excerpt = feature.querySelector('[data-preview-excerpt]');
        if (link) link.setAttribute('href', item.href);
        if (image) {
          var nextImage = item.getAttribute('data-story-image') || '';
          if (image.getAttribute('src') !== nextImage) image.setAttribute('src', nextImage);
        }
        if (category) category.textContent = item.getAttribute('data-story-category') || 'Augustinians';
        if (date) {
          date.textContent = item.getAttribute('data-story-date') || '';
          date.setAttribute('datetime', item.getAttribute('data-story-datetime') || '');
        }
        if (title) title.textContent = item.getAttribute('data-story-title') || '';
        if (excerpt) {
          var text = item.getAttribute('data-story-excerpt') || '';
          excerpt.textContent = text;
          excerpt.hidden = !text;
        }
        items.forEach(function (row) {
          row.classList.toggle('is-active', row.getAttribute('data-story-id') === storyId);
        });
      };
      items.forEach(function (item) {
        item.addEventListener('pointerenter', function () { showStory(item); });
        item.addEventListener('focus', function () { showStory(item); });
      });
      var shiftIndex = -1;
      var shiftStory = function (delta) {
        if (!items.length) return;
        var activeId = feature.getAttribute('data-active-story');
        var index = items.findIndex(function (item) { return item.getAttribute('data-story-id') === activeId; });
        if (index < 0) index = shiftIndex >= 0 ? shiftIndex : (delta > 0 ? -1 : 0);
        var nextIndex = (index + delta + items.length) % items.length;
        shiftIndex = nextIndex;
        var next = items[nextIndex];
        showStory(next, delta);
      };
      var bindShiftButton = function (selector, delta) {
        var button = feature.querySelector(selector);
        if (!button) return;
        var pointerHandled = false;
        button.addEventListener('pointerdown', function (event) {
          event.preventDefault(); event.stopPropagation(); pointerHandled = true; shiftStory(delta);
        });
        button.addEventListener('click', function (event) {
          event.preventDefault(); event.stopPropagation();
          if (pointerHandled) { pointerHandled = false; return; }
          shiftStory(delta);
        });
      };
      bindShiftButton('[data-preview-prev]', -1);
      bindShiftButton('[data-preview-next]', 1);
    });

    var revealItems = Array.from(document.querySelectorAll('[data-journal-reveal]'));
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('journal-motion-ready');
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: .12, rootMargin: '0px 0px -7% 0px' });
      revealItems.forEach(function (item) { observer.observe(item); });
    } else {
      revealItems.forEach(function (item) { item.classList.add('is-visible'); });
    }

    var provinceNewsFrame = document.querySelector('[data-province-news-frame]');
    var provinceNewsControls = document.querySelector('.journal-live-province .journal-frame-controls');
    var provinceNewsBack = document.querySelector('[data-province-news-frame-back]');
    var provinceNewsGalleryUrl = '/api/province-news.html?theme=dark';
    var provinceNewsLastHeight = 0;
    var provinceNewsViewingArticle = false;
    function provinceNewsUrl() {
      try {
        var frameUrl = new URL(provinceNewsFrame.contentWindow.location.href);
        if (frameUrl.origin === window.location.origin && frameUrl.pathname.startsWith('/api/province-news')) return frameUrl;
      }
      catch (error) { return new URL(provinceNewsFrame.getAttribute('src') || provinceNewsGalleryUrl, window.location.href); }
      return new URL(provinceNewsFrame.getAttribute('src') || provinceNewsGalleryUrl, window.location.href);
    }
    function provinceNewsIsArticle(url) { return url.pathname.endsWith('/api/province-news-article'); }
    function provinceNewsIsGallery(url) { return url.pathname.endsWith('/api/province-news.html') || url.pathname.includes('/api/province-news-page/'); }
    function updateProvinceNewsControls() {
      if (!provinceNewsFrame) return;
      var url = provinceNewsUrl();
      if (provinceNewsIsGallery(url)) {
        provinceNewsViewingArticle = false;
        provinceNewsGalleryUrl = url.pathname + url.search;
      } else if (provinceNewsIsArticle(url)) {
        provinceNewsViewingArticle = true;
      }
      if (provinceNewsBack) provinceNewsBack.hidden = !provinceNewsViewingArticle;
      if (provinceNewsControls) {
        provinceNewsControls.hidden = !provinceNewsViewingArticle;
        provinceNewsControls.style.display = provinceNewsViewingArticle ? 'flex' : 'none';
        provinceNewsControls.style.position = 'fixed';
        provinceNewsControls.style.top = 'auto';
        provinceNewsControls.style.right = '5.9rem';
        provinceNewsControls.style.bottom = 'max(1.35rem, env(safe-area-inset-bottom))';
        provinceNewsControls.style.zIndex = '6';
      }
    }
    function syncProvinceNewsTheme() {
      if (!provinceNewsFrame) return;
      var url = provinceNewsUrl();
      var theme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      if (url.searchParams.get('theme') === theme) return;
      url.searchParams.set('theme', theme);
      provinceNewsFrame.src = url.pathname + url.search;
    }
    function onProvinceNewsLoad() {
      syncProvinceNewsTheme();
      provinceNewsLastHeight = 0;
      updateProvinceNewsControls();
    }
    provinceNewsFrame?.addEventListener('load', onProvinceNewsLoad);
    provinceNewsBack?.addEventListener('click', function () {
      provinceNewsViewingArticle = false;
      if (provinceNewsControls) {
        provinceNewsControls.hidden = true;
        provinceNewsControls.style.display = 'none';
      }
      if (provinceNewsBack) provinceNewsBack.hidden = true;
      if (provinceNewsFrame) provinceNewsFrame.src = provinceNewsGalleryUrl;
    });
    syncProvinceNewsTheme();

    var centralNewsFrame = document.querySelector('[data-central-news-frame]');
    var centralNewsControls = document.querySelector('.journal-live-central .journal-frame-controls');
    var centralNewsBack = document.querySelector('[data-news-frame-back]');
    var centralNewsGalleryUrl = '/api/central-news.html?theme=dark';
    var centralNewsLastHeight = 0;
    var centralNewsArticleHeightLocked = false;
    var centralNewsViewingArticle = false;
    function centralNewsUrl() {
      try {
        var frameUrl = new URL(centralNewsFrame.contentWindow.location.href);
        if (frameUrl.origin === window.location.origin && frameUrl.pathname.startsWith('/api/central-news')) return frameUrl;
      }
      catch (error) { return new URL(centralNewsFrame.getAttribute('src') || centralNewsGalleryUrl, window.location.href); }
      return new URL(centralNewsFrame.getAttribute('src') || centralNewsGalleryUrl, window.location.href);
    }
    function centralNewsIsArticle(url) {
      return url.pathname.endsWith('/api/central-news-article');
    }
    function centralNewsIsGallery(url) {
      return url.pathname.endsWith('/api/central-news.html') || url.pathname.includes('/api/central-news-page/');
    }
    function updateCentralNewsControls() {
      if (!centralNewsFrame) return;
      var url = centralNewsUrl();
      if (centralNewsIsGallery(url)) {
        centralNewsViewingArticle = false;
        centralNewsGalleryUrl = url.pathname + url.search;
      } else if (centralNewsIsArticle(url)) {
        centralNewsViewingArticle = true;
      }
      if (centralNewsBack) centralNewsBack.hidden = !centralNewsViewingArticle;
      if (centralNewsControls) {
        centralNewsControls.hidden = !centralNewsViewingArticle;
        centralNewsControls.style.display = centralNewsViewingArticle ? 'flex' : 'none';
        centralNewsControls.style.position = 'fixed';
        centralNewsControls.style.top = 'auto';
        centralNewsControls.style.right = '5.9rem';
        centralNewsControls.style.bottom = 'max(1.35rem, env(safe-area-inset-bottom))';
        centralNewsControls.style.zIndex = '6';
      }
      if (centralNewsViewingArticle) setCentralNewsBackVisibility(true);
    }
    function setCentralNewsBackVisibility(visible) {
      if (!centralNewsControls || centralNewsControls.hidden) return;
      centralNewsControls.style.display = visible ? 'flex' : 'none';
    }
    function syncCentralNewsTheme() {
      if (!centralNewsFrame) return;
      var url = centralNewsUrl();
      var theme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      if (url.searchParams.get('theme') === theme) return;
      url.searchParams.set('theme', theme);
      centralNewsFrame.src = url.pathname + url.search;
    }
    function onCentralNewsLoad() {
      syncCentralNewsTheme();
      var article = centralNewsIsArticle(centralNewsUrl());
      centralNewsLastHeight = 0;
      centralNewsArticleHeightLocked = false;
      updateCentralNewsControls();
    }
    centralNewsFrame?.addEventListener('load', onCentralNewsLoad);
    centralNewsBack?.addEventListener('click', function () {
      centralNewsViewingArticle = false;
      if (centralNewsControls) {
        centralNewsControls.hidden = true;
        centralNewsControls.style.display = 'none';
      }
      if (centralNewsBack) centralNewsBack.hidden = true;
      if (centralNewsFrame) centralNewsFrame.src = centralNewsGalleryUrl;
    });
    syncCentralNewsTheme();
    new MutationObserver(function () { syncProvinceNewsTheme(); syncCentralNewsTheme(); }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    window.addEventListener('message', function (event) {
      if (event.origin !== window.location.origin) return;
      var message = event.data;
      if (message && message.type === 'province-news-resize' && provinceNewsFrame) {
        updateProvinceNewsControls();
        var provinceHeight = Number(message.height);
        if (Number.isFinite(provinceHeight) && provinceHeight > 0) {
          var provinceArticle = provinceNewsIsArticle(provinceNewsUrl());
          if (!provinceArticle || message.kind === 'article') {
            var provinceTargetHeight = Math.ceil(provinceHeight + 2);
            if (provinceTargetHeight !== provinceNewsLastHeight) {
              provinceNewsLastHeight = provinceTargetHeight;
              provinceNewsFrame.style.height = `${provinceTargetHeight}px`;
              var provinceViewport = provinceNewsFrame.closest('.journal-frame-viewport');
              if (provinceViewport) provinceViewport.style.height = provinceNewsFrame.style.height;
            }
          }
        }
        return;
