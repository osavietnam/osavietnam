---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleProseMeta from '../../components/ArticleProseMeta.astro';

export const prerender = true;

export async function getStaticPaths() {
  const articles = await getCollection('bai-viet', ({ data }) => !data.draft);
  const sorted = [...articles].sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));

  return sorted.map((entry) => {
    const related = sorted
      .filter((article) => article.id !== entry.id && article.data.category === entry.data.category)
      .slice(0, 3)
      .map((article) => ({
        id: article.id,
        title: article.data.title,
        excerpt: article.data.excerpt ?? '',
        date: article.data.date,
        category: article.data.category ?? '',
        image: article.data.heroImage?.src ?? article.data.image?.src ?? '',
      }));
    return { params: { slug: entry.id }, props: { entry, related } };
  });
}

const { entry, related } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const folder = entry.id.split('/')[0];
const dateStr = d.date
  ? new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: 'long', year: 'numeric' }).format(d.date)
  : '';
const heroSource = d.heroImage ?? d.image;
let heroSrc = '';
if (heroSource) {
  try { heroSrc = (await getImage({ src: heroSource, width: 1760, height: 900 })).src; } catch {}
}
const fallbackImage = folder === 'sinh-hoat-cong-doan' ? '/images/on-goi/demo-1.jpg' : '/images/on-goi/banner.avif';
const relatedImage = (article: typeof related[number], index: number) =>
  article.image || (article.category.toLocaleLowerCase('vi').includes('sinh hoạt cộng đoàn')
    ? `/images/on-goi/demo-${(index % 3) + 1}.jpg`
    : fallbackImage);
---

<BaseLayout
  title={d.title}
  description={d.excerpt}
  image={d.heroImage?.src ?? d.image?.src}
  type="article"
  bodyClass="page-news page-news-detail no-sidebar"
  banner={null}
>
  <div slot="full-bleed" class="news-detail-banner-outer">
    <section class="news-detail-banner news-detail-slider">
      <img src={heroSrc || fallbackImage} alt="" class="news-detail-slide active" loading="eager" />
      <img src="/images/on-goi/demo-1.jpg" alt="" class="news-detail-slide" loading="lazy" />
      <img src="/images/on-goi/demo-2.jpg" alt="" class="news-detail-slide" loading="lazy" />
      <header class="news-masthead news-detail-masthead">
        <div class="news-masthead-head">
          <p class="news-eyebrow news-detail-eyebrow">Dòng Thánh Augustinô — OSA<br />Cộng Đoàn Việt Nam</p>
          <h1 class="news-title">{d.title}</h1>
        </div>
        {d.subtitle && <p class="news-detail-subtitle">{d.subtitle}</p>}
        <div class="news-masthead-foot">
          <div class="news-detail-meta">
            {d.category && <span>{d.category}</span>}
            {d.category && dateStr && <i aria-hidden="true">·</i>}
            {dateStr && <time datetime={d.date?.toISOString()}>{dateStr}</time>}
          </div>
        </div>
      </header>
    </section>
  </div>

  <main class="news-reading">
    <article class="news-reading-prose prose">
      <ArticleProseMeta author={d.author} />
      {d.excerpt && <p class="news-reading-intro">{d.excerpt}</p>}
      <Content />
    </article>

    {related.length > 0 && (
      <section class="news-reading-related" aria-labelledby="news-reading-related-title">
        <header class="news-reading-related-head">
          <p>Từ cộng đoàn</p>
          <h2 id="news-reading-related-title">Xem thêm</h2>
        </header>
        <div class="news-reading-related-grid">
          {related.map((article, index) => (
            <a href={`/tin-tuc/${article.id}/`} class="news-reading-related-card">
              <img src={relatedImage(article, index)} alt="" loading="lazy" />
              <span>{article.date && new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(article.date)}</span>
              <h3>{article.title}</h3>
              {article.excerpt && <p>{article.excerpt}</p>}
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLQuoteElement>('.news-reading-prose blockquote').forEach((quote) => {
    quote.querySelectorAll<HTMLParagraphElement>(':scope > p').forEach((paragraph) => {
      if (/^\s*[—–]\s/.test(paragraph.textContent ?? '')) paragraph.classList.add('bq-cite');
    });
  });

  document.querySelectorAll('.news-detail-slider').forEach((slider) => {
    const slides = Array.from(slider.querySelectorAll<HTMLElement>('.news-detail-slide'));
    if (slides.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let active = 0;
    window.setInterval(() => {
      slides[active].classList.remove('active');
      active = (active + 1) % slides.length;
      slides[active].classList.add('active');
    }, 5200);
  });

</script>

<style>
  .news-detail-banner { position:relative; display:flex; justify-content:flex-end; min-height:98vh; margin-top:-6.58rem; overflow:hidden; background:#0b1424; }
  .news-detail-banner::after { content:''; position:absolute; inset:0; z-index:1; background:linear-gradient(to bottom, transparent 0%, transparent 42%, rgba(10,18,36,.14) 72%, var(--bg-main) 100%); }
  .news-detail-slide { position:absolute; inset:0; z-index:0; width:100%; height:100%; display:block; object-fit:cover; opacity:0; transition:opacity 1s ease; }
  .news-detail-slide.active { opacity:1; }
  .news-detail-masthead { position:relative; z-index:2; align-self:stretch; display:flex; width:50%; min-height:100%; box-sizing:border-box; flex-direction:column; align-items:center; justify-content:center; margin:0; padding:clamp(6.3rem, 10vh, 7.5rem) clamp(2rem, 3.4vw, 4rem) clamp(2.25rem, 4vh, 4rem); color:#fff8ef; text-align:center; background:rgba(8,14,30,.40); border-left:1px solid rgba(233,193,118,.14); -webkit-mask-image:linear-gradient(to bottom, black 0%, black 72%, transparent 100%); mask-image:linear-gradient(to bottom, black 0%, black 72%, transparent 100%); backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px); }
  .news-detail-masthead .news-masthead-head { width:100%; }
  .news-detail-eyebrow { margin:0 0 1.7rem; color:#e9c176; font:700 1.14rem/1.65 var(--font-ui); letter-spacing:.2em; text-transform:uppercase; }
  .news-detail-masthead .news-title { max-width:62rem; margin:0 0 1.7rem; padding-bottom:.08em; font-family:'Playfair Display', Georgia, serif; font-size:clamp(2.5rem, 1.9rem + 2.1vw, 4.6rem); font-weight:700; line-height:1.16; letter-spacing:.01em; background:linear-gradient(160deg, #fff 0%, #fff4d6 25%, #f4d98f 55%, #e9c176 80%, #d4a84b 100%); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; filter:drop-shadow(0 0 28px rgba(233,193,118,.7)) drop-shadow(0 2px 10px rgba(0,0,0,.5)); }
  .news-detail-subtitle { max-width:60rem; margin:1.5rem 0 0; color:rgba(255,248,239,.88); font:400 clamp(1.35rem, 1.1rem + .45vw, 1.8rem)/1.55 var(--font-body); }
  .news-detail-masthead .news-masthead-foot { width:100%; margin-top:2.4rem; text-align:center; }
  .news-detail-meta { display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:.65rem; margin-top:0; color:#e9c176; font:600 .95rem var(--font-ui); letter-spacing:.12em; text-transform:uppercase; }
  .news-detail-meta i { font-style:normal; opacity:.65; }
  .news-detail-back { display:inline-flex; margin-top:2rem; color:#fff8ef; font:600 .9rem var(--font-ui); letter-spacing:.08em; text-decoration:none; transition:color .2s ease; }
  .news-detail-back:hover { color:#e9c176; }
  .news-reading { width:min(100% - 4rem, 112rem); margin:3.8rem auto 0; padding:0 0 8rem; }
  .news-reading-prose.prose { --prose-surface-inset-block:-3.8rem; --prose-surface-inset-inline:-5rem; width:100%; max-width:112rem; box-sizing:border-box; margin:0 auto; padding:0; }
  .news-reading-related { margin:6rem auto 0; padding-top:3.4rem; border-top:1px solid rgba(233,193,118,.16); }
  .news-reading-related-head { margin-bottom:2rem; }
  .news-reading-related-head p { margin:0 0 .55rem; color:var(--gold); font:600 .9rem var(--font-ui); letter-spacing:.16em; text-transform:uppercase; }
  .news-reading-related-head h2 { margin:0; color:var(--ink-cream); font:600 clamp(2rem, 1.6rem + .7vw, 2.8rem) var(--font-display); }
  .news-reading-related-grid { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:1.1rem; }
  .news-reading-related-card { display:block; min-width:0; color:var(--ink-cream); text-decoration:none; transition:transform .3s ease, color .3s ease; }
  .news-reading-related-card:hover { color:var(--gold); transform:translateY(-.35rem); }
  .news-reading-related-card img { display:block; width:100%; aspect-ratio:16/9; object-fit:cover; margin-bottom:1rem; }
  .news-reading-related-card span { display:block; color:var(--gold-dim); font:600 .82rem 'Be Vietnam Pro', system-ui, sans-serif; letter-spacing:.08em; }
  .news-reading-related-card h3 { margin:.55rem 0 .9rem; color:inherit; font:600 1.5rem/1.3 var(--font-display); }
  .news-reading-related-card p { display:-webkit-box; margin:0; overflow:hidden; color:var(--ink-cream-soft); font:1.18rem/1.6 var(--font-body); -webkit-box-orient:vertical; -webkit-line-clamp:2; }
  :global([data-theme="light"]) .news-detail-banner::after { background:linear-gradient(to bottom, transparent 0%, transparent 88%, var(--bg-main) 100%); }
  :global([data-theme="light"]) .news-reading-related { border-top-color:rgba(26,94,60,.16); }
  :global([data-theme="light"]) .news-reading-related-head h2,
  :global([data-theme="light"]) .news-reading-related-card { color:#1a5e3c; }
  :global([data-theme="light"]) .news-reading-related-card p { color:#4a5040; }
  @media (max-width:900px) {
    .news-detail-banner { min-height:76vh; min-height:76svh; }
  }
  @media (max-width:700px) {
    .news-detail-banner { min-height:clamp(41rem,72svh,47rem); }
    .news-detail-masthead { width:100%; padding:7rem 1.5rem 5rem; border-left:0; background:rgba(8,14,30,.48); }
    .news-detail-eyebrow { font-size:.88rem; letter-spacing:.15em; }
    .news-detail-masthead .news-title { margin-bottom:1rem; font-size:clamp(2.35rem, 9vw, 3.6rem); }
    .news-reading { width:100%; max-width:none; margin:2.2rem auto 0; padding-top:0; }
    .news-reading-prose.prose { width:100% !important; max-width:none !important; margin:0; padding:0; }
    .news-reading-prose.prose { --prose-surface-inset-block:-2.2rem; --prose-surface-inset-inline:-2rem; }
    .news-reading-related-grid { grid-template-columns:1fr; gap:1.8rem; }
  }
  @media (prefers-reduced-motion: reduce) { .news-detail-slide { transition:none; transform:none; } .news-reading-related-card { transition:none; } }
</style>
