---
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const entries = await getCollection('documents', (e) => !e.data.draft);
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const translatorMatch = d.translator?.match(/^Bản\s+Dịch\s+bởi\s+(.+)$/i);
const translatorLabel = translatorMatch ? 'Bản dịch bởi' : '';
const translatorPerson = translatorMatch?.[1] ?? d.translator ?? '';
---
<html lang={d.lang ?? 'vi'}>
<head><meta charset="UTF-8" /></head>
<body>
<div
  class="doc-fragment"
  data-title={d.title}
  data-subtitle={d.subtitle ?? ''}
>
  <div class="doc-fragment-translator">
    {d.translator && (
      <span class="translator">
        <span class="translator-name">
          {translatorLabel && <span class="translator-label">{translatorLabel}</span>}
          <span class="translator-person">{translatorPerson}</span>
        </span>
        {d.translatorNote && <span class="translator-note" set:html={d.translatorNote} />}
      </span>
    )}
  </div>
  <div class="doc-fragment-content"><Content /></div>
</div>
</body>
</html>
