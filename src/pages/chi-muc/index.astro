---
import BaseLayout from '../../layouts/BaseLayout.astro';
import scriptureBooks from '../../data/confessions-scripture-index';
import keywordData from '../../data/confessions-keyword-index.json';

const romanValues: Record<string, number> = {
  I: 1, II: 2, III: 3, IV: 4, V: 5, VI: 6, VII: 7,
  VIII: 8, IX: 9, X: 10, XI: 11, XII: 12, XIII: 13,
};
const confessionChapterMax: Record<number, number> = {
  1: 20, 2: 10, 3: 12, 4: 16, 5: 14, 6: 16, 7: 21,
  8: 12, 9: 13, 10: 43, 11: 31, 12: 32, 13: 38,
};

const confessionLink = (reference: string) => {
  const normalized = reference.replace(/\s+/g, '').replace(/^([IVX]+)\./i, '$1,');
  // The printed index uses this one range to cover the infancy narrative
  // across the I.6/I.7 chapter boundary. Link to the first paragraph in the
  // range instead of the non-existent I.7(7) anchor.
  if (/^I,7\(7[-–—]12\)$/i.test(normalized)) {
    return '/tu-thuat/?book=quyen-1#chi-muc-6-7';
  }
  const match = normalized.match(/^([IVX]+),(\d+)(?:[,\(](\d+))?/i);
  if (!match) return '/tu-thuat/';
  const book = romanValues[match[1].toUpperCase()];
  if (!book) return '/tu-thuat/';
  const chapter = Number(match[2]);
  const paragraph = Number(match[3] ?? match[2]);
  if (chapter > confessionChapterMax[book]) return `/tu-thuat/?book=quyen-${book}`;
  return `/tu-thuat/?book=quyen-${book}#chi-muc-${chapter}-${paragraph}`;
};

const scriptureReferenceCount = scriptureBooks.reduce((total, book) => total + book.entries.length, 0);
const scriptureColumns = (
  booksForWork: typeof scriptureBooks,
  testament: 'Cựu Ước' | 'Tân Ước',
) => {
  const books = booksForWork.filter((book) => book.testament === testament);
  const midpoint = Math.ceil(books.length / 2);
  return [books.slice(0, midpoint), books.slice(midpoint)];
};
const keywordEntries = keywordData.entries as Array<{
  id: string;
  headword: string;
  text: string;
  page: number;
  confidence: number;
  references: string[];
  hasExplicitChildren: boolean;
  subentryCount: number;
  lines: Array<{
    sequence: number;
    page: number;
    column: 'left' | 'right';
    indent: number;
    level: number;
    text: string;
    displayText?: string;
    tabbedText: string;
    kind: 'main' | 'subkeyword' | 'continuation';
    references: string[];
  }>;
  directContinuations: Array<{
    text: string;
    displayText?: string;
  }>;
  subentries: Array<{
    text: string;
    lines: Array<{
      text: string;
      displayText?: string;
      indent: number;
    }>;
  }>;
}>;

const keywordReferencePattern = /\b(?:XXII|XXI|XX|XIX|XVIII|XVII|XVI|XV|XIV|XIII|XII|XI|X|IX|VIII|VII|VI|IV|V|III|II|I)[:,.]\s*\d+(?:\s*\([\d,.\s–—-]+\))?/gi;
const normalizeKeywordName = (value: string) => value
  .normalize('NFD')
  .replace(/\p{M}/gu, '')
  .replace(/\bsaint\b/gi, '')
  .replace(/[^a-z0-9]+/gi, ' ')
  .trim()
  .toLowerCase();

const buildKeywordTargetIds = (entries: typeof keywordEntries) => {
  const targets = new Map<string, string>();
  for (const entry of entries) {
    const canonical = entry.headword
      .replace(/,\s*see\b.*$/i, '')
      .replace(/\s*,\s*(?:XXII|XXI|XX|XIX|XVIII|XVII|XVI|XV|XIV|XIII|XII|XI|X|IX|VIII|VII|VI|IV|V|III|II|I)(?:\s*-\s*(?:XXII|XXI|XX|XIX|XVIII|XVII|XVI|XV|XIV|XIII|XII|XI|X|IX|VIII|VII|VI|IV|V|III|II|I))?(?:\s+passim)?$/i, '')
      .replace(/\s*,?\s*\b(?:XXII|XXI|XX|XIX|XVIII|XVII|XVI|XV|XIV|XIII|XII|XI|X|IX|VIII|VII|VI|IV|V|III|II|I)(?:\s*[-:.,]\s*\d.*)?$/i, '')
      .trim();
    const commaParts = canonical.split(',').map((part) => part.trim()).filter(Boolean);
    const semicolonParts = canonical.split(';').map((part) => part.trim()).filter(Boolean);
    const slashMatch = canonical.match(/\b([^/\s]+)\/([^,\s]+)\b/);
    const aliases = [
      canonical,
      canonical.replace(/\s*\([^)]*\)/g, ''),
      canonical.split('(')[0],
      canonical.split(':')[0],
      canonical.split('.')[0],
      canonical.split('/')[0],
      commaParts[0],
      ...(commaParts.length === 2 ? [`${commaParts[1]} ${commaParts[0]}`] : []),
      ...(semicolonParts.length > 1 ? semicolonParts : []),
      ...(slashMatch ? [
        canonical.replace(slashMatch[0], slashMatch[1]),
        canonical.replace(slashMatch[0], slashMatch[2]),
      ] : []),
    ];
    for (const alias of aliases) {
      const normalized = normalizeKeywordName(alias);
      if (normalized && !targets.has(normalized)) targets.set(normalized, entry.id);
    }
  }
  return targets;
};

const resolveKeywordTarget = (label: string, targets: Map<string, string>) => {
  const cleaned = label
    .replace(/\bp\s*\d+\b/gi, '')
    .replace(/^(?:also\s+)?under\s+/i, '')
    .replace(/[.,\s]+$/, '');
  const candidates = [
    cleaned,
    cleaned.replace(/\s*\([^)]*\)/g, ''),
    cleaned.split(':')[0],
    cleaned.split('.')[0],
    cleaned.replace(/,\s*below\b.*$/i, ''),
  ];
  const aliases: Record<string, string> = {
    bible: 'bible', scriptures: 'bible', scripture: 'bible',
    'new testament': 'bible', 'old testament': 'bible',
    'pagan gods': 'gods',
    human: 'human', humans: 'human', mankind: 'human', men: 'human',
    soul: 'soul', lying: 'lie lying',
  };
  for (const candidate of candidates) {
    const normalized = normalizeKeywordName(candidate);
    const singular = normalized.endsWith('s') ? normalized.slice(0, -1) : normalized;
    const target = targets.get(normalized)
      ?? targets.get(singular)
      ?? targets.get(aliases[normalized] ?? '');
    if (target) return target;
  }
  return null;
};

type KeywordPart = {
  text: string;
  href?: string;
  type?: 'reference' | 'see' | 'see-search';
  query?: string;
};
const keywordLineParts = (
  text: string,
  keywordTargets: Map<string, string>,
  linkReferences: boolean,
): KeywordPart[] => {
  const links: Array<{
    start: number;
    end: number;
    href: string;
    type: 'reference' | 'see' | 'see-search';
    query?: string;
  }> = [];
  for (const match of text.matchAll(keywordReferencePattern)) {
    const start = match.index ?? 0;
    links.push({
      start,
      end: start + match[0].length,
      href: linkReferences ? confessionLink(match[0]) : '',
      type: 'reference',
    });
  }

  const seeMatch = text.match(/\bsee(?:\s+also)?\s+(.+)$/i);
  const seePrefix = seeMatch?.index != null ? text.slice(0, seeMatch.index).trimEnd() : '';
  const isSeeDirective = Boolean(seeMatch?.index != null && (!seePrefix || seePrefix.endsWith(',')));
  if (seeMatch?.index != null && isSeeDirective) {
    const tail = seeMatch[1];
    const tailStart = seeMatch.index + seeMatch[0].indexOf(tail);
    for (const chunkMatch of tail.matchAll(/[^;]+/g)) {
      let chunk = chunkMatch[0];
      const colonIndex = chunk.indexOf(':');
      if (colonIndex >= 0) chunk = chunk.slice(0, colonIndex);
      const leading = chunk.match(/^\s*/)?.[0].length ?? 0;
      let cleaned = chunk.slice(leading);
      let cleanedOffset = leading;
      const underMatch = cleaned.match(/^(?:also\s+)?under\s+/i);
      if (underMatch) {
        cleanedOffset += underMatch[0].length;
        cleaned = cleaned.slice(underMatch[0].length);
      }
      cleaned = cleaned
        .replace(/\s+p\s*\d+\b.*$/i, '')
        .replace(/[.,\s]+$/, '');
      const exampleMatch = cleaned.match(/\be\.\s*g\.\s*[,.:]*\s*/i);
      if (exampleMatch?.index != null) {
        cleanedOffset += exampleMatch.index + exampleMatch[0].length;
        cleaned = cleaned.slice(exampleMatch.index + exampleMatch[0].length).trim();
      }
      const targetId = resolveKeywordTarget(cleaned, keywordTargets);
      if (!cleaned) continue;
      if (!targetId && /^(?:specific|individual)\b/i.test(cleaned)) continue;
      const start = tailStart + (chunkMatch.index ?? 0) + cleanedOffset;
      links.push(targetId
        ? { start, end: start + cleaned.length, href: `#${targetId}`, type: 'see' }
        : { start, end: start + cleaned.length, href: '#tu-khoa', type: 'see-search', query: cleaned });
    }
  }

  links.sort((left, right) => left.start - right.start || right.end - left.end);
  const parts: KeywordPart[] = [];
  let cursor = 0;
  for (const link of links) {
    if (link.start < cursor) continue;
    if (link.start > cursor) parts.push({ text: text.slice(cursor, link.start) });
    parts.push({ text: text.slice(link.start, link.end), href: link.href, type: link.type, query: link.query });
    cursor = link.end;
  }
  if (cursor < text.length) parts.push({ text: text.slice(cursor) });
  return parts;
};

const indexWorks = [
  {
    id: 'confessions',
    title: 'Tự Thuật',
    titleEn: 'Confessiones',
    scriptureBooks,
    keywordEntries,
    keywordTargets: buildKeywordTargetIds(keywordEntries),
    linkReferences: true,
  },
];

const joinKeywordLines = (lines: Array<{ text: string; displayText?: string }>) => lines
  .map((line) => line.displayText ?? line.text)
  .join(' ')
  .replace(/([A-Za-z])-\s+([a-z])/g, '$1$2')
  // These two citations are split immediately before the parenthesis in the
  // scanned source, so line-level OCR cannot validate them until they join.
  .replace(/\bXII,19\s+\(25\)/g, 'XIII,19(25)')
  .replace(/\bXII,18\s+\(23\)/g, 'XIII,18(23)')
  .replace(/\s+/g, ' ')
  .trim();

const startsWithReference = (text: string) => /^(?:XXII|XXI|XX|XIX|XVIII|XVII|XVI|XV|XIV|XIII|XII|XI|X|IX|VIII|VII|VI|IV|V|III|II|I)[:,.]\s*\d/i.test(text.trim());
const containsReference = (text: string) => /\b(?:XXII|XXI|XX|XIX|XVIII|XVII|XVI|XV|XIV|XIII|XII|XI|X|IX|VIII|VII|VI|IV|V|III|II|I)[:,.]\s*\d/i.test(text);
const keywordRows = (entry: typeof keywordEntries[number]) => {
  const rows: Array<{ depth: 0 | 1 | 2; lines: typeof entry.lines; text?: string }> = [];
  let nestedParentIndent: number | null = null;
  let nestedChildSeen = false;

  const appendLine = (line: typeof entry.lines[number]) => {
    if (!rows.length) rows.push({ depth: 0, lines: [line] });
    else rows[rows.length - 1].lines.push(line);
  };

  for (const [index, line] of entry.lines.entries()) {
    const text = line.displayText ?? line.text;
    if (index === 0) {
      rows.push({ depth: 0, lines: [line] });
      continue;
    }

    if (nestedParentIndent != null) {
      const nearParentIndent = line.level === 1 && line.indent <= nestedParentIndent + 12;
      const returnsToFirstLevel = line.level === 1
        && (line.indent < nestedParentIndent - 8 || (nestedChildSeen && nearParentIndent));
      if (!returnsToFirstLevel) {
        if (startsWithReference(text)) appendLine(line);
        else {
          rows.push({ depth: 2, lines: [line] });
          nestedChildSeen = true;
        }
        continue;
      }
      nestedParentIndent = null;
      nestedChildSeen = false;
    }

    if (line.level === 1 && !startsWithReference(text)) {
      const previous = rows.at(-1);
      const previousText = previous ? joinKeywordLines(previous.lines) : '';
      const previousNeedsContinuation = previous?.depth === 1
        && !/(?:^|,\s*)see(?:\s+also)?\b/i.test(previousText)
        && !containsReference(previousText)
        && !/[:,.;!?]\s*$/.test(previousText);
      if (previousNeedsContinuation) {
        appendLine(line);
        continue;
      }
      rows.push({ depth: 1, lines: [line] });
      if (text.trimEnd().endsWith(':')) {
        nestedParentIndent = line.indent;
        nestedChildSeen = false;
      }
    } else {
      appendLine(line);
    }
  }

  return rows.map((row) => ({ ...row, text: joinKeywordLines(row.lines) }));
};
---

<BaseLayout
  title="Chỉ Mục"
  description="Tra cứu Kinh Thánh và từ khóa trong các tác phẩm của Thánh Augustinô."
  bodyClass="no-sidebar page-chi-muc"
  banner="tu-thuat"
>
  <header class="lib-masthead idx-masthead">
    <p class="lib-masthead-sub">Công cụ tra cứu</p>
    <h1 class="lib-masthead-title">Chỉ Mục</h1>
    <div class="lib-masthead-rule" aria-hidden="true"><span class="lib-masthead-ornament">✦</span></div>
    <p class="lib-masthead-desc">Kinh Thánh và từ khóa trong các tác phẩm của Thánh Augustinô</p>
  </header>

  <main class="idx-shell">
    <section class="idx-control-deck" aria-label="Chọn tác phẩm và loại chỉ mục">
      <label class="idx-work-select" for="idx-work-select-input">
        <span class="idx-control-label">Tác phẩm</span>
        <span class="idx-work-field">
          <select id="idx-work-select-input" aria-label="Chọn tác phẩm">
            {indexWorks.map((work) => (
              <option value={work.id}>{work.title} — {work.titleEn}</option>
            ))}
          </select>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4" /></svg>
        </span>
      </label>

      <div class="idx-mode-switch" role="tablist" aria-label="Loại chỉ mục">
        <button class="idx-mode-button is-active" type="button" role="tab" aria-selected="true" aria-controls="idx-scripture" data-index-mode="scripture">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Zm16 0A2.5 2.5 0 0 0 17.5 3H13v16h4.5a2.5 2.5 0 0 1 2.5 2.5v-16Z"/></svg>
          <span>Kinh Thánh</span>
        </button>
        <button class="idx-mode-button" type="button" role="tab" aria-selected="false" aria-controls="idx-keywords" data-index-mode="keywords">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10.7 13.3-1.4-1.4 5.6-5.6a3 3 0 1 1 4.2 4.2l-3.4 3.4a3 3 0 0 1-4.2 0l-.8-.8m2.6-2.4 1.4 1.4-5.6 5.6a3 3 0 1 1-4.2-4.2l3.4-3.4a3 3 0 0 1 4.2 0l.8.8"/></svg>
          <span>Từ Khóa</span>
        </button>
      </div>
    </section>

    <section class="idx-toolbar" aria-label="Tìm và lọc chỉ mục">
      <label class="idx-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <input id="idx-search" type="search" autocomplete="off" aria-label="Tìm trong chỉ mục" placeholder="Tìm sách hoặc câu Kinh Thánh…" />
        <kbd>Esc</kbd>
      </label>
      <p class="idx-result-line" aria-live="polite"><strong id="idx-result-count">{scriptureReferenceCount}</strong> mục tham chiếu</p>
    </section>

    {indexWorks.map((work, workIndex) => (
    <div data-index-work-panel={work.id} hidden={workIndex !== 0}>
    <section id={`${work.id}-idx-scripture`} class="idx-panel" role="tabpanel" data-index-panel="scripture">
      <div class="idx-subfilters" role="group" aria-label="Lọc theo phần Kinh Thánh">
        <button type="button" class="idx-chip is-active" data-testament="all">Tất cả</button>
        <button type="button" class="idx-chip" data-testament="Cựu Ước">Cựu Ước</button>
        <button type="button" class="idx-chip" data-testament="Tân Ước">Tân Ước</button>
      </div>

      <div class="idx-scripture-groups">
        {(['Cựu Ước', 'Tân Ước'] as const).map((testament) => (
          <section class="idx-testament" data-testament-group={testament}>
            <header class="idx-section-heading">
              <h2>{testament}</h2>
            </header>
            <div class="idx-book-grid">
              {scriptureColumns(work.scriptureBooks, testament).map((column) => (
                <div class="idx-book-column">
                  {column.map((book) => (
                    <article
                      class="idx-book"
                      data-scripture-item
                      data-search={`${book.abbreviation} ${book.book} ${book.bookEn} ${book.entries.map(([reference]) => reference).join(' ')}`.toLocaleLowerCase('vi')}
                    >
                      <button class="idx-book-heading idx-book-toggle" type="button" aria-expanded="false">
                        <span class="idx-book-abbr">{book.abbreviation}</span>
                        <span>
                          <h3>{book.book}</h3>
                          <small>{book.bookEn}</small>
                        </span>
                        <em>{book.entries.length}</em>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 10 4 4 4-4" /></svg>
                      </button>
                      <div class="idx-book-rows" hidden>
                        {book.entries.map(([bibleReference, confessions]) => (
                          <div
                            class="idx-scripture-row"
                            data-scripture-row
                            data-book-abbreviation={book.abbreviation}
                            data-bible-reference={bibleReference}
                            data-search={`${book.abbreviation} ${book.book} ${book.bookEn} ${bibleReference} ${confessions.join(' ')}`.toLocaleLowerCase('vi')}
                          >
                            <strong class="idx-bible-reference">
                              <span class="idx-bible-book-code">{book.abbreviation}</span>
                              <span class="idx-bible-verse">{bibleReference}</span>
                            </strong>
                            <span class="idx-ref-arrow" aria-hidden="true">→</span>
                            <span class="idx-confession-links">
                              {confessions.map((reference) => (
                                <a class="idx-citation-badge" href={confessionLink(reference)} title={`Mở Tự Thuật ${reference}`}>{reference}</a>
                              ))}
                            </span>
                          </div>
                        ))}
                      </div>
                    </article>
                  ))}
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
      <p class="idx-empty" data-empty="scripture" hidden>Không tìm thấy câu Kinh Thánh phù hợp.</p>
    </section>

    <section id={`${work.id}-idx-keywords`} class="idx-panel" role="tabpanel" data-index-panel="keywords" hidden>
      <div class="idx-alphabet" aria-label="Lọc từ khóa theo chữ cái">
        <button type="button" class="is-active" data-letter="all">Tất cả</button>
        {'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').map((letter) => (
          <button type="button" data-letter={letter}>{letter}</button>
        ))}
      </div>

      <div class="idx-keyword-list">
        {work.keywordEntries.map((entry) => (
          <article
            class:list={['idx-keyword-entry', { 'has-explicit-children': entry.hasExplicitChildren }]}
            id={entry.id}
            data-keyword-item
            data-letter={entry.headword.charAt(0).toUpperCase()}
            data-search={`${entry.headword} ${entry.text} ${entry.references.join(' ')}`.toLowerCase()}
          >
            <div class="idx-keyword-main">
              {keywordRows(entry).map((row) => (
                <div
                  class:list={['idx-keyword-line', `is-depth-${row.depth}`]}
                >
                  {keywordLineParts(row.text ?? '', work.keywordTargets, work.linkReferences).map((part) => (
                    part.type === 'reference' && !work.linkReferences
                      ? <span class="idx-inline-reference idx-citation-badge is-static">{part.text}</span>
                      : part.href
                      ? <a
                          class:list={[
                            'idx-inline-reference',
                            {
                              'idx-citation-badge': part.type === 'reference',
                              'idx-see-link': part.type === 'see' || part.type === 'see-search',
                            },
                          ]}
                          href={part.href}
                          data-keyword-see={part.type === 'see' || part.type === 'see-search' ? '' : undefined}
                          data-keyword-search={part.type === 'see-search' ? part.query : undefined}
                          data-keyword-work={work.id}
                          title={part.type === 'see' || part.type === 'see-search' ? `Đi đến từ khóa ${part.text}` : `Mở Tự Thuật ${part.text}`}
                        >{part.text}</a>
                      : <span>{part.text}</span>
                  ))}
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
      <p class="idx-empty" data-empty="keywords" hidden>Không tìm thấy từ khóa phù hợp.</p>
    </section>
    </div>
    ))}

    <p class="idx-source-note citation-reference" data-index-source="confessions">
      Thánh Augustinô, <cite>The Confessions</cite>, Maria Boulding, O.S.B. dịch, dẫn nhập và chú thích;
      John E. Rotelle, O.S.A. chủ biên, <cite>The Works of Saint Augustine</cite>, tập I/1,
      New City Press, Hyde Park, New York. <cite>Index of Scripture</cite> do Michael Dolan biên soạn;
      <cite>Index</cite> do Joseph Sprung biên soạn.
    </p>
  </main>

  <script>
    const workSelect = document.getElementById('idx-work-select-input') as HTMLSelectElement | null;
    const workPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-index-work-panel]'));
    const sourceNotes = Array.from(document.querySelectorAll<HTMLElement>('[data-index-source]'));
    const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-index-mode]'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-index-panel]'));
    const search = document.getElementById('idx-search') as HTMLInputElement | null;
    const resultCount = document.getElementById('idx-result-count');
    const testamentButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-testament]'));
    const letterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.idx-alphabet button[data-letter]'));
    const bookToggles = Array.from(document.querySelectorAll<HTMLButtonElement>('.idx-book-toggle'));
    const keywordSeeLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-keyword-see]'));
    let work = 'confessions';
    let mode = 'scripture';
    let testament = 'all';
    let letter = 'all';
    let highlightedKeyword: HTMLElement | null = null;
    let keywordHighlightTimer = 0;

    const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    const currentWorkPanel = () => workPanels.find((panel) => panel.dataset.indexWorkPanel === work) ?? null;
    const updateLocation = (hash = mode === 'keywords' ? '#tu-khoa' : '#kinh-thanh') => {
      const url = new URL(location.href);
      if (work === 'confessions') url.searchParams.delete('work');
      else url.searchParams.set('work', work);
      url.hash = hash;
      history.replaceState(history.state, '', `${url.pathname}${url.search}${url.hash}`);
    };

    function filterCurrentPanel() {
      const workPanel = currentWorkPanel();
      if (!workPanel) return;
      const query = normalize(search?.value ?? '');
      const queryTerms = query.split(/\s+/).filter(Boolean);
      const exactScripture = query.match(/^(.+?)\s+(\d[\d,().-]*)$/);
      const matchesQuery = (value: string) => {
        const haystack = normalize(value);
        return queryTerms.length === 0 || queryTerms.every((term) => haystack.includes(term));
      };
      let visible = 0;
      if (mode === 'scripture') {
        workPanel.querySelectorAll<HTMLElement>('[data-testament-group]').forEach((group) => {
          const testamentMatch = testament === 'all' || group.dataset.testamentGroup === testament;
          let groupVisible = 0;
          group.querySelectorAll<HTMLElement>('[data-scripture-item]').forEach((book) => {
            let bookVisible = 0;
            book.querySelectorAll<HTMLElement>('[data-scripture-row]').forEach((row) => {
              const queryMatch = exactScripture
                ? normalize(row.dataset.bookAbbreviation ?? '') === exactScripture[1]
                  && normalize(row.dataset.bibleReference ?? '') === exactScripture[2]
                : matchesQuery(row.dataset.search ?? '');
              const match = testamentMatch && queryMatch;
              row.hidden = !match;
              if (match) { bookVisible += 1; visible += 1; }
            });
            book.hidden = bookVisible === 0;
            const rows = book.querySelector<HTMLElement>('.idx-book-rows');
            const toggle = book.querySelector<HTMLButtonElement>('.idx-book-toggle');
            const open = Boolean(query) || book.dataset.expanded === 'true';
            if (rows) rows.hidden = bookVisible === 0 || !open;
            book.classList.toggle('is-open', bookVisible > 0 && open);
            toggle?.setAttribute('aria-expanded', String(bookVisible > 0 && open));
            if (bookVisible) groupVisible += bookVisible;
          });
          group.querySelectorAll<HTMLElement>('.idx-book-column').forEach((column) => {
            column.hidden = !Array.from(column.querySelectorAll<HTMLElement>('[data-scripture-item]'))
              .some((book) => !book.hidden);
          });
          group.hidden = groupVisible === 0;
        });
      } else {
        workPanel.querySelectorAll<HTMLElement>('[data-keyword-item]').forEach((item) => {
          const letterMatch = letter === 'all' || item.dataset.letter === letter;
          const match = letterMatch && matchesQuery(item.dataset.search ?? '');
          item.hidden = !match;
          if (match) visible += 1;
        });
      }
      if (resultCount) resultCount.textContent = String(visible);
      const empty = workPanel.querySelector<HTMLElement>(`[data-empty="${mode}"]`);
      if (empty) empty.hidden = visible !== 0;
    }

    function setMode(nextMode: string, updateHash = true) {
      mode = nextMode === 'keywords' ? 'keywords' : 'scripture';
      modeButtons.forEach((button) => {
        const active = button.dataset.indexMode === mode;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
      });
      panels.forEach((panel) => {
        const panelWork = panel.closest<HTMLElement>('[data-index-work-panel]')?.dataset.indexWorkPanel;
        panel.hidden = panelWork !== work || panel.dataset.indexPanel !== mode;
      });
      if (search) {
        search.value = '';
        search.placeholder = mode === 'scripture' ? 'Tìm sách hoặc câu Kinh Thánh…' : 'Tìm từ khóa hoặc trích dẫn…';
      }
      if (updateHash) updateLocation();
      filterCurrentPanel();
    }

    function setWork(nextWork: string, updateUrl = true) {
      work = 'confessions';
      if (workSelect) workSelect.value = work;
      workPanels.forEach((panel) => {
        panel.hidden = panel.dataset.indexWorkPanel !== work;
      });
      sourceNotes.forEach((note) => {
        note.hidden = note.dataset.indexSource !== work;
      });
      testament = 'all';
      letter = 'all';
      testamentButtons.forEach((button) => {
        const buttonWork = button.closest<HTMLElement>('[data-index-work-panel]')?.dataset.indexWorkPanel;
        button.classList.toggle('is-active', buttonWork === work && button.dataset.testament === 'all');
      });
      letterButtons.forEach((button) => {
        const buttonWork = button.closest<HTMLElement>('[data-index-work-panel]')?.dataset.indexWorkPanel;
        button.classList.toggle('is-active', buttonWork === work && button.dataset.letter === 'all');
      });
      if (search) search.value = '';
      setMode(mode, false);
      if (updateUrl) updateLocation();
    }

    function revealKeywordTarget(target: HTMLElement, behavior: ScrollBehavior = 'smooth') {
      highlightedKeyword?.classList.remove('is-jump-target');
      window.clearTimeout(keywordHighlightTimer);
      highlightedKeyword = target;
      target.classList.add('is-jump-target');

      const align = (nextBehavior: ScrollBehavior) => {
        const navbar = document.querySelector<HTMLElement>('.navbar');
        const offset = Math.ceil((navbar?.getBoundingClientRect().bottom ?? 105) + 18);
        const top = Math.max(0, target.getBoundingClientRect().top + window.scrollY - offset);
        window.scrollTo({ top, behavior: nextBehavior });
      };

      requestAnimationFrame(() => {
        align(behavior);
        window.setTimeout(() => align('instant'), 260);
        window.setTimeout(() => align('instant'), 700);
      });
      keywordHighlightTimer = window.setTimeout(() => {
        target.classList.remove('is-jump-target');
        if (highlightedKeyword === target) highlightedKeyword = null;
      }, 2600);
    }

    workSelect?.addEventListener('change', () => setWork(workSelect.value));
    modeButtons.forEach((button) => button.addEventListener('click', () => setMode(button.dataset.indexMode ?? 'scripture')));
    bookToggles.forEach((toggle) => toggle.addEventListener('click', () => {
      const book = toggle.closest<HTMLElement>('[data-scripture-item]');
      const rows = book?.querySelector<HTMLElement>('.idx-book-rows');
      if (!book || !rows) return;
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      book.dataset.expanded = String(open);
      book.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      rows.hidden = !open;
    }));
    testamentButtons.forEach((button) => button.addEventListener('click', () => {
      testament = button.dataset.testament ?? 'all';
      const panel = button.closest<HTMLElement>('[data-index-work-panel]');
      panel?.querySelectorAll<HTMLButtonElement>('[data-testament]')
        .forEach((item) => item.classList.toggle('is-active', item === button));
      filterCurrentPanel();
    }));
    letterButtons.forEach((button) => button.addEventListener('click', () => {
      letter = button.dataset.letter ?? 'all';
      const panel = button.closest<HTMLElement>('[data-index-work-panel]');
      panel?.querySelectorAll<HTMLButtonElement>('.idx-alphabet button[data-letter]')
        .forEach((item) => item.classList.toggle('is-active', item === button));
      filterCurrentPanel();
    }));
    search?.addEventListener('input', filterCurrentPanel);
    search?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { search.value = ''; search.blur(); filterCurrentPanel(); }
    });
    keywordSeeLinks.forEach((link) => link.addEventListener('click', (event) => {
      event.stopPropagation();
      const keywordSearch = link.dataset.keywordSearch;
      const targetWork = link.dataset.keywordWork ?? 'confessions';
      setWork(targetWork, false);
      const workPanel = currentWorkPanel();
      if (keywordSearch) {
        event.preventDefault();
        letter = 'all';
        workPanel?.querySelectorAll<HTMLButtonElement>('.idx-alphabet button[data-letter]')
          .forEach((button) => button.classList.toggle('is-active', button.dataset.letter === 'all'));
        setMode('keywords', false);
        if (search) search.value = keywordSearch;
        filterCurrentPanel();
        updateLocation('#tu-khoa');
        const firstMatch = Array.from(workPanel?.querySelectorAll<HTMLElement>('[data-keyword-item]') ?? [])
          .find((item) => !item.hidden);
        if (firstMatch) revealKeywordTarget(firstMatch);
        else requestAnimationFrame(() => workPanel?.querySelector<HTMLElement>('[data-index-panel="keywords"]')?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
        return;
      }
      const targetId = link.hash.slice(1);
      const target = document.getElementById(targetId);
      if (!target) return;
      event.preventDefault();
      letter = 'all';
      workPanel?.querySelectorAll<HTMLButtonElement>('.idx-alphabet button[data-letter]')
        .forEach((button) => button.classList.toggle('is-active', button.dataset.letter === 'all'));
      setMode('keywords', false);
      updateLocation(`#${targetId}`);
      revealKeywordTarget(target);
    }));
    const initialKeywordTarget = /^#kw-\d+$/.test(location.hash);
    setWork('confessions', false);
    setMode(location.hash === '#tu-khoa' || initialKeywordTarget ? 'keywords' : 'scripture', false);
    if (initialKeywordTarget) {
      const initialTarget = document.querySelector<HTMLElement>(location.hash);
      if (initialTarget) revealKeywordTarget(initialTarget, 'instant');
    }
  </script>
</BaseLayout>

