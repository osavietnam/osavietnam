  'mua-thuong-nien': '#72c49a',
  'mua-chay':        '#a882c8',
  'mua-phuc-sinh':   '#f2d960',
  'le-chung':        '#d0c9be',
  'le-rieng':        '#e08888',
  'trong-kinh-chua': '#8b2020',
};
const SEASON_DARK_TEXT = new Set(['mua-giang-sinh','mua-chay','mua-phuc-sinh','le-chung','le-rieng']);
const SEASON_LABELS = {
  'mua-vong':        'Mùa Vọng',
  'mua-giang-sinh':  'Mùa Giáng Sinh',
  'mua-thuong-nien': 'Thường Niên',
  'mua-chay':        'Mùa Chay',
  'mua-phuc-sinh':   'Mùa Phục Sinh',
  'le-chung':        'Lễ Chung',
  'le-rieng':        'Lễ Riêng',
  'trong-kinh-chua': 'Lễ Trọng Kính Chúa',
};
const RANK_COLORS = {
  'solemn':      { bg: '#8b2020', text: '#efe7d6' },
  'feast':       { bg: '#e9c176', text: '#0d1f2b' },
  'memorial':    { bg: '#ccc8c0', text: '#0d1f2b' },
  'opt-memorial':{ bg: '#a8a4a0', text: '#0d1f2b' },
};
const RANK_LABELS = {
  'solemn':       'Lễ Trọng',
  'feast':        'Lễ Kính',
  'memorial':     'Lễ Nhớ Buộc',
  'opt-memorial': 'Lễ Nhớ Tùy Chọn',
};
const RANK_ORDER = { solemn: 0, feast: 1, memorial: 2, 'opt-memorial': 3 };
const RANK_CHIPS = {
  solemn:       { label: 'T', cls: 'chip-T' },
  feast:        { label: 'K', cls: 'chip-K' },
  memorial:     { label: 'N', cls: 'chip-N' },
  'opt-memorial': { label: 'n', cls: 'chip-n' },
};
const DAY_HEADERS = ['T2','T3','T4','T5','T6','T7','CN'];
const MONTH_NAMES = ['Tháng 1','Tháng 2','Tháng 3','Tháng 4','Tháng 5','Tháng 6','Tháng 7','Tháng 8','Tháng 9','Tháng 10','Tháng 11','Tháng 12'];
const DAY_NAMES = ['Chúa Nhật','Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy'];

// ===== DATA =====
// Lịch Chung: le-rieng lookup "MM-DD" → entries[]
const LR_BY_DATE = {};
for (const e of leRiengEntries) {
  const m = (e.liturgy || '').match(/Ng[àa]y\s+(\d+)\s+Th[áa]ng\s+(\d+)/i);
  if (!m) continue;
  const key = `${String(parseInt(m[2])).padStart(2,'0')}-${String(parseInt(m[1])).padStart(2,'0')}`;
  if (!LR_BY_DATE[key]) LR_BY_DATE[key] = [];
  LR_BY_DATE[key].push(e);
}

// Lịch Nhà Dòng: pre-processed ở build time, truyền qua define:vars
const SAINT_BY_DATE = saintByDate;

// Lookup liturgy text → { url, rank } bao phủ 626 bài Kinh Sách
const LITURGY_TO_ENTRY = liturgyToEntry;

function bioSlug(bioFile) {
  if (!bioFile) return null;
  return bioFile.split('/').pop().replace('.json', '');
}
function bioHref(slug) {
  return slug === 'st-augustine-of-hippo'
    ? '/thanh-au-tinh/#tieu-su'
    : `/thanh-chan-phuoc/${slug}/`;
}

function expandAbbrev(text) {
  if (!text) return text;
  return text
    .replace(/\bGh\./g, 'Giáo Hoàng')
    .replace(/\bGm\./g, 'Giám Mục')
    .replace(/\bLm\./g, 'Linh Mục')
    .replace(/\bVp\./g, 'Viện Phụ')
    .replace(/\bTs\./g, 'Tiến Sĩ')
    .replace(/\bTđ\./g, 'Tử Đạo')
    .replace(/\bTn\./g, 'Trinh Nữ')
    .replace(/\bNt\./g, 'Nữ Tu');
}

// Rank mặc định cho thánh-chân phước khi không có rank hoặc không hợp lệ
function saintRank(r) { return RANK_CHIPS[r] ? r : 'opt-memorial'; }

const calCache = {};

async function loadYear(year) {
  if (calCache[year] !== undefined) return calCache[year];
  calCache[year] = null; // mark as attempted
  try {
    const r = await fetch(`/data/calendar/${year}.json`);
    if (r.ok) calCache[year] = await r.json();
  } catch (_) {}
  return calCache[year];
}

function getDayInfo(dateStr) {
  const year = parseInt(dateStr.slice(0, 4));
  for (const y of [year, year + 1]) {
    const data = calCache[y];
    if (data && data.days && data.days[dateStr]) {
      return { ...data.days[dateStr], cycle: data.cycle };
    }
  }
  return null;
}

// ===== STATE =====
const todayDate = new Date();
const todayStr = fmtDate(todayDate);
let mode = 'chung';
let viewYear = todayDate.getFullYear();
let viewMonth = todayDate.getMonth();
let expanded = false;
let upcomingCollapsed = false;
let selectedDateStr = todayStr;

// ===== HELPERS =====
function fmtDate(d) {
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}

function hexToRgba(hex, alpha) {
  const r = parseInt(hex.slice(1,3),16);
  const g = parseInt(hex.slice(3,5),16);
  const b = parseInt(hex.slice(5,7),16);
  return `rgba(${r},${g},${b},${alpha})`;
}

function bestEntry(entries) {
  return entries.reduce((a,b) => (RANK_ORDER[a.rank]??99) <= (RANK_ORDER[b.rank]??99) ? a : b);
}

function seasonTextColor(sk) {
  if (sk === 'mua-vong' || sk === 'mua-thuong-nien') return '#ffffff';
  return SEASON_DARK_TEXT.has(sk) ? '#0d1f2b' : '#efe7d6';
}

function mmddKey(date) {
  return `${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
}

function makeEventDiv(rankKey, nameText) {
  const div = document.createElement('div');
  div.className = 'lpv-event';
  const chip = RANK_CHIPS[rankKey];
  const chipHtml = chip ? `<span class="lpv-rank-chip ${chip.cls}">${chip.label}</span>` : '';
  div.innerHTML = `${chipHtml}<span class="lpv-event-name">${expandAbbrev(nameText)}</span>`;
  return div;
}

// ===== RENDER: NAV =====
function renderNav() {
  document.getElementById('calMonthLabel').textContent =
    `${MONTH_NAMES[viewMonth]}, ${viewYear}`;

}

// ===== RENDER: GRID =====
function renderGrid() {
  const grid = document.getElementById('lpvGrid');
  const frag = document.createDocumentFragment();

  // Headers
  DAY_HEADERS.forEach((label, i) => {
    const h = document.createElement('div');
    h.className = 'lpv-cell-header' + (i === 6 ? ' is-sunday-col' : '');
    h.textContent = label;
    frag.appendChild(h);
  });

  const firstDay = new Date(viewYear, viewMonth, 1);
  const lastDate = new Date(viewYear, viewMonth + 1, 0).getDate();
  const startOffset = (firstDay.getDay() + 6) % 7; // Mon = 0

  // Padding before
  for (let i = startOffset - 1; i >= 0; i--) {
    const d = new Date(viewYear, viewMonth, -i);
    frag.appendChild(makeCell(d, true));
  }

  // Days of month
  for (let d = 1; d <= lastDate; d++) {
    frag.appendChild(makeCell(new Date(viewYear, viewMonth, d), false));
  }

  // Padding after
  const total = startOffset + lastDate;
  const remainder = total % 7;
  if (remainder > 0) {
    for (let i = 1; i <= 7 - remainder; i++) {
      frag.appendChild(makeCell(new Date(viewYear, viewMonth + 1, i), true));
    }
  }

  grid.replaceChildren(frag);
}

function makeCell(date, otherMonth) {
  const ds = fmtDate(date);
  const info = getDayInfo(ds);
  const key = mmddKey(date);
  const lr = LR_BY_DATE[key];
  const saints = SAINT_BY_DATE[key];
  const isSunday = date.getDay() === 0;
  const isToday = ds === todayStr;
  const isSelected = ds === selectedDateStr;

  const cell = document.createElement('div');
  cell.className = [
    'lpv-cell',
    otherMonth ? 'other-month' : '',
    isToday   ? 'today'      : '',
    isSunday  ? 'is-sunday'  : '',
    isSelected && !otherMonth ? 'selected' : '',
  ].filter(Boolean).join(' ');

  // Nhà Dòng: rank tint từ thánh-chân phước (chỉ background, không border-left)
  if (mode === 'nha-dong' && saints && saints.length > 0) {
    const best = bestEntry(saints);
    const rc = RANK_COLORS[saintRank(best.rank)];
    if (rc) cell.style.background = hexToRgba(rc.bg, 0.1);
  }

  // Day number
  const num = document.createElement('span');
  num.className = 'lpv-day-num';
  if (isToday) {
    const circle = document.createElement('span');
    circle.className = 'lpv-today-circle';
    circle.textContent = String(date.getDate());
    num.appendChild(circle);
  } else {
    num.textContent = String(date.getDate());
  }
  cell.appendChild(num);

  const FEAST_SEASONS = new Set(['le-rieng','le-chung','trong-kinh-chua']);

  if (mode === 'chung') {
    // Chúa Nhật: tên lễ từ lịch phụng vụ chung
    if (isSunday && info?.l) {
      const txt = document.createElement('div');
      txt.className = 'lpv-day-sunday';
      txt.textContent = info.l;
      cell.appendChild(txt);
    }
    // Lễ Chung / Lễ Trọng Kính Chúa: hiện badge bậc lễ (không bị chặn bởi lr)
    if (!isSunday && info?.l && (info.s === 'le-chung' || info.s === 'trong-kinh-chua')) {
      const entry = LITURGY_TO_ENTRY[info.l];
      if (entry?.rank && RANK_CHIPS[entry.rank]) {
        cell.appendChild(makeEventDiv(entry.rank, info.l));
      } else {
        const txt = document.createElement('div');
        txt.className = 'lpv-day-feast';
        txt.textContent = info.l;
        cell.appendChild(txt);
      }
    }
    // Lễ riêng cố định: ẩn khi trùng Chúa Nhật (Chúa Nhật được ưu tiên), hiện tất cả
    if (!isSunday && lr && lr.length > 0) {
      for (const e of lr) {
        const ci = (e.liturgy || '').indexOf(':');
        const fname = ci >= 0 ? e.liturgy.slice(ci + 1).trim() : e.liturgy;
        cell.appendChild(makeEventDiv(e.rank, fname));
      }
    }
  } else {
    // Nhà Dòng: thánh-chân phước — hiện tất cả
    if (saints && saints.length > 0) {
      for (const s of saints) {
        cell.appendChild(makeEventDiv(saintRank(s.rank), s.name));
      }
    }
  }

  if (!otherMonth) {
    cell.addEventListener('click', () => {
      selectedDateStr = ds;
      document.querySelectorAll('.lpv-cell.selected').forEach(c => c.classList.remove('selected'));
      cell.classList.add('selected');
      renderSidebar(date, info, lr, saints);
    });
  }

  return cell;
}

// ===== RENDER: LEGEND =====
function renderLegend() {
  const legend = document.getElementById('lpvLegend');
  const frag = document.createDocumentFragment();

  const CHIP_LEGEND = [
    { chip: 'T', cls: 'chip-T', label: 'Lễ Trọng' },
    { chip: 'K', cls: 'chip-K', label: 'Lễ Kính' },
    { chip: 'N', cls: 'chip-N', label: 'Lễ Nhớ Buộc' },
    { chip: 'n', cls: 'chip-n', label: 'Lễ Nhớ Tùy Chọn' },
  ];
  for (const { chip, cls, label } of CHIP_LEGEND) {
    const item = document.createElement('div');
    item.className = 'lpv-legend-item';
    item.innerHTML = `<span class="lpv-rank-chip ${cls}">${chip}</span><span>${label}</span>`;
    frag.appendChild(item);
  }

  legend.replaceChildren(frag);
}

// ===== RENDER: SIDEBAR =====
function renderSidebar(date, info, lr, saints) {
  const ds = fmtDate(date);
  const isActualToday = ds === todayStr;
  const isSun = date.getDay() === 0;
  const dayLabel = `${DAY_NAMES[date.getDay()]}, ${date.getDate()}/${date.getMonth()+1}/${date.getFullYear()}`;
  const stripeColor = info ? (SEASON_COLORS[info.s] || '#e9c176') : '#e9c176';
  const effectiveLr = isSun ? null : lr;
  const FEAST_SEASONS = new Set(['le-rieng','le-chung','trong-kinh-chua']);

  let html = `<div class="ltc-season-stripe" style="background:${stripeColor}"></div>`;
  html += `<div class="lpv-today-card-inner">`;
  html += `<div class="ltc-header">${isActualToday ? 'Hôm Nay' : 'Ngày Được Chọn'}</div>`;
  html += `<div class="ltc-date">${dayLabel}${info?.cycle ? `<span class="ltc-cycle"> · Năm ${info.cycle}</span>` : ''}</div>`;

  if (mode === 'chung') {
    if (info) {
      const slabel = SEASON_LABELS[info.s] || info.s;
      const mainEntry = LITURGY_TO_ENTRY[info.l];
      const mainUrl = mainEntry?.url || `/kinh-sach/?category=${info.s}`;

      // Badge bậc lễ cho Lễ Chung / Lễ Trọng Kính Chúa
      if ((info.s === 'le-chung' || info.s === 'trong-kinh-chua') && mainEntry?.rank && RANK_CHIPS[mainEntry.rank]) {
        const chip = RANK_CHIPS[mainEntry.rank];
        html += `<div class="ltc-chip-row"><span class="lpv-rank-chip ${chip.cls}">${chip.label}</span><span class="ltc-rank-label">${RANK_LABELS[mainEntry.rank] || ''}</span></div>`;
      }

      // Tên lễ / mùa — luôn hiển thị
      html += `<div class="ltc-liturgy">${info.l}</div>`;

      // Lễ riêng cố định (ẩn khi Chúa Nhật) — hiện tất cả
      if (effectiveLr && effectiveLr.length > 0) {
        for (const e of effectiveLr) {
          const chip = RANK_CHIPS[e.rank];
          const ci = (e.liturgy || '').indexOf(':');
          const fname = ci >= 0 ? e.liturgy.slice(ci + 1).trim() : e.liturgy;
          html += `<div class="ltc-feast-entry">${chip ? `<span class="lpv-rank-chip ${chip.cls}">${chip.label}</span>` : ''}<span class="ltc-feast-name">${expandAbbrev(fname)}</span></div>`;
        }
      }

      // Bài đọc: select + button icon căn phải dưới
      const READ_ICON = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
      const readings = [{ label: info.l, url: mainUrl }];
      if (effectiveLr && effectiveLr.length > 0) {
        for (const e of effectiveLr) {
          const ci = (e.liturgy || '').indexOf(':');
          const fname = ci >= 0 ? e.liturgy.slice(ci + 1).trim() : (e.liturgy || '');
          const chip = RANK_CHIPS[e.rank];
          readings.push({ label: `${chip ? `[${chip.label}] ` : ''}${fname}`, url: e.url || `/kinh-sach/?category=le-rieng` });
        }
      }
      html += `<div class="ltc-read-bar">`;
      if (readings.length > 1) {
        html += `<select class="ltc-reading-select" id="ltcReadingSelect">`;
        readings.forEach(r => { html += `<option value="${r.url}">${r.label}</option>`; });
        html += `</select>`;
        html += `<a href="${readings[0].url}" class="ltc-read-btn" id="ltcReadingLink" title="Đọc Kinh Sách">${READ_ICON}</a>`;
      } else {
        html += `<a href="${readings[0].url}" class="ltc-read-btn" title="Đọc Kinh Sách">${READ_ICON}</a>`;
      }
      html += `</div>`;
    } else {
      html += `<p class="ltc-no-feast">Chưa có dữ liệu lịch.</p>`;
    }
  } else {
    // Nhà Dòng: thánh-chân phước
    if (saints && saints.length > 0) {
      const best = bestEntry(saints);
      const chip = RANK_CHIPS[saintRank(best.rank)];
      const rl = RANK_LABELS[saintRank(best.rank)];
      html += `<div class="ltc-chip-row">${chip ? `<span class="lpv-rank-chip ${chip.cls}">${chip.label}</span>` : ''}<span class="ltc-rank-label">${rl || ''}</span></div>`;
      html += `<div class="ltc-liturgy">${expandAbbrev(best.name)}</div>`;
      if (saints.length > 1) {
        saints.slice(1).forEach(s => {
          const chip2 = RANK_CHIPS[saintRank(s.rank)];
          const sl2 = bioSlug(s.bioFile);
          const sname2 = expandAbbrev(s.name);
          html += `<div class="ltc-alt-feast">${chip2 ? `<span class="lpv-rank-chip ${chip2.cls}" style="font-size:0.9rem">${chip2.label}</span> ` : ''}${sl2 ? `<a href="${bioHref(sl2)}" style="color:var(--ink-cream-soft);text-decoration:none">${sname2}</a>` : sname2}</div>`;
        });
      }
      const slug = bioSlug(best.bioFile);
      const bioUrl = slug ? bioHref(slug) : null;
      if (info) {
        const slabel2 = SEASON_LABELS[info.s] || '';
        html += `<div class="ltc-liturgy ltc-muted" style="font-size:1.2rem;margin-top:0.6rem;padding-top:0.6rem;border-top:1px solid rgba(233,193,118,.1)">${slabel2} — ${info.l}</div>`;
      }
      // Lịch Nhà Dòng chỉ dẫn tới tiểu sử Thánh–Chân phước; không thêm
      // shortcut Kinh Sách vào panel Hôm Nay.
      if (bioUrl) {
        const READ_ICON2 = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
        html += `<div class="ltc-read-bar"><a href="${bioUrl}" class="ltc-read-btn" title="Đọc tiểu sử Thánh – Chân phước">${READ_ICON2}</a></div>`;
      }
    } else {
      // Không có lễ: không ghi thông báo
      if (info) {
        html += `<div class="ltc-liturgy ltc-muted">${info.l}</div>`;
      }
    }
  }

  html += `</div>`; // close lpv-today-card-inner
  document.getElementById('lpvToday').innerHTML = html;

  // Wire up select box nếu có nhiều bài
  const sel = document.getElementById('ltcReadingSelect');
  const lnk = document.getElementById('ltcReadingLink');
  if (sel && lnk) {
    sel.addEventListener('change', () => { lnk.href = sel.value; });
  }
  // Đánh dấu nguồn điều hướng để trang đọc biết back về lịch
  document.getElementById('lpvToday').querySelectorAll('.ltc-read-btn').forEach(btn => {
    btn.addEventListener('click', () => sessionStorage.setItem('ks-from', 'lich-phung-vu'));
  });
}

// ===== RENDER: UPCOMING =====
function renderUpcoming() {
  const el = document.getElementById('lpvUpcoming');
  const toggleLabel = upcomingCollapsed ? 'Mở danh sách lễ sắp tới' : 'Thu gọn danh sách lễ sắp tới';
  let html = `<div class="lupv-header">
    <span>Lễ Sắp Tới</span>
    <button class="lupv-toggle" type="button" aria-controls="lupvUpcomingBody" aria-expanded="${String(!upcomingCollapsed)}" aria-label="${toggleLabel}" title="${toggleLabel}">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
    </button>
  </div><div class="lupv-body" id="lupvUpcomingBody">`;

  const FEAST_SEASONS = new Set(['le-rieng','le-chung','trong-kinh-chua']);
  const d = new Date(todayDate);
  d.setDate(d.getDate() + 1);
  let count = 0, tries = 0;

  while (count < 8 && tries < 90) {
    tries++;
    const ds = fmtDate(d);
    const key = mmddKey(d);
    const info = getDayInfo(ds);
    const isSun = d.getDay() === 0;
    const saints = SAINT_BY_DATE[key];
    const lr = LR_BY_DATE[key];

    // Lễ riêng không hiển thị khi trùng Chúa Nhật
    const effectiveLr = isSun ? null : lr;
    const hasCalFeast = info && (isSun || FEAST_SEASONS.has(info.s));
    const hasSaint = saints && saints.length > 0;
    const hasLr = effectiveLr && effectiveLr.length > 0;

    const hasUpcomingEvent = mode === 'nha-dong'
      ? hasSaint
      : (hasCalFeast || hasLr);

    if (hasUpcomingEvent) {
      const label = `${DAY_NAMES[d.getDay()]}, ${d.getDate()}/${d.getMonth()+1}`;
      let itemHtml = `<div class="lupv-item"><div class="lupv-item-date">${label}</div>`;

      // Hàng lịch chung: mùa/tên lễ
      if (mode === 'chung' && hasCalFeast) {
        const color = SEASON_COLORS[info.s] || 'var(--gold)';
        itemHtml += `<div class="lupv-event-row">
          <span class="lupv-dot" style="background:${color}"></span>
          <span class="lupv-item-text">${info.l}</span>
        </div>`;
      }

      // Lễ riêng cố định (kinh sách index) — đã ẩn khi isSun, hiện tất cả
      if (mode === 'chung' && hasLr) {
        for (const e of effectiveLr) {
          const chip = RANK_CHIPS[e.rank];
          const ci = (e.liturgy || '').indexOf(':');
          const fname = ci >= 0 ? e.liturgy.slice(ci + 1).trim() : e.liturgy;
          itemHtml += `<div class="lupv-event-row">
            ${chip ? `<span class="lpv-rank-chip ${chip.cls}" style="font-size:0.85rem;line-height:1.6">${chip.label}</span>` : ''}
            <span class="lupv-item-text">${expandAbbrev(fname)}</span>
          </div>`;
        }
      }

      // Thánh-Chân phước (Nhà Dòng) — hiện tất cả
      if (mode === 'nha-dong' && hasSaint) {
        for (const s of saints) {
          const chip = RANK_CHIPS[saintRank(s.rank)];
          itemHtml += `<div class="lupv-event-row">
            ${chip ? `<span class="lpv-rank-chip ${chip.cls}" style="font-size:0.85rem;line-height:1.6">${chip.label}</span>` : ''}
            <span class="lupv-item-text">${expandAbbrev(s.name)}</span>
          </div>`;
        }
      }

      itemHtml += `</div>`;
      html += itemHtml;
      count++;
    }

    d.setDate(d.getDate() + 1);
  }

  html += `</div>`; // close lupv-body
  el.innerHTML = html;
  el.classList.toggle('is-collapsed', upcomingCollapsed);

  el.querySelector('.lupv-toggle')?.addEventListener('click', () => {
    upcomingCollapsed = !upcomingCollapsed;
    el.classList.toggle('is-collapsed', upcomingCollapsed);
    const toggle = el.querySelector('.lupv-toggle');
    const label = upcomingCollapsed ? 'Mở danh sách lễ sắp tới' : 'Thu gọn danh sách lễ sắp tới';
    toggle?.setAttribute('aria-expanded', String(!upcomingCollapsed));
    toggle?.setAttribute('aria-label', label);
    toggle?.setAttribute('title', label);
  });
}

// ===== FULL RENDER =====
function renderAll() {
  renderNav();
  renderGrid();
  renderLegend();
  const selDate = new Date(selectedDateStr + 'T00:00:00');
  const selInfo = getDayInfo(selectedDateStr);
  const selKey = mmddKey(selDate);
  renderSidebar(selDate, selInfo, LR_BY_DATE[selKey], SAINT_BY_DATE[selKey]);
  renderUpcoming();
}

// ===== INIT =====
(async () => {
  await Promise.all([
    loadYear(viewYear - 1),
    loadYear(viewYear),
    loadYear(viewYear + 1),
  ]);
  renderAll();
})();

// ===== EVENTS =====
document.getElementById('prevMonth').addEventListener('click', () => {
  viewMonth--;
  if (viewMonth < 0) { viewMonth = 11; viewYear--; }
  loadYear(viewYear).then(renderAll);
});
document.getElementById('nextMonth').addEventListener('click', () => {
  viewMonth++;
  if (viewMonth > 11) { viewMonth = 0; viewYear++; }
  loadYear(viewYear + 1).then(renderAll);
});
document.getElementById('goToday').addEventListener('click', () => {
  viewYear = todayDate.getFullYear();
  viewMonth = todayDate.getMonth();
  selectedDateStr = todayStr;
  renderAll();
});

const expandBtn = document.getElementById('expandBtn');
expandBtn.addEventListener('click', () => {
  expanded = !expanded;
  document.getElementById('lpvBody').classList.toggle('expanded', expanded);
  expandBtn.setAttribute('aria-expanded', String(expanded));
  expandBtn.title = expanded ? 'Thu gọn lịch' : 'Mở rộng lịch';
  expandBtn.innerHTML = expanded
    ? `<svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 1H1v4M10 1h4v4M5 14H1v-4M10 14h4v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`
    : `<svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1h4M1 1v4M14 1h-4M14 1v4M1 14h4M1 14v-4M14 14h-4M14 14v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`;
});

document.querySelectorAll('.lpv-tab').forEach(btn => {
  btn.addEventListener('click', () => {
    mode = btn.dataset.mode;
    document.querySelectorAll('.lpv-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderAll();
  });
});
</script>

</BaseLayout>
