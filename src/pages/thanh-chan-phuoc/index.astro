---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import saintData from '../../data/saint-index.json';
import pageHeaders from '../../data/page-headers.json';
const ph = (pageHeaders as Record<string, Record<string, string>>)['saints'];

const RANK_LABEL: Record<string, string> = {
  solemn:   'Lễ Trọng',
  feast:    'Lễ Kính',
  memorial: 'Lễ Nhớ',
  none:     '',
};
const MONTH_ABBR = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

const bioPosts = await getCollection('thanh-chan-phuoc', e => !e.data.draft);
const bioSlugs = new Set(bioPosts.map(p => p.id));
const bioSubtitles = Object.fromEntries(bioPosts.map(p => [p.id, p.data.subtitle ?? '']));

function getBioSlug(bioFile: string | undefined): string | null {
  if (!bioFile) return null;
  const s = bioFile.split('/').pop()?.replace('.json', '') ?? null;
  return s && bioSlugs.has(s) ? s : null;
}
function getEntryId(bioFile: string | undefined): string | null {
  return bioFile?.split('/').pop()?.replace(/\.json$/, '') || null;
}
function getBioHref(slug: string): string {
  return slug === 'st-augustine-of-hippo'
    ? '/thanh-au-tinh/#tieu-su'
    : `/thanh-chan-phuoc/${slug}/`;
}
function hasImg(f: string | undefined): boolean {
  return !!f && !f.endsWith('/') && !f.endsWith('.json') && f.length > 4;
}
function inferSubtitle(name: string): string {
  const n = name.toLocaleLowerCase('vi');
  if (n.includes('giám mục')) return 'Giám mục';
  if (n.includes('linh mục')) return 'Linh mục';
  if (n.includes('trinh nữ')) return 'Trinh nữ';
  if (n.includes('tu sĩ') || n.includes('tu huynh') || n.includes('ẩn sĩ')) return 'Tu sĩ';
  if (n.includes('tử đạo')) return 'Tử đạo';
  if (n.includes('đức mẹ')) return 'Đức Maria';
  return '';
}

const months = saintData.months;
---
<BaseLayout
  title="Thánh-Chân Phước"
  banner="saints"
  bodyClass="no-sidebar page-saints-index"
  description="Lịch kính các Thánh và Chân Phước Dòng Augustinô (Âu-Tinh) theo tháng và ngày lễ."
>

<div class="sp-wrap">

  <PageHeader
    title={ph.title}
    sub={ph.sub}
  />

  <!-- ── Mừng lễ hôm nay + sắp tới (JS điền) ── -->
  <div id="upcomingSection" style="display:none">
    <div class="sp-section-title"><span>Mừng Lễ Sắp Tới</span></div>
    <div class="uc-wrapper">
      <button class="uc-nav-btn uc-nav-left" id="ucLeft" aria-label="Trước">&#8249;</button>
      <div class="uc-viewport">
        <div class="uc-track" id="ucTrack"></div>
      </div>
      <button class="uc-nav-btn uc-nav-right" id="ucRight" aria-label="Sau">&#8250;</button>
    </div>
    <hr class="sp-divider">
  </div>

  <!-- Danh sách theo tháng -->
  <div class="sp-months">
    {months.map((month) => (
      <section class="sp-month" id={`thang-${month.monthNumber}`}>
        <div class="sp-month-title"><span>{month.monthName}</span></div>
        <div class="saints-grid">
          {month.saints.map((saint) => {
            const badge    = RANK_LABEL[saint.rank] || '';
            const rankCls  = `rank-${saint.rank}`;
            const slug     = getBioSlug(saint.bioFile);
            const entryId  = getEntryId(saint.bioFile);
            const subtitle = slug ? (bioSubtitles[slug] || inferSubtitle(saint.name)) : ((saint as any).subtitle || inferSubtitle(saint.name));
            const imgOk    = hasImg(saint.imageFile);
            const mAbbr    = MONTH_ABBR[month.monthNumber - 1];
            const isPatron = month.monthNumber === 8
                             && ((saint.day === 28 && (saint.bioFile ?? '').includes('st-augustine-of-hippo'))
                              || (saint.day === 27 && (saint.bioFile ?? '').includes('monica')));
            const extra    = [slug ? 'has-bio' : '', isPatron ? 'is-patron' : ''].filter(Boolean).join(' ');
            const inner = <>
              <div class="sc-img"></div>
              <div class="sc-overlay"></div>
              {badge && <span class={`rank-badge ${rankCls} sc-badge`}>{badge}</span>}
              <div class="sc-body">
                <div class="sc-date">{saint.day} {mAbbr}</div>
                <h4 class="sc-name">{saint.name}</h4>
                {subtitle && <p class="sc-subtitle">{subtitle}</p>}
                {slug && <span class="sc-readmore">Đọc tiểu sử →</span>}
              </div>
            </>;
            if (slug) {
              return (
                <a href={getBioHref(slug)}
                   class={`saint-card ${rankCls} ${extra}`}
                   data-saint-id={entryId || undefined}
                   {...(imgOk ? { style: `--sc-bg:url('${saint.imageFile}')` } : {})}
                   aria-label={saint.name}>
                  {inner}
                </a>
              );
            }
            return (
              <div class={`saint-card ${rankCls} ${extra}`}
                   data-saint-id={entryId || undefined}
                   {...(imgOk ? { style: `--sc-bg:url('${saint.imageFile}')` } : {})}
                   aria-label={saint.name}>
                {inner}
              </div>
            );
          })}
        </div>
      </section>
    ))}
  </div>

</div>

<dialog class="saint-inline-dialog" id="saintInlineDialog" aria-labelledby="saintInlineTitle">
  <form method="dialog" class="saint-inline-form" id="saintInlineForm">
    <header>
      <div>
        <small>Biên tập thẻ thánh</small>
        <h2 id="saintInlineTitle">Thánh – Chân phước</h2>
      </div>
      <button type="button" class="saint-inline-close" id="saintInlineClose" aria-label="Đóng">×</button>
    </header>
    <div class="saint-inline-grid">
      <label class="saint-inline-title-field">
        <span>Tên hiển thị</span>
        <input id="saintInlineName" type="text" required />
      </label>
      <label class="saint-inline-subtitle-field">
        <span>Phụ đề</span>
        <input id="saintInlineSubtitle" type="text" />
      </label>
      <label>
        <span>Bậc lễ</span>
        <select id="saintInlineRank">
          <option value="none">Không ghi bậc</option>
          <option value="memorial">Lễ Nhớ</option>
          <option value="feast">Lễ Kính</option>
          <option value="solemn">Lễ Trọng</option>
        </select>
      </label>
      <label>
        <span>Ngày</span>
        <input id="saintInlineDay" type="number" min="1" max="31" required />
      </label>
      <label>
        <span>Tháng</span>
        <select id="saintInlineMonth">
          {Array.from({ length: 12 }, (_, index) => <option value={index + 1}>Tháng {index + 1}</option>)}
        </select>
      </label>
      <label class="saint-inline-image-field">
        <span>Ảnh thẻ</span>
        <select id="saintInlineImage"></select>
      </label>
      <div class="saint-inline-image-preview">
        <img id="saintInlinePreview" alt="Xem trước ảnh thẻ" />
      </div>
      <div class="saint-inline-upload">
        <button type="button" id="saintInlineUpload">Tải ảnh mới</button>
        <input id="saintInlineFile" type="file" accept="image/jpeg,image/png,image/webp,image/avif,image/gif,image/svg+xml" hidden />
      </div>
    </div>
    <footer>
      <span id="saintInlineMessage" role="status"></span>
      <button type="button" class="saint-inline-cancel" id="saintInlineCancel">Hủy</button>
      <button type="submit" class="saint-inline-save">Lưu thay đổi</button>
    </footer>
  </form>
</dialog>

<script set:html={`
window.__SAINTS__=${JSON.stringify(saintData)};
window.__BIO_SLUGS__=${JSON.stringify([...bioSlugs])};
window.__BIO_SUBTITLES__=${JSON.stringify(bioSubtitles)};
`}></script>
<script>
const DATA      = window.__SAINTS__;
const BIO_SLUGS = new Set(window.__BIO_SLUGS__);
const BIO_SUBTITLES = window.__BIO_SUBTITLES__;
function inferSubtitle(name) {
  const n = String(name || '').toLocaleLowerCase('vi');
  if (n.includes('giám mục')) return 'Giám mục';
  if (n.includes('linh mục')) return 'Linh mục';
  if (n.includes('trinh nữ')) return 'Trinh nữ';
  if (n.includes('tu sĩ') || n.includes('tu huynh') || n.includes('ẩn sĩ')) return 'Tu sĩ';
  if (n.includes('tử đạo')) return 'Tử đạo';
  if (n.includes('đức mẹ')) return 'Đức Maria';
  return '';
}
const MONTH_VI   = ['Tháng 1','Tháng 2','Tháng 3','Tháng 4','Tháng 5','Tháng 6',
                    'Tháng 7','Tháng 8','Tháng 9','Tháng 10','Tháng 11','Tháng 12'];
const MONTH_ABBR = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const RANK_LABEL = { solemn:'Lễ Trọng', feast:'Lễ Kính', memorial:'Lễ Nhớ', none:'' };

function todayVN() {
  const s = new Intl.DateTimeFormat('sv-SE',{timeZone:'Asia/Ho_Chi_Minh'}).format(new Date());
  const [,m,d] = s.split('-').map(Number);
  return { m, d };
}
function getBioSlug(bioFile) {
  if (!bioFile) return null;
  const s = bioFile.split('/').pop()?.replace('.json','') ?? null;
  return s && BIO_SLUGS.has(s) ? s : null;
}
function getBioHref(slug) {
  return slug === 'st-augustine-of-hippo'
    ? '/thanh-au-tinh/#tieu-su'
    : `/thanh-chan-phuoc/${slug}/`;
}
function esc(s) {
  return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

/* ── Scroller nav helpers ── */
function smoothScrollTo(el, targetLeft, duration) {
  const start    = el.scrollLeft;
  const change   = targetLeft - start;
  const startTime = performance.now();
  function ease(t) { return t < .5 ? 2*t*t : -1+(4-2*t)*t; }
  function step(now) {
    const elapsed = now - startTime;
    const t = Math.min(elapsed / duration, 1);
    el.scrollLeft = start + change * ease(t);
    if (t < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

/* ── Scroller: lễ hôm nay (nếu có) đứng đầu + highlight, rồi tới các lễ sắp tới ── */
function buildUpcoming() {
  const { m: todayM, d: todayD } = todayVN();
  const all = DATA.months.flatMap(mo => mo.saints.map(s => ({ ...s, monthNumber: mo.monthNumber })));
  const isTodaySaint = s => s.monthNumber === todayM && s.day === todayD;
  const todaySaints = all.filter(isTodaySaint);
  const rest        = all.filter(s => !isTodaySaint(s));
  const future = rest.filter(s => s.monthNumber > todayM || (s.monthNumber === todayM && s.day > todayD));
  const past   = rest.filter(s => s.monthNumber < todayM || (s.monthNumber === todayM && s.day < todayD));
  /* Hôm nay lên đầu, kế đó là các lễ sắp tới (vòng qua đầu năm nếu cần) */
  const sorted = [...todaySaints, ...future, ...past].slice(0, 8);

  const html = sorted.map((s, i) => {
    const isToday  = isTodaySaint(s);
    const isNext   = !todaySaints.length && i === 0;
    const isPatron = s.monthNumber === 8
                  && ((s.day === 28 && (s.bioFile||'').includes('st-augustine-of-hippo'))
                   || (s.day === 27 && (s.bioFile||'').includes('monica')));
    const slug     = getBioSlug(s.bioFile);
    const entryId  = s.bioFile?.split('/').pop()?.replace(/\.json$/, '') || '';
    const subtitle = slug ? (BIO_SUBTITLES[slug] || inferSubtitle(s.name)) : (s.subtitle || inferSubtitle(s.name));
    const imgOk    = s.imageFile && !s.imageFile.endsWith('/') && !s.imageFile.endsWith('.json');
    const bgAttr   = imgOk ? ` style="--sc-bg:url('${s.imageFile}')"` : '';
    const badge    = RANK_LABEL[s.rank] || '';
    const mAbbr    = MONTH_ABBR[s.monthNumber - 1];
    const inner    = `
      <div class="sc-img"></div>
      <div class="sc-overlay"></div>
      ${isToday ? `<span class="sc-today-tag">Hôm Nay</span>` : ''}
      ${badge ? `<span class="rank-badge rank-${s.rank} sc-badge">${badge}</span>` : ''}
      <div class="sc-body">
        <div class="sc-date">${s.day} ${mAbbr}</div>
        <h4 class="sc-name">${esc(s.name)}</h4>
        ${subtitle ? `<p class="sc-subtitle">${esc(subtitle)}</p>` : ''}
        ${slug ? `<span class="sc-readmore">Đọc tiểu sử →</span>` : ''}
      </div>`;
    const cls = `saint-card rank-${s.rank}${isToday ? ' is-today' : ''}${isNext ? ' is-next' : ''}${isPatron ? ' is-patron' : ''}${slug ? ' has-bio' : ''}`;
    return slug
      ? `<a href="${getBioHref(slug)}" class="${cls}" data-saint-id="${esc(entryId)}"${bgAttr} aria-label="${esc(s.name)}">${inner}</a>`
      : `<div class="${cls}" data-saint-id="${esc(entryId)}"${bgAttr} aria-label="${esc(s.name)}">${inner}</div>`;
  }).join('');

  document.getElementById('ucTrack').innerHTML = html;
  document.getElementById('upcomingSection').style.display = '';
}

/* ── Sync card width: scroller card = grid card ── */
function syncCardWidth() {
  const wrapper = document.querySelector('.uc-wrapper');
  if (!wrapper) return;
  /* Lấy một card bất kỳ trong grid tĩnh bên dưới */
  const ref = document.querySelector('.saints-grid .saint-card');
  if (!ref) return;
  const w = ref.getBoundingClientRect().width;
  if (w > 0) wrapper.style.setProperty('--uc-card-w', w + 'px');
}

/* ── Nav buttons ── */
function setupScroller() {
  const track = document.getElementById('ucTrack');
  const left  = document.getElementById('ucLeft');
  const right = document.getElementById('ucRight');
  if (!track) return;

  const CARD_W = () => {
    const c = track.querySelector('.saint-card');
    if (!c) return 200;
    const style = getComputedStyle(track);
    return c.getBoundingClientRect().width + parseFloat(style.gap || '16');
  };

  const update = () => {
    const overflow = track.scrollWidth > track.clientWidth + 4;
    left.classList.toggle('visible',  overflow && track.scrollLeft > 8);
    right.classList.toggle('visible', overflow && track.scrollWidth - track.scrollLeft - track.clientWidth > 8);
  };

  left.addEventListener('click', () => {
    const cw = CARD_W();
    smoothScrollTo(track, Math.max(0, track.scrollLeft - cw * 2), 300);
  });
  right.addEventListener('click', () => {
    const cw = CARD_W();
    const max = track.scrollWidth - track.clientWidth;
    smoothScrollTo(track, Math.min(max, track.scrollLeft + cw * 2), 300);
  });

  track.addEventListener('scroll', update, { passive: true });
  new ResizeObserver(update).observe(track);
  setTimeout(update, 120);
}

buildUpcoming();
/* Sync width sau khi layout settle (1 rAF đủ vì grid đã SSR) */
requestAnimationFrame(() => {
  syncCardWidth();
  setupScroller();
  /* Cập nhật lại khi resize */
  const grid = document.querySelector('.saints-grid');
  if (grid) new ResizeObserver(syncCardWidth).observe(grid);
});

/* Mobile: lần chạm đầu chọn thẻ, lần chạm thứ hai mới mở tiểu sử. */
(() => {
  const touchNavigation = matchMedia('(hover: none), (pointer: coarse)');
  let selectedCard: HTMLAnchorElement | null = null;

  const clearSelection = (except?: HTMLAnchorElement | null) => {
    if (selectedCard && selectedCard !== except) {
      selectedCard.classList.remove('is-touch-selected');
    }
    if (!except) selectedCard = null;
  };

  document.addEventListener('click', event => {
    if (!touchNavigation.matches || event.detail === 0) return;
    const target = event.target as HTMLElement;
    if (target.closest('button, input, select, textarea, label')) return;
    const card = target.closest<HTMLAnchorElement>('a.saint-card.has-bio');

    if (!card) {
      clearSelection();
      return;
    }

    if (selectedCard !== card || !card.classList.contains('is-touch-selected')) {
      event.preventDefault();
      clearSelection(card);
      selectedCard = card;
      card.classList.add('is-touch-selected');
      card.focus({ preventScroll: true });
      return;
    }

    card.classList.remove('is-touch-selected');
    selectedCard = null;
  }, true);

  touchNavigation.addEventListener?.('change', () => clearSelection());
})();
</script>

<script>
(() => {
  const dialog = document.getElementById('saintInlineDialog') as HTMLDialogElement | null;
  if (!dialog) return;

  const ADMIN = `${window.location.protocol}//${window.location.hostname}:4322`;
  const form = document.getElementById('saintInlineForm') as HTMLFormElement;
  const title = document.getElementById('saintInlineTitle') as HTMLElement;
  const name = document.getElementById('saintInlineName') as HTMLInputElement;
  const subtitle = document.getElementById('saintInlineSubtitle') as HTMLInputElement;
  const rank = document.getElementById('saintInlineRank') as HTMLSelectElement;
  const day = document.getElementById('saintInlineDay') as HTMLInputElement;
  const month = document.getElementById('saintInlineMonth') as HTMLSelectElement;
  const image = document.getElementById('saintInlineImage') as HTMLSelectElement;
  const preview = document.getElementById('saintInlinePreview') as HTMLImageElement;
  const upload = document.getElementById('saintInlineUpload') as HTMLButtonElement;
  const fileInput = document.getElementById('saintInlineFile') as HTMLInputElement;
  const message = document.getElementById('saintInlineMessage') as HTMLElement;
  const save = form.querySelector<HTMLButtonElement>('.saint-inline-save')!;
  let active: any = null;
  let imageFiles: string[] | null = null;

  const json = async (url: string, options?: RequestInit) => {
    const response = await fetch(ADMIN + url, options);
    const data = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(data.error || `HTTP ${response.status}`);
    return data;
  };
  const asDataUrl = (file: File) => new Promise<string>((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(String(reader.result || ''));
    reader.onerror = () => reject(new Error('Không thể đọc ảnh'));
    reader.readAsDataURL(file);
  });
  const setMessage = (text = '', error = false) => {
    message.textContent = text;
    message.classList.toggle('is-error', error);
  };
  const paintPreview = () => {
    preview.src = image.value || '';
    preview.hidden = !image.value;
  };
  const populateImages = (current = '') => {
    const options = [...(imageFiles || [])];
    if (current && !options.includes(current)) options.unshift(current);
    image.innerHTML = '<option value="">— Không dùng ảnh —</option>' + options.map(url => {
      const label = url.split('/').pop() || url;
      return `<option value="${url.replace(/&/g,'&amp;').replace(/"/g,'&quot;')}">${label.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</option>`;
    }).join('');
    image.value = current;
    paintPreview();
  };

  async function openEditor(id: string) {
    setMessage('Đang tải…');
    dialog.showModal();
    try {
      const [item, library] = await Promise.all([
        json(`/api/studio/item?collection=thanh-chan-phuoc&id=${encodeURIComponent(id)}`),
        imageFiles ? Promise.resolve({ files:imageFiles }) : json('/api/studio/images?scope=saints'),
      ]);
      active = item;
      imageFiles = library.files || [];
      title.textContent = item.fm.title || id;
      name.value = item.fm.title || '';
      subtitle.value = item.fm.subtitle || '';
      rank.value = item.fm.rank || 'none';
      day.value = item.fm.feastDay || '';
      month.value = item.fm.feastMonth || '';
      populateImages(item.fm.imageFile || '');
      setMessage('');
    } catch (error) {
      active = null;
      setMessage(error instanceof Error ? error.message : 'Không thể tải dữ liệu', true);
    }
  }

  function closeEditor() {
    active = null;
    dialog.close();
  }

  function addEditTriggers() {
    document.querySelectorAll<HTMLElement>('.saint-card[data-saint-id]').forEach(card => {
      if (card.querySelector('.saint-inline-trigger')) return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'saint-inline-trigger';
      button.setAttribute('aria-label', `Sửa thẻ ${card.getAttribute('aria-label') || ''}`);
      button.title = 'Sửa trực tiếp thẻ này';
      button.innerHTML = '<span aria-hidden="true">✎</span><span>Sửa</span>';
      button.addEventListener('click', event => {
        event.preventDefault(); event.stopPropagation();
        const id = card.dataset.saintId;
        if (id) openEditor(id);
      });
      card.appendChild(button);
    });
  }

  json('/api/studio/manifest').then(() => {
    document.body.classList.add('saint-inline-admin');
    addEditTriggers();
  }).catch(() => dialog.remove());

  image.addEventListener('change', paintPreview);
  upload.addEventListener('click', () => fileInput.click());
  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0]; if (!file) return;
    upload.disabled = true; setMessage('Đang tải ảnh…');
    try {
      const result = await json('/api/studio/images', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ scope:'saints', filename:file.name, data:await asDataUrl(file) }),
      });
      imageFiles = [...new Set([...(imageFiles || []), result.url])];
      populateImages(result.url);
      setMessage('Ảnh đã tải lên. Bấm Lưu thay đổi để áp dụng.');
    } catch (error) { setMessage(error instanceof Error ? error.message : 'Tải ảnh thất bại', true); }
    finally { upload.disabled = false; fileInput.value = ''; }
  });

  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (!active || !form.reportValidity()) return;
    save.disabled = true; setMessage('Đang lưu…');
    const fm = { ...active.fm, title:name.value.trim(), subtitle:subtitle.value.trim(), rank:rank.value, feastDay:Number(day.value), feastMonth:Number(month.value), imageFile:image.value };
    try {
      await json('/api/studio/item', {
        method:'PUT', headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ collection:'thanh-chan-phuoc', id:active.id, originalId:active.id, fm, body:active.body, extension:active.extension, checksum:active.checksum }),
      });
      setMessage('Đã lưu. Đang cập nhật thẻ…');
      setTimeout(() => location.reload(), 450);
    } catch (error) {
      save.disabled = false;
      setMessage(error instanceof Error ? error.message : 'Lưu thất bại', true);
    }
  });

  document.getElementById('saintInlineClose')?.addEventListener('click', closeEditor);
  document.getElementById('saintInlineCancel')?.addEventListener('click', closeEditor);
  dialog.addEventListener('click', event => { if (event.target === dialog) closeEditor(); });
})();
</script>

<style is:global>
