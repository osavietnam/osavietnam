---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;
import PageHeader from '../../components/PageHeader.astro';

export async function getStaticPaths() {
  const entries = await getCollection('thanh-chan-phuoc', e => !e.data.draft);
  const ordered = [...entries].sort((a, b) => {
    const am = a.data.feastMonth ?? 99, bm = b.data.feastMonth ?? 99;
    const ad = a.data.feastDay ?? 99, bd = b.data.feastDay ?? 99;
    return am - bm || ad - bd || a.data.title.localeCompare(b.data.title, 'vi');
  });
  return ordered.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      related: ordered
        .slice(Math.max(0, index - 2), Math.min(ordered.length, index + 3))
        .filter((item) => item.id !== entry.id)
        .map((item) => ({
          id: item.id,
          title: item.data.title,
          subtitle: item.data.subtitle,
          feastDay: item.data.feastDay,
          feastMonth: item.data.feastMonth,
        })),
    },
  }));
}

const { entry, related = [] } = Astro.props;
if (entry.id === 'st-augustine-of-hippo') {
  return Astro.redirect('/thanh-au-tinh/#tieu-su', 301);
}
const { Content } = await render(entry);
const bioHref = (id: string) => id === 'st-augustine-of-hippo'
  ? '/thanh-au-tinh/#tieu-su'
  : `/thanh-chan-phuoc/${id}/`;

const RANK_LABEL: Record<string, string> = {
  solemn:   'Lễ Trọng',
  feast:    'Lễ Kính',
  memorial: 'Lễ Nhớ',
  none:     '',
};
const { title, subtitle, rank, feastDay, feastMonth, imageFile } = entry.data;
const rankLabel = RANK_LABEL[rank] || '';
const feastStr  = feastDay && feastMonth
  ? `Mừng kính: ${String(feastDay).padStart(2, '0')}/${String(feastMonth).padStart(2, '0')}`
  : '';
---
<BaseLayout
  title={title}
  banner="saints"
  bodyClass="no-sidebar"
  type="article"
  description={`Tiểu sử ${title} — Dòng Augustinô`}
  image={imageFile || undefined}
>

<div class="bio-masthead">
  <PageHeader title={title} subtitle={subtitle} desc={feastStr}>
    {rankLabel && <span slot="sub" class={`rank-badge rank-${rank}`}>{rankLabel}</span>}
  </PageHeader>
</div>

{imageFile && (
  <figure class="bio-fig">
    <img src={imageFile} alt={title} class="bio-img" loading="eager" decoding="async" />
  </figure>
)}

<div class="article-shell">
  <article class="prose"><Content /></article>
</div>

<div class="saint-end-tools">
  <button type="button" class="saint-back-toggle" id="saintBackToggle">
    <span aria-hidden="true">←</span> Quay lại danh sách
  </button>
</div>

{related.length > 0 && (
  <section class="saint-related" aria-labelledby="saint-related-title">
    <h2 id="saint-related-title">Xem thêm</h2>
    <div class="saint-related-grid">
      {related.map((item) => (
        <a class="saint-related-card" href={bioHref(item.id)}>
          <strong>{item.title}</strong>
          {item.subtitle && <span>{item.subtitle}</span>}
          {item.feastDay && item.feastMonth && <small>Mừng kính: {String(item.feastDay).padStart(2, '0')}/{String(item.feastMonth).padStart(2, '0')}</small>}
        </a>
      ))}
    </div>
  </section>
)}

<script>
  import { withBase } from '../../lib/site-path';

  // Dòng nguồn trong blockquote dùng cùng kiểu prose với các trang bài viết.
  document.querySelectorAll<HTMLQuoteElement>('.prose blockquote').forEach((quote) => {
    quote.querySelectorAll<HTMLParagraphElement>(':scope > p').forEach((paragraph) => {
      if (/^\s*[—–]\s/.test(paragraph.textContent ?? '')) {
        paragraph.classList.add('bq-cite');
      }
    });
  });

  document.getElementById('saintBackToggle')?.addEventListener('click', () => {
    window.location.href = withBase('/thanh-chan-phuoc/');
  });
</script>

<style>
/* Bio dùng master lib header (PageHeader). Tên thánh thường dài hơn tên
   tài liệu → thu nhỏ h1 cho phù hợp. */
.bio-masthead :global(.lib-masthead-title) {
  font-size: clamp(2.8rem, 5.5vw, 4.4rem);
  line-height: 1.25;
}
/* Danh hiệu/chức vụ thánh (subtitle) — dưới tên, trên ngày lễ */
.bio-masthead :global(.lib-masthead-subtitle) {
  font-family: var(--font-display);
  font-size: 1.75rem;
  font-style: italic;
  font-weight: 400;
  color: var(--ink-cream-soft);
  margin: 0.6rem 0 0;
  line-height: 1.4;
}

/* Ngày lễ (desc) — nổi bật: gold, đậm, không mờ, dấu ✦ hai bên */
.bio-masthead :global(.lib-masthead-desc) {
  font-family: var(--font-ui);
  font-size: 1.7rem;
  font-style: normal;
  font-weight: 600;
  letter-spacing: 0.05em;
  color: var(--gold);
  opacity: 1;
  display: inline-flex;
  align-items: center;
  gap: 0.9rem;
}
.bio-masthead :global(.lib-masthead-desc)::before,
.bio-masthead :global(.lib-masthead-desc)::after {
  content: '✦';
  font-size: 1rem;
  color: rgba(233,193,118,.55);
}

.saint-end-tools {
  max-width: min(112rem, 100%);
  margin: 3.8rem auto 0;
  padding-top: 1.8rem;
  border-top: 1px solid rgba(233,193,118,.18);
}
.saint-back-toggle {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  padding: .2rem 0;
  border: none;
  background: transparent;
  color: var(--ink-cream-soft);
  font: 600 1.2rem var(--font-ui);
  cursor: pointer;
  transition: color .2s;
}
.saint-back-toggle:hover { color: var(--gold); }
.saint-related {
  max-width: min(112rem, 100%);
  margin: 2.4rem auto 0;
}
.saint-related h2 {
  margin: 0 0 1rem;
  font: 600 1.7rem var(--font-display);
  color: var(--ink-cream);
}
.saint-related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: .8rem; }
.saint-related-card {
  display: flex; flex-direction: column; gap: .2rem;
  padding: .9rem 1rem;
  border-left: 2px solid rgba(233,193,118,.35);
  color: var(--ink-cream-soft); text-decoration: none;
  background: transparent;
  transition: color .2s, border-color .2s;
}
.saint-related-card:hover { color: var(--gold); border-left-color: var(--gold); }
.saint-related-card strong { font: 600 1.4rem var(--font-display); line-height: 1.35; }
.saint-related-card span, .saint-related-card small { font-size: 1.15rem; color: var(--ink-cream-soft); }
.saint-related-card small { font-style: italic; }
@media (max-width: 640px) {
  .saint-related-grid { grid-template-columns: 1fr; }
}

/* Chân dung thánh — khung trang trọng, đặt dưới header */
.bio-fig {
  display: block;
  width: min(28rem, 72%);
  margin: 0 auto 3.2rem;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid rgba(233,193,118,.3);
  box-shadow: 0 14px 44px rgba(0,0,0,.5), inset 0 0 0 1px rgba(233,193,118,.1);
  background: var(--bg-card);
}
.bio-img {
  display: block;
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  object-position: center top;
  filter: saturate(.92);
  transition: filter .3s, transform .5s;
}
.bio-fig:hover .bio-img { filter: saturate(1); transform: scale(1.03); }

@media (max-width: 480px) {
  .bio-fig { width: min(22rem, 82%); }
}
</style>

</BaseLayout>
