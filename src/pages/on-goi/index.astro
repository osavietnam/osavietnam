---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteReel from '../../components/QuoteReel.astro';
import ArticleImagePicker from '../../components/ArticleImagePicker.astro';
import pageHeaders from '../../data/page-headers.json';
import ongoi from '../../data/on-goi-content.json';

const ph = (pageHeaders as Record<string, Record<string, string>>)['on-goi'];
const sections = ongoi.sections as any[];
const quotes = ongoi.quotes as any[];
const [s0, s1, s2, s3] = sections;
const media = (ongoi as any).media ?? {
  banner: ['/images/on-goi/banner.avif', '/images/on-goi/demo-1.jpg', '/images/on-goi/demo-2.jpg'],
  history: ['/images/on-goi/demo-1.jpg', '/images/on-goi/demo-3.jpg'],
  augustinePortrait: '/db/saints/images/st-augustine-of-hippo.jpg',
  community: ['/images/on-goi/demo-2.jpg'],
  journey: ['/images/on-goi/demo-2.jpg', '/images/on-goi/demo-1.jpg'],
};
---
<BaseLayout title="Ơn Gọi" bodyClass="no-sidebar og-page" banner={null}>

  <!-- BANNER — full-bleed, ngoài main.content ── -->
  <div slot="full-bleed" class="og-banner-outer">
    <div class="og-banner og-slider">
      {media.banner.map((src: string, index: number) => <img src={src} alt="" class:list={['og-slide', index === 0 && 'active']} loading={index === 0 ? 'eager' : 'lazy'} data-og-media-target={`banner.${index}`} />)}
      <header class="og-masthead">
        <div class="og-masthead-head">
          <div class="masthead-identity">
            <p class="og-eyebrow"
               data-oe-target="ph" data-oe="eyebrow" data-oe-html="true"
               set:html={ph.eyebrow}></p>
            <img src="/images/emblem.svg" alt="" class="og-masthead-emblem" aria-hidden="true" />
          </div>
          <h1 class="og-title"
              data-oe-target="ph" data-oe="title">{ph.title}</h1>
        </div>
        <div class="og-masthead-foot">
          <p class="og-masthead-quote bvq-text"
             data-oe-target="ph" data-oe="quote" data-oe-html="true"
             set:html={ph.quote}></p>
          <cite class="og-masthead-cite bvq-cite"
             data-oe-target="ph" data-oe="cite" data-oe-html="true"
             set:html={ph.cite}></cite>
        </div>
      </header>
    </div>
  </div>

  <div class="og-content">

  <!-- VỀ DÒNG AUGUSTINÔ ────────────────────────── -->
  <section class="og-media" data-animate="slide-right">
    <figure class="og-media-img og-slider">
      {media.history.map((src: string, index: number) => <img class:list={['og-slide', index === 0 && 'active']} src={src} alt={index === 0 ? 'Cộng đoàn Augustinô' : ''} loading="lazy" data-og-media-target={`history.${index}`} />)}
    </figure>
    <div class="og-media-body" data-animate="slide-left">
      <p class="og-label"
         data-oe-target="content" data-oe="sections.0.label">{s0.label}</p>
      <h2 class="og-media-title"
          data-oe-target="content" data-oe="sections.0.title">{s0.title}</h2>
      <p class="og-body"
         data-oe-target="content" data-oe="sections.0.paragraphs.0">{s0.paragraphs[0]}</p>
      <p class="og-body"
         data-oe-target="content" data-oe="sections.0.paragraphs.1">{s0.paragraphs[1]}</p>
      <a class="og-link" href={s0.link.href}
         data-oe-target="content" data-oe="sections.0.link.text">{s0.link.text}</a>
    </div>
  </section>

  <!-- THÁNH AUGUSTINÔ ──────────────────────────── -->
  <section class="og-aug-section" data-animate>
    <figure class="og-aug-portrait">
      <div class="aug-arch-frame">
        <img src={media.augustinePortrait} alt="Thánh Augustinô thành Hippô" loading="lazy" data-og-media-target="augustinePortrait" />
      </div>
      <figcaption
        data-oe-target="content" data-oe="sections.1.caption">{s1.caption}</figcaption>
    </figure>
    <div class="og-aug-body">
      <p class="og-label"
         data-oe-target="content" data-oe="sections.1.label">{s1.label}</p>
      <h2 class="og-media-title"
          data-oe-target="content" data-oe="sections.1.title">{s1.title}</h2>
      <p class="og-body"
         data-oe-target="content" data-oe="sections.1.paragraphs.0">{s1.paragraphs[0]}</p>
      <p class="og-body"
         data-oe-target="content" data-oe="sections.1.paragraphs.1">{s1.paragraphs[1]}</p>
      <a class="og-link" href={s1.link.href}
         data-oe-target="content" data-oe="sections.1.link.text">{s1.link.text}</a>
    </div>
  </section>


  <!-- ĐỜI SỐNG CỘNG ĐOÀN ─────────────────────── -->
  <div class="og-divider" aria-hidden="true"><span></span><span class="og-div-gem">✦</span><span></span></div>

  <section class="og-media og-media--flip" data-animate="slide-left">
    <div class="og-media-body" data-animate="slide-right">
      <p class="og-label"
         data-oe-target="content" data-oe="sections.2.label">{s2.label}</p>
      <h2 class="og-media-title"
          data-oe-target="content" data-oe="sections.2.title">{s2.title}</h2>
      <p class="og-body"
         data-oe-target="content" data-oe="sections.2.paragraphs.0">{s2.paragraphs[0]}</p>
      <p class="og-body"
         data-oe-target="content" data-oe="sections.2.paragraphs.1">{s2.paragraphs[1]}</p>
    </div>
    <figure class="og-media-img og-slider">
      {media.community.map((src: string, index: number) => <img class:list={['og-slide', index === 0 && 'active']} src={src} alt={index === 0 ? 'Nhà nguyện cộng đoàn Augustinô' : ''} loading="lazy" data-og-media-target={`community.${index}`} />)}
    </figure>
  </section>

  <div class="og-inline-quote" data-animate>
    <QuoteReel quotes={quotes} />
  </div>

  <!-- HÀNH TRÌNH ƠN GỌI ──────────────────────── -->
  <section class="og-media" data-animate="slide-right">
    <figure class="og-media-img og-slider">
      {media.journey.map((src: string, index: number) => <img class:list={['og-slide', index === 0 && 'active']} src={src} alt={index === 0 ? 'Sinh hoạt hằng ngày tại cộng đoàn' : ''} loading="lazy" data-og-media-target={`journey.${index}`} />)}
    </figure>
    <div class="og-media-body" data-animate="slide-left">
      <p class="og-label"
         data-oe-target="content" data-oe="sections.3.label">{s3.label}</p>
      <h2 class="og-media-title"
          data-oe-target="content" data-oe="sections.3.title">{s3.title}</h2>
      <ul class="og-steps">
        {s3.steps.map((step: any, i: number) => (
          <li>
            <svg class="og-step-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <line x1="8" y1="1.5" x2="8" y2="14.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <line x1="2.5" y1="5.5" x2="13.5" y2="5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <strong data-oe-target="content" data-oe={`sections.3.steps.${i}.name`}>{step.name}</strong>
            <span   data-oe-target="content" data-oe={`sections.3.steps.${i}.desc`}>{step.desc}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="og-divider og-divider--slim" aria-hidden="true"><span></span><span class="og-div-gem">✦</span><span></span></div>

  </div><!-- /og-content -->

  <div class="og-inline-edit-tools" id="og-inline-edit-tools" hidden>
    <button type="button" id="oe-edit-btn" class="og-inline-edit-trigger" aria-label="Sửa trực tiếp trang Ơn gọi" title="Sửa trực tiếp trang Ơn gọi">
      <span aria-hidden="true">✎</span><span>Sửa trang</span>
    </button>
    <div id="oe-save-row" class="og-inline-edit-actions" hidden>
      <span id="oe-msg" role="status"></span>
      <button type="button" id="oe-media-btn">Ảnh & trích dẫn</button>
      <button type="button" id="oe-cancel-btn">Hủy</button>
      <button type="button" id="oe-save-btn" class="is-save">Lưu thay đổi</button>
    </div>
  </div>

  <dialog class="og-media-editor-dialog" id="og-media-editor-dialog" aria-labelledby="og-media-editor-title">
    <div class="og-media-editor-shell">
      <header>
        <div><small>Trang Ơn gọi</small><h2 id="og-media-editor-title">Ảnh, banner & trích dẫn</h2></div>
        <button type="button" id="og-media-editor-close" aria-label="Đóng">×</button>
      </header>
      <div class="og-media-editor-fields">
        <h3>Banner đầu trang</h3>
        {media.banner.map((src: string, index: number) => <ArticleImagePicker dataField={`banner.${index}`} label={`Ảnh banner ${index + 1}`} scope="vocation" />)}
        <h3>Ảnh các section</h3>
        {media.history.map((src: string, index: number) => <ArticleImagePicker dataField={`history.${index}`} label={`Lịch sử Dòng · ảnh ${index + 1}`} scope="vocation" />)}
        <ArticleImagePicker dataField="augustinePortrait" label="Chân dung Thánh Augustinô" scope="vocation" />
        {media.community.map((src: string, index: number) => <ArticleImagePicker dataField={`community.${index}`} label={`Đời sống cộng đoàn · ảnh ${index + 1}`} scope="vocation" />)}
        {media.journey.map((src: string, index: number) => <ArticleImagePicker dataField={`journey.${index}`} label={`Hành trình ơn gọi · ảnh ${index + 1}`} scope="vocation" />)}
        <h3>Trích dẫn giữa trang</h3>
        <div class="og-quote-editor-list">
          {quotes.map((quote: any, index: number) => (
            <section
              class="og-quote-editor-card"
              data-og-quote-editor
              data-quote-index={index}
              data-source-work={quote.source?.work ?? 'manual'}
              data-source-number={quote.source?.number ?? ''}
              data-source-book={quote.source?.book ?? ''}
              data-source-chapter={quote.source?.chapter ?? ''}
              data-source-paragraph={quote.source?.paragraph ?? ''}
            >
              <header><span>Trích dẫn {index + 1}</span><small>Hiển thị luân phiên giữa trang</small></header>
              <label class="is-full"><span>Nội dung</span><textarea rows="4" data-og-quote-text>{quote.text}</textarea></label>
              <label><span>Nguồn</span>
                <select data-og-quote-work>
                  <option value="manual">Nhập thủ công</option>
                  <option value="tu-luat-vi">Tu Luật</option>
                  <option value="hien-phap-vi">Hiến Pháp</option>
                  <option value="ratio-vi">Ratio Institutionis</option>
                  <option value="tu-thuat">Tự Thuật</option>
                </select>
              </label>
              <div class="og-quote-source-fields" data-og-quote-document hidden>
                <label><span>Số đoạn</span><select data-og-quote-number></select></label>
              </div>
              <div class="og-quote-source-fields is-confessions" data-og-quote-confessions hidden>
                <label><span>Quyển</span><select data-og-quote-book></select></label>
                <label><span>Chương</span><select data-og-quote-chapter></select></label>
                <label><span>Đoạn</span><select data-og-quote-paragraph></select></label>
              </div>
              <label class="is-full" data-og-quote-manual><span>Trích nguồn nhập tay</span><input type="text" data-og-quote-citation value={quote.cite} placeholder="Tác giả · Tác phẩm, số đoạn…" /></label>
              <p class="og-quote-source-preview" data-og-quote-preview>Nguồn nhập thủ công sẽ được giữ nguyên.</p>
            </section>
          ))}
        </div>
      </div>
      <footer><button type="button" id="og-media-editor-done">Xong</button></footer>
    </div>
  </dialog>

</BaseLayout>

<style is:global>
/* ── Page tokens ── */
.og-page { --og-rule: rgba(233,193,118,0.14); }

body.og-page main.content { padding-left: 0; padding-right: 0; }

.og-content {
  padding: 0 3rem;
}

.og-inline-edit-tools{position:fixed;z-index:94;right:1.1rem;bottom:1.1rem;font-family:var(--font-ui)}.og-inline-edit-tools[hidden],.og-inline-edit-actions[hidden],.og-inline-edit-trigger[hidden]{display:none}.og-inline-edit-trigger,.og-inline-edit-actions button{min-height:3.2rem;padding:.7rem .95rem;border:1px solid #d7ae60;border-radius:.55rem;color:#102118;background:#e9c176;font:650 .96rem/1 var(--font-ui);cursor:pointer;box-shadow:0 .35rem 1rem rgba(0,0,0,.22)}.og-inline-edit-trigger{display:inline-flex;align-items:center;gap:.5rem}.og-inline-edit-actions{display:flex;align-items:center;gap:.55rem;padding:.55rem;border:1px solid rgba(233,193,118,.34);border-radius:.7rem;background:#112019;box-shadow:0 .6rem 1.8rem rgba(0,0,0,.34)}.og-inline-edit-actions span{min-width:5rem;color:var(--ink-cream-soft);font-size:.9rem}.og-inline-edit-actions button{color:var(--ink-cream);background:#182920;border-color:#53685b;box-shadow:none}.og-inline-edit-actions .is-save{color:#102118;background:#e9c176;border-color:#e9c176}.oe-editing [data-oe]{position:relative;border-radius:.25rem;outline:2px dashed rgba(233,193,118,.72);outline-offset:.3rem;cursor:text}.oe-editing [data-oe]:focus{outline-style:solid;background:rgba(233,193,118,.09)}html[data-theme="light"] .og-inline-edit-trigger{color:#fff;background:#27664c;border-color:#27664c}html[data-theme="light"] .og-inline-edit-actions{background:#fff;border-color:#9fb3a7;box-shadow:0 .5rem 1.5rem rgba(18,50,35,.2)}html[data-theme="light"] .og-inline-edit-actions span{color:#53685b}html[data-theme="light"] .og-inline-edit-actions button{color:#173c2b;background:#fff;border-color:#9fb3a7}html[data-theme="light"] .og-inline-edit-actions .is-save{color:#fff;background:#27664c;border-color:#27664c}html[data-theme="light"] .oe-editing [data-oe]{outline-color:rgba(39,102,76,.65)}html[data-theme="light"] .oe-editing [data-oe]:focus{background:rgba(39,102,76,.07)}
.og-media-editor-dialog{width:min(92rem,calc(100vw - 2rem));height:min(82rem,calc(100dvh - 2rem));max-width:none;max-height:none;padding:0;overflow:hidden;border:1px solid #465b50;border-radius:1rem;color:#f2eee4;background:#0b1411;box-shadow:0 2rem 6rem rgba(0,0,0,.5)}.og-media-editor-dialog::backdrop{background:rgba(2,8,5,.76);backdrop-filter:blur(5px)}.og-media-editor-shell{display:grid;grid-template-rows:auto minmax(0,1fr) auto;height:100%}.og-media-editor-shell>header,.og-media-editor-shell>footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.2rem 1.5rem;border-bottom:1px solid #35483e;background:#14231c}.og-media-editor-shell>header small{color:#dfbd73;font:700 11px/1.2 var(--font-ui);letter-spacing:.1em;text-transform:uppercase}.og-media-editor-shell h2{margin:.25rem 0 0;color:#f2eee4;font:600 26px/1.2 var(--font-display)}.og-media-editor-shell>header button{width:3rem;height:3rem;padding:0;border:0;color:#f2eee4;background:transparent;font:400 2rem/1 var(--font-ui);cursor:pointer}.og-media-editor-fields{display:grid;grid-template-columns:1fr 1fr;align-content:start;gap:1.2rem 1.4rem;padding:1.5rem;overflow:auto}.og-media-editor-fields h3{grid-column:1/-1;margin:.6rem 0 0;padding-bottom:.55rem;border-bottom:1px solid #35483e;color:#dfbd73;font:600 18px/1.3 var(--font-display)}.og-media-editor-shell>footer{justify-content:flex-end;border-top:1px solid #35483e;border-bottom:0}.og-media-editor-shell>footer button{min-height:3.5rem;padding:.75rem 1.1rem;border:1px solid #dfbd73;border-radius:.55rem;color:#142018;background:#dfbd73;font:650 14px/1 var(--font-ui);cursor:pointer}html[data-theme="light"] .og-media-editor-dialog{color:#173c2b;background:#f7f9f7;border-color:#9fb3a7;box-shadow:0 2rem 5rem rgba(18,50,35,.25)}html[data-theme="light"] .og-media-editor-shell>header,html[data-theme="light"] .og-media-editor-shell>footer{background:#fff;border-color:#d7e0da}html[data-theme="light"] .og-media-editor-shell>header small,html[data-theme="light"] .og-media-editor-fields h3{color:#216247}html[data-theme="light"] .og-media-editor-shell h2,html[data-theme="light"] .og-media-editor-shell>header button{color:#173c2b}html[data-theme="light"] .og-media-editor-fields h3{border-color:#d7e0da}html[data-theme="light"] .og-media-editor-shell>footer button{color:#fff;background:#216247;border-color:#216247}
@media(max-width:640px){.og-inline-edit-tools{right:.75rem;bottom:.75rem}.og-inline-edit-trigger{width:3.2rem;padding:0;justify-content:center}.og-inline-edit-trigger span:last-child{display:none}.og-inline-edit-actions{flex-wrap:wrap;justify-content:flex-end;max-width:calc(100vw - 1.5rem)}.og-inline-edit-actions span{flex-basis:100%}}
@media(max-width:700px){.og-media-editor-dialog{width:calc(100vw - 1rem);height:calc(100dvh - 1rem)}.og-media-editor-fields{grid-template-columns:1fr;padding:1rem}.og-media-editor-fields h3{grid-column:auto}.og-media-editor-shell>header,.og-media-editor-shell>footer{padding:1rem}}

.og-media-editor-dialog{--am-bg:#0b1411;--am-panel:#14231c;--am-field:#0d1914;--am-line:#465b50;--am-line-soft:#35483e;--am-text:#f2eee4;--am-copy:#d5d9d2;--am-muted:#9ba8a0;--am-accent:#dfbd73;--am-accent-ink:#142018}html[data-theme="light"] .og-media-editor-dialog{--am-bg:#f7f9f7;--am-panel:#fff;--am-field:#fff;--am-line:#9fb3a7;--am-line-soft:#d7e0da;--am-text:#173c2b;--am-copy:#355444;--am-muted:#66786e;--am-accent:#216247;--am-accent-ink:#fff}
.og-quote-editor-list{grid-column:1/-1;display:grid;gap:1rem}.og-quote-editor-card{display:grid;grid-template-columns:minmax(12rem,.7fr) minmax(16rem,1.3fr);gap:1rem;padding:1.15rem;border:1px solid var(--am-line-soft);border-radius:.75rem;background:var(--am-panel);font-family:var(--font-ui)}.og-quote-editor-card>header{grid-column:1/-1;display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding-bottom:.75rem;border-bottom:1px solid var(--am-line-soft)}.og-quote-editor-card>header span{color:var(--am-text);font-size:1.05rem;font-weight:700}.og-quote-editor-card>header small{color:var(--am-muted);font-size:.78rem}.og-quote-editor-card label{display:grid;align-content:start;gap:.42rem;color:var(--am-copy);font-size:.82rem;font-weight:650}.og-quote-editor-card label.is-full{grid-column:1/-1}.og-quote-editor-card textarea,.og-quote-editor-card input,.og-quote-editor-card select{width:100%;min-height:3rem;padding:.68rem .78rem;border:1px solid var(--am-line);border-radius:.48rem;color:var(--am-text);background:var(--am-field);font:500 .98rem/1.45 var(--font-ui);outline:none}.og-quote-editor-card textarea{resize:vertical}.og-quote-editor-card textarea:focus,.og-quote-editor-card input:focus,.og-quote-editor-card select:focus{border-color:var(--am-accent);box-shadow:0 0 0 2px color-mix(in srgb,var(--am-accent) 22%,transparent)}.og-quote-source-fields{display:grid;gap:.75rem}.og-quote-source-fields.is-confessions{grid-column:1/-1;grid-template-columns:repeat(3,minmax(0,1fr))}.og-quote-source-fields[hidden],.og-quote-editor-card [hidden]{display:none}.og-quote-source-preview{grid-column:1/-1;margin:0;padding:.7rem .8rem;border-radius:.45rem;color:var(--am-copy);background:var(--am-field);font:500 .84rem/1.45 var(--font-ui)}
@media(max-width:700px){.og-quote-editor-card{grid-template-columns:1fr;padding:.9rem}.og-quote-editor-card>header,.og-quote-editor-card label.is-full,.og-quote-source-fields.is-confessions,.og-quote-source-preview{grid-column:auto}.og-quote-source-fields.is-confessions{grid-template-columns:1fr}.og-quote-editor-card>header{align-items:flex-start;flex-direction:column;gap:.2rem}.og-quote-editor-card textarea,.og-quote-editor-card input,.og-quote-editor-card select{font-size:1rem}}

/* ══ BANNER ════════════════════════════════════ */
.og-banner {
  position: relative;
  min-height: 98vh;
  display: flex; align-items: stretch; justify-content: flex-end;
  margin-top: -6.58rem;
  overflow: hidden;
}
.og-banner .og-slide { z-index: 0; filter: none; }
.og-banner::after {
  content: '';
  position: absolute; inset: 0; z-index: 1;
  background: linear-gradient(
    to bottom,
    transparent 0%,
    transparent 35%,
    rgba(10,18,36,0.14) 72%,
    var(--bg-main) 100%
  );
}
.og-masthead {
  position: relative; z-index: 2;
  text-align: center;
  width: 50%;
  padding: 7.5rem 4rem 4rem;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 1rem;
  background: rgba(8,14,30,0.40);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  border-left: 1px solid rgba(233,193,118,0.14);
  -webkit-mask-image: linear-gradient(to bottom, black 0%, black 72%, transparent 100%);
  mask-image: linear-gradient(to bottom, black 0%, black 72%, transparent 100%);
  opacity: 0;
  transform: translateX(2.5rem);
  transition: opacity 0.9s cubic-bezier(0.22,1,0.36,1) 0.5s,
              transform 0.9s cubic-bezier(0.22,1,0.36,1) 0.5s;
}
.og-masthead.is-visible {
  opacity: 1;
  transform: translateX(0);
}
.og-masthead-head {
  flex: 0 1 auto;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  width: 100%;
}
.masthead-identity {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  width: 100%;
}
.og-masthead-emblem {
  width: 11.8rem; height: 11.8rem;
  object-fit: contain;
  opacity: 0.55;
  filter: brightness(0) invert(1) sepia(1) saturate(3) hue-rotate(5deg) brightness(0.85);
  margin: -2.15rem auto 0.65rem;
  display: block;
  flex-shrink: 0;
}
.og-masthead-foot {
  width: 100%;
  text-align: center;
