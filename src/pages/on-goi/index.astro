<script define:vars={{ ongoiJson: ongoi, phJson: ph, mediaJson: media }}>
// ── Prevent BaseLayout auto-scroll ──────────────────────────────
document.body.dataset.noAutoscroll = 'true';

// ── Masthead slide-in ────────────────────────────────────────────
const masthead    = document.querySelector('.og-masthead');
const bannerEl    = document.querySelector('.og-banner');
const activeSlide = document.querySelector('.og-banner .og-slide.active');

function showMasthead() {
  if (!masthead) return;
  masthead.classList.remove('is-visible');
  requestAnimationFrame(() => requestAnimationFrame(() => masthead.classList.add('is-visible')));
}
function initMastheadOnScroll() {
  if (!masthead || !bannerEl) return;
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) showMasthead();
      else masthead.classList.remove('is-visible');
    });
  }, { threshold: 0.15 });
  obs.observe(bannerEl);
}
if (masthead) {
  if (!activeSlide || (activeSlide.complete && activeSlide.naturalHeight > 0)) {
    initMastheadOnScroll();
  } else {
    const fb = setTimeout(initMastheadOnScroll, 4000);
    activeSlide.addEventListener('load',  () => { clearTimeout(fb); initMastheadOnScroll(); }, { once: true });
    activeSlide.addEventListener('error', () => { clearTimeout(fb); initMastheadOnScroll(); }, { once: true });
  }
}

// ── Scroll reveal ────────────────────────────────────────────────
const revealObs = new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) e.target.classList.add('is-visible');
    else e.target.classList.remove('is-visible');
  });
}, { threshold: 0.07, rootMargin: '0px 0px -48px 0px' });
document.querySelectorAll('[data-animate]').forEach(el => revealObs.observe(el));

// ── Auto-slide images ────────────────────────────────────────────
document.querySelectorAll('.og-slider').forEach(panel => {
  const imgs = Array.from(panel.querySelectorAll('.og-slide'));
  if (imgs.length <= 1) return;
  let idx = 0;
  setInterval(() => {
    imgs[idx].classList.remove('active');
    idx = (idx + 1) % imgs.length;
    imgs[idx].classList.add('active');
  }, 4500);
});

// ── Highlight "Thiên Chúa" / "Chúa" trong masthead quote ──────────
document.querySelectorAll('.og-masthead-quote').forEach(el => {
  el.innerHTML = el.innerHTML.replace(
    /Thiên Chúa|Chúa/gi,
    m => `<span class="bvq-lord">${m.toUpperCase()}</span>`
  );
});

// ── Inline edit ───────────────────────────────────────────────────
const ADMIN = `${window.location.protocol}//${window.location.hostname}:4322`;
const oeBar     = document.getElementById('og-inline-edit-tools');
const oeEditBtn = document.getElementById('oe-edit-btn');
const oeSaveRow = document.getElementById('oe-save-row');
const oeCancelBtn = document.getElementById('oe-cancel-btn');
const oeSaveBtn   = document.getElementById('oe-save-btn');
const oeMsg       = document.getElementById('oe-msg');
const oeMediaBtn = document.getElementById('oe-media-btn');
const mediaDialog = document.getElementById('og-media-editor-dialog');
const mediaClose = document.getElementById('og-media-editor-close');
const mediaDone = document.getElementById('og-media-editor-done');

// Detect admin server
fetch(ADMIN + '/api/on-goi', { method: 'GET' }).then(r => {
  if (r.ok && oeBar) oeBar.removeAttribute('hidden');
}).catch(() => {});

function setNested(obj, path, val) {
  const parts = path.split('.');
  let cur = obj;
  for (let i = 0; i < parts.length - 1; i++) {
    const k = /^\d+$/.test(parts[i]) ? +parts[i] : parts[i];
    cur = cur[k];
  }
  const last = parts[parts.length - 1];
  cur[/^\d+$/.test(last) ? +last : last] = val;
}

function getNested(obj, path) {
  return path.split('.').reduce((value, key) => value?.[/^\d+$/.test(key) ? +key : key], obj);
}

const mediaInputs = Array.from(document.querySelectorAll('#og-media-editor-dialog [data-article-image-picker] input[data-field]'));
function resetMediaInputs() {
  mediaInputs.forEach(input => {
    const path = input.dataset.field;
    input.value = getNested(mediaJson, path) || '';
    input.closest('[data-article-image-picker]')?.dispatchEvent(new CustomEvent('article-image:refresh'));
    const target = Array.from(document.querySelectorAll('[data-og-media-target]')).find(node => node.dataset.ogMediaTarget === path);
    if (target && input.value) target.src = input.value;
  });
}
mediaInputs.forEach(input => input.addEventListener('input', () => {
  const target = Array.from(document.querySelectorAll('[data-og-media-target]')).find(node => node.dataset.ogMediaTarget === input.dataset.field);
  if (target && input.value.trim()) target.src = input.value.trim();
}));
resetMediaInputs();

const quoteEditors = Array.from(document.querySelectorAll('[data-og-quote-editor]'));
let quoteCatalog = null;
let quoteEditorsReady = false;

function setQuoteOptions(select, values, valueFor, labelFor, preferred = '') {
  if (!select) return;
  select.replaceChildren(...values.map(item => new Option(labelFor(item), valueFor(item))));
  if (preferred && Array.from(select.options).some(option => option.value === String(preferred))) select.value = String(preferred);
}

function quoteDocument(card) {
  const work = card.querySelector('[data-og-quote-work]')?.value;
  return quoteCatalog?.documents?.find(item => item.id === work);
}

function quoteBook(card) {
  const value = card.querySelector('[data-og-quote-book]')?.value;
  return quoteCatalog?.confessions?.find(item => String(item.number) === value);
}

function quoteChapter(card) {
  const value = card.querySelector('[data-og-quote-chapter]')?.value;
  return quoteBook(card)?.chapters?.find(item => item.roman === value);
}

function quoteParagraph(card) {
  const value = card.querySelector('[data-og-quote-paragraph]')?.value;
  return quoteChapter(card)?.paragraphs?.find(item => String(item.number) === value);
}

function updateQuotePreview(card) {
  const work = card.querySelector('[data-og-quote-work]')?.value || 'manual';
  const preview = card.querySelector('[data-og-quote-preview]');
  if (!preview) return;
  if (work === 'manual') {
    preview.textContent = 'Nguồn nhập thủ công sẽ được giữ nguyên.';
    return;
  }
  if (work === 'tu-thuat') {
    const book = quoteBook(card), chapter = quoteChapter(card), paragraph = quoteParagraph(card);
    preview.textContent = book && chapter && paragraph
      ? `Tự Thuật · Quyển ${book.roman} · Chương ${chapter.roman} · Đoạn ${paragraph.number}: ${paragraph.snippet}`
      : 'Chọn Quyển, Chương và Đoạn.';
    return;
  }
  const documentSource = quoteDocument(card);
  const number = card.querySelector('[data-og-quote-number]')?.value;
  const entry = documentSource?.entries?.find(item => String(item.number) === number);
  preview.textContent = documentSource && entry
    ? `${documentSource.label} · ${entry.number}: ${entry.snippet}`
    : 'Chọn số đoạn của văn bản.';
}

function refreshQuoteParagraphs(card, preferred = '') {
  const select = card.querySelector('[data-og-quote-paragraph]');
  setQuoteOptions(select, quoteChapter(card)?.paragraphs || [], item => String(item.number), item => `${item.number} — ${item.snippet}`, preferred);
  updateQuotePreview(card);
}

function refreshQuoteChapters(card, preferredChapter = '', preferredParagraph = '') {
  const select = card.querySelector('[data-og-quote-chapter]');
  setQuoteOptions(select, quoteBook(card)?.chapters || [], item => item.roman, item => `Chương ${item.roman}${item.title ? ` — ${item.title}` : ''}`, preferredChapter);
  refreshQuoteParagraphs(card, preferredParagraph);
}

function refreshQuoteCard(card, source = {}) {
  const workSelect = card.querySelector('[data-og-quote-work]');
  const work = workSelect?.value || source.work || 'manual';
  if (workSelect && source.work) workSelect.value = source.work;
  const activeWork = workSelect?.value || work;
  const documentFields = card.querySelector('[data-og-quote-document]');
  const confessionFields = card.querySelector('[data-og-quote-confessions]');
  const manualField = card.querySelector('[data-og-quote-manual]');
  if (documentFields) documentFields.hidden = activeWork === 'manual' || activeWork === 'tu-thuat';
  if (confessionFields) confessionFields.hidden = activeWork !== 'tu-thuat';
  if (manualField) manualField.hidden = activeWork !== 'manual';
  if (!quoteCatalog || activeWork === 'manual') {
    updateQuotePreview(card);
    return;
  }
  if (activeWork === 'tu-thuat') {
    const select = card.querySelector('[data-og-quote-book]');
    setQuoteOptions(select, quoteCatalog.confessions || [], item => String(item.number), item => `Quyển ${item.roman}`, source.book);
    refreshQuoteChapters(card, source.chapter, source.paragraph);
  } else {
    const documentSource = quoteDocument(card);
    const select = card.querySelector('[data-og-quote-number]');
    setQuoteOptions(select, documentSource?.entries || [], item => String(item.number), item => `${item.number} — ${item.snippet}`, source.number);
    updateQuotePreview(card);
  }
}

async function ensureQuoteCatalog() {
  if (quoteCatalog) return quoteCatalog;
  const response = await fetch(`${ADMIN}/api/studio/quote-sources`);
  if (!response.ok) throw new Error('Không thể tải danh mục nguồn có sẵn.');
  quoteCatalog = await response.json();
  return quoteCatalog;
}

function resetQuoteEditors() {
  quoteEditors.forEach(card => {
    const index = Number(card.dataset.quoteIndex || 0);
    const quote = ongoiJson.quotes?.[index] || {};
    const source = quote.source || { work: 'manual' };
    const text = card.querySelector('[data-og-quote-text]');
    const citation = card.querySelector('[data-og-quote-citation]');
    const work = card.querySelector('[data-og-quote-work]');
    if (text) text.value = quote.text || '';
    if (citation) citation.value = quote.cite || '';
    if (work) work.value = source.work || 'manual';
    refreshQuoteCard(card, source);
  });
}

function quoteCitationHtml(card) {
  const work = card.querySelector('[data-og-quote-work]')?.value || 'manual';
  if (work === 'manual') return card.querySelector('[data-og-quote-citation]')?.value.trim() || '';
  if (work === 'tu-thuat') {
    const book = quoteBook(card), chapter = quoteChapter(card), paragraph = quoteParagraph(card);
    if (!book || !chapter || !paragraph) return '';
    return `— Thánh Augustinô · <a href="/tu-thuat/?book=quyen-${book.number}#conf-${book.number}-${paragraph.number}"><em>Tự Thuật</em>, ${book.roman}, ${chapter.roman}, ${paragraph.number}</a>`;
  }
  const documentSource = quoteDocument(card);
  const number = card.querySelector('[data-og-quote-number]')?.value;
  const entry = documentSource?.entries?.find(item => String(item.number) === number);
  if (!documentSource || !entry) return '';
  const author = work === 'tu-luat-vi' ? 'Thánh Augustinô · ' : '';
  const suffix = work === 'tu-luat-vi' ? entry.number : `số ${entry.number}`;
  return `— ${author}<a href="${documentSource.route}#${work.replace(/-vi$/, '')}-${entry.number}"><em>${documentSource.label}</em>, ${suffix}</a>`;
}

quoteEditors.forEach(card => {
  card.querySelector('[data-og-quote-work]')?.addEventListener('change', async () => {
    try { await ensureQuoteCatalog(); } catch (error) {
      const preview = card.querySelector('[data-og-quote-preview]');
      if (preview) preview.textContent = error instanceof Error ? error.message : 'Không thể tải danh mục nguồn.';
    }
    refreshQuoteCard(card);
  });
  card.querySelector('[data-og-quote-number]')?.addEventListener('change', () => updateQuotePreview(card));
  card.querySelector('[data-og-quote-book]')?.addEventListener('change', () => refreshQuoteChapters(card));
  card.querySelector('[data-og-quote-chapter]')?.addEventListener('change', () => refreshQuoteParagraphs(card));
  card.querySelector('[data-og-quote-paragraph]')?.addEventListener('change', () => updateQuotePreview(card));
});
resetQuoteEditors();

let editing = false;

function enterEditMode() {
  editing = true;
  document.body.classList.add('oe-editing');
  document.querySelectorAll('[data-oe]').forEach(el => {
    el.setAttribute('contenteditable', 'true');
    el.dataset.oeOrig = el.dataset.oeHtml ? el.innerHTML : el.textContent;
  });
  if (oeEditBtn) oeEditBtn.setAttribute('hidden', '');
  if (oeSaveRow) oeSaveRow.removeAttribute('hidden');
  if (oeMsg) oeMsg.textContent = '';
}

function exitEditMode() {
  editing = false;
  document.body.classList.remove('oe-editing');
  document.querySelectorAll('[data-oe]').forEach(el => {
    el.removeAttribute('contenteditable');
  });
  if (oeEditBtn) oeEditBtn.removeAttribute('hidden');
  if (oeSaveRow) oeSaveRow.setAttribute('hidden', '');
}

function cancelEdit() {
  document.querySelectorAll('[data-oe]').forEach(el => {
    const orig = el.dataset.oeOrig;
    if (orig !== undefined) {
      if (el.dataset.oeHtml) el.innerHTML = orig;
      else el.textContent = orig;
    }
  });
  resetMediaInputs();
  resetQuoteEditors();
  exitEditMode();
}

async function saveEdit() {
  if (oeMsg) oeMsg.textContent = 'Đang lưu…';

  // Collect page-header fields
  const phData = Object.assign({}, phJson);
  document.querySelectorAll('[data-oe-target="ph"][data-oe]').forEach(el => {
    phData[el.dataset.oe] = el.dataset.oeHtml ? el.innerHTML.trim() : el.textContent.trim();
  });

  // Collect content fields (deep clone original, apply overrides)
  const contentData = JSON.parse(JSON.stringify(ongoiJson));
  document.querySelectorAll('[data-oe-target="content"][data-oe]').forEach(el => {
    const val = el.dataset.oeHtml ? el.innerHTML.trim() : el.textContent.trim();
    try { setNested(contentData, el.dataset.oe, val); } catch (err) {}
  });
  if (!contentData.media) contentData.media = {};
  mediaInputs.forEach(input => setNested(contentData.media, input.dataset.field, input.value.trim()));
  contentData.quotes = quoteEditors.map(card => {
    const work = card.querySelector('[data-og-quote-work]')?.value || 'manual';
    const source = { work };
    if (work === 'tu-thuat') {
      source.book = card.querySelector('[data-og-quote-book]')?.value || '';
      source.chapter = card.querySelector('[data-og-quote-chapter]')?.value || '';
      source.paragraph = card.querySelector('[data-og-quote-paragraph]')?.value || '';
    } else if (work !== 'manual') source.number = card.querySelector('[data-og-quote-number]')?.value || '';
    return {
      text: card.querySelector('[data-og-quote-text]')?.value.trim() || '',
      cite: quoteCitationHtml(card),
      source,
    };
  });

  try {
    const [r1, r2] = await Promise.all([
      fetch(ADMIN + '/api/page-headers/on-goi', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(phData),
      }),
      fetch(ADMIN + '/api/on-goi', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(contentData),
      }),
    ]);
    if (r1.ok && r2.ok) {
      if (oeMsg) oeMsg.textContent = 'Đã lưu!';
      setTimeout(exitEditMode, 900);
    } else {
      if (oeMsg) oeMsg.textContent = 'Lỗi khi lưu';
    }
  } catch {
    if (oeMsg) oeMsg.textContent = 'Không kết nối được admin server';
  }
}

oeEditBtn  ?.addEventListener('click', enterEditMode);
oeCancelBtn?.addEventListener('click', cancelEdit);
oeSaveBtn  ?.addEventListener('click', saveEdit);
oeMediaBtn?.addEventListener('click', async () => {
  try {
    await ensureQuoteCatalog();
    if (!quoteEditorsReady) {
      resetQuoteEditors();
      quoteEditorsReady = true;
    }
  } catch (error) {
    quoteEditors.forEach(card => {
      const preview = card.querySelector('[data-og-quote-preview]');
      if (preview) preview.textContent = error instanceof Error ? `${error.message} Bạn vẫn có thể nhập nguồn thủ công.` : 'Không thể tải nguồn. Bạn vẫn có thể nhập thủ công.';
    });
  }
  mediaDialog?.showModal();
});
mediaClose?.addEventListener('click', () => mediaDialog?.close());
mediaDone?.addEventListener('click', () => mediaDialog?.close());
mediaDialog?.addEventListener('click', event => { if (event.target === mediaDialog) mediaDialog.close(); });
</script>
