        <div class="hm-legend" aria-label="Ký hiệu lịch phụng vụ">
          <span><i aria-hidden="true"></i>Lịch Chung</span>
          <span class="is-order"><i aria-hidden="true"></i>Lịch Nhà Dòng</span>
        </div>
        <div class="hm-liturgy-content" id="homeLiturgyContent" aria-live="polite">
          <p>Đang tải lịch phụng vụ…</p>
        </div>
        <footer class="hm-panel-links">
          <a href="/lich-phung-vu/">Lịch Phụng Vụ <span aria-hidden="true">→</span></a>
          <a href="/kinh-sach/">Bài Đọc Kinh Sách <span aria-hidden="true">→</span></a>
        </footer>
      </article>

      <article class="hm-panel hm-quotes" aria-labelledby="home-daily-title" data-home-daily-quotes>
