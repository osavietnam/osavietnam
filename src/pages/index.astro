<script define:vars={{ dailyQuoteGroups, saintByDate }}>
  document.body.dataset.noAutoscroll = 'true';

  const masthead = document.querySelector('.og-masthead');
  const banner = document.querySelector('.og-banner');
  const activeSlide = document.querySelector('.og-banner .og-slide.active');
  const titleWords = Array.from(document.querySelectorAll('.home-title-word'));
  const revealTitleWords = () => {
    titleWords.forEach((word) => word.classList.remove('is-revealing', 'is-revealed'));
    requestAnimationFrame(() => requestAnimationFrame(() => {
      titleWords.forEach((word) => word.classList.add('is-revealing'));
    }));
  };
  const showMasthead = () => {
    if (!masthead) return;
    masthead.classList.remove('is-visible');
    requestAnimationFrame(() => requestAnimationFrame(() => masthead.classList.add('is-visible')));
    window.setTimeout(revealTitleWords, 500);
  };
  const observeMasthead = () => {
    if (!masthead || !banner) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => entry.isIntersecting ? showMasthead() : masthead.classList.remove('is-visible'));
    }, { threshold: .15 });
    observer.observe(banner);
  };
  if (!activeSlide || (activeSlide.complete && activeSlide.naturalHeight > 0)) observeMasthead();
  else activeSlide.addEventListener('load', observeMasthead, { once: true });
  window.setTimeout(() => titleWords.forEach((word) => word.classList.add('is-revealed')), 2200);

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.og-slider').forEach((panel) => {
      const slides = Array.from(panel.querySelectorAll('.og-slide'));
      if (slides.length < 2) return;
      let active = 0;
      window.setInterval(() => {
        slides[active]?.classList.remove('active');
        active = (active + 1) % slides.length;
        slides[active]?.classList.add('active');
      }, 5200);
    });
  }

  const zonedParts = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Asia/Ho_Chi_Minh', year: 'numeric', month: '2-digit', day: '2-digit',
  }).formatToParts(new Date());
  const datePart = (type) => zonedParts.find((part) => part.type === type)?.value ?? '';
  const year = datePart('year');
  const month = datePart('month');
  const day = datePart('day');
  const dateKey = `${year}-${month}-${day}`;
  const saintKey = `${month}-${day}`;
  const today = new Date(`${dateKey}T12:00:00+07:00`);
  const daySeed = Math.floor(Date.UTC(Number(year), Number(month) - 1, Number(day)) / 86400000);

  const fullDate = new Intl.DateTimeFormat('vi-VN', {
    timeZone: 'Asia/Ho_Chi_Minh', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
  }).format(today);
  const dayNode = document.getElementById('homeTodayDay');
  const monthNode = document.getElementById('homeTodayMonth');
  if (dayNode) dayNode.textContent = day;
  if (monthNode) monthNode.textContent = fullDate;

  document.querySelectorAll('[data-home-quote-group]').forEach((card, groupIndex) => {
    const key = card.getAttribute('data-home-quote-group');
    const group = dailyQuoteGroups.find((item) => item.key === key);
    if (!group?.quotes?.length) return;
    let quoteIndex = Math.abs(daySeed + groupIndex * 7) % group.quotes.length;
    const quote = group.quotes[quoteIndex];
    const text = card.querySelector('[data-home-quote-text]');
    const cite = card.querySelector('[data-home-quote-cite]');
    if (text) text.textContent = quote.text;
    if (cite) cite.innerHTML = quote.cite;
    requestAnimationFrame(() => card.classList.add('is-ready'));

    if (group.quotes.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let quoteTimer;
      const scheduleNextQuote = (delay = 12000 + groupIndex * 900) => {
        window.clearTimeout(quoteTimer);
        quoteTimer = window.setTimeout(() => {
          if (document.hidden || card.matches(':hover') || card.matches(':focus-within')) {
            scheduleNextQuote(2400);
            return;
          }
          card.classList.add('is-changing');
          window.setTimeout(() => {
            quoteIndex = (quoteIndex + 1) % group.quotes.length;
            const nextQuote = group.quotes[quoteIndex];
            if (text) text.textContent = nextQuote.text;
            if (cite) cite.innerHTML = nextQuote.cite;
            card.classList.remove('is-changing');
            scheduleNextQuote();
          }, 320);
        }, delay);
      };
      scheduleNextQuote(5200 + groupIndex * 1700);
    }
  });

  document.querySelectorAll('[data-home-daily-quotes]:not([data-daily-reel-ready])').forEach((reel) => {
    reel.setAttribute('data-daily-reel-ready', 'true');
    const slides = Array.from(reel.querySelectorAll('[data-home-daily-slide]'));
    const dots = Array.from(reel.querySelectorAll('[data-home-daily-index]'));
    if (!slides.length) return;

    let current = 0;
    let reelTimer;
    const showSlide = (nextIndex) => {
      current = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        const active = index === current;
        slide.classList.toggle('active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        slide.tabIndex = active ? 0 : -1;
      });
      dots.forEach((dot, index) => {
        const active = index === current;
        dot.classList.toggle('active', active);
        dot.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    };
    const stopReel = () => window.clearInterval(reelTimer);
    const startReel = () => {
      stopReel();
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        reelTimer = window.setInterval(() => showSlide(current + 1), 7600);
      }
    };

    dots.forEach((dot, index) => dot.addEventListener('click', () => {
      showSlide(index);
      startReel();
    }));
    reel.addEventListener('pointerenter', stopReel);
    reel.addEventListener('pointerleave', startReel);
    reel.addEventListener('focusin', stopReel);
    reel.addEventListener('focusout', startReel);
    showSlide(0);
    startReel();
  });

  const seasonLabels = {
    'mua-vong': 'Mùa Vọng',
    'mua-giang-sinh': 'Mùa Giáng Sinh',
    'mua-thuong-nien': 'Mùa Thường Niên',
    'mua-chay': 'Mùa Chay',
    'mua-phuc-sinh': 'Mùa Phục Sinh',
    'le-chung': 'Lễ Chung',
    'le-rieng': 'Lễ Riêng',
    'trong-kinh-chua': 'Lễ Trọng Kính Chúa',
  };
  const rankLabels = {
    solemn: 'Lễ Trọng', feast: 'Lễ Kính', memorial: 'Lễ Nhớ', 'opt-memorial': 'Lễ Nhớ Tùy Chọn',
  };
  const homeLiturgy = document.getElementById('homeLiturgyContent');
  let calendarInfo = null;

  const bioHref = (bioFile) => {
    const slug = (bioFile || '').split('/').pop()?.replace('.json', '');
    if (!slug) return '/thanh-chan-phuoc/';
    return slug === 'st-augustine-of-hippo' ? '/thanh-au-tinh/#tieu-su' : `/thanh-chan-phuoc/${slug}/`;
  };

  const renderHomeLiturgy = () => {
    if (!homeLiturgy) return;
    const saints = saintByDate[saintKey] || [];
    if (!calendarInfo && !saints.length) {
      homeLiturgy.innerHTML = '<p class="home-liturgy-loading">Chưa có dữ liệu lịch phụng vụ cho hôm nay.</p>';
      return;
    }
    const season = calendarInfo ? (seasonLabels[calendarInfo.s] || calendarInfo.s || '') : '';
    const generalEvent = calendarInfo ? `
      <div class="home-liturgy-event home-liturgy-event-general">
        <span class="home-event-calendar">Lịch Chung</span>
        ${season ? `<span class="season-badge season-${calendarInfo.s}">${season}</span>` : ''}
        <strong>${calendarInfo.l || 'Ngày phụng vụ'}</strong>
        ${calendarInfo.cycle ? `<small>Năm phụng vụ ${calendarInfo.cycle}</small>` : ''}
      </div>` : '';
    const orderEvents = saints.map((saint) => `
      <a class="home-liturgy-event home-liturgy-event-order" href="${bioHref(saint.bioFile)}">
        <span class="home-event-calendar">Nhà Dòng</span>
        <span class="rank-badge rank-${rankLabels[saint.rank] ? saint.rank : 'opt-memorial'}">${rankLabels[saint.rank] || 'Lễ Nhớ Tùy Chọn'}</span>
        <strong>${saint.name}</strong>
      </a>`).join('');
    const orderEmpty = saints.length ? '' : `
      <div class="home-liturgy-order-empty">
        <span class="home-event-calendar">Nhà Dòng</span>
        <span>Không có lễ riêng hôm nay</span>
      </div>`;
    homeLiturgy.innerHTML = `<div class="home-liturgy-events">${generalEvent}${orderEvents}${orderEmpty}</div>`;
  };

  fetch(window.__OSA_PATH__?.(`/data/calendar/${year}.json`) ?? `/data/calendar/${year}.json`)
    .then((response) => response.ok ? response.json() : Promise.reject(new Error('calendar unavailable')))
    .then((data) => {
      calendarInfo = data?.days?.[dateKey] ? { ...data.days[dateKey], cycle: data.cycle } : null;
      renderHomeLiturgy();
    })
    .catch(() => renderHomeLiturgy());

  const syncNewsFrames = () => {
    const theme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    document.querySelectorAll('[data-home-news-frame]').forEach((frame) => {
      const base = frame.getAttribute('data-news-base');
      if (!base) return;
      const params = new URLSearchParams({ theme });
      if (frame.hasAttribute('data-news-open-external')) params.set('external', '1');
      const next = `${base}?${params}`;
      if (frame.getAttribute('src') !== next) frame.setAttribute('src', next);
    });
  };
  syncNewsFrames();
  new MutationObserver(syncNewsFrames).observe(document.documentElement, {
    attributes: true, attributeFilter: ['data-theme'],
  });

  const revealItems = document.querySelectorAll('[data-reveal]');
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    }, { threshold: .08 });
    revealItems.forEach((item) => observer.observe(item));
  }
</script>

