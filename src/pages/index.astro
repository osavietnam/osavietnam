---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CategoryArticleGallery from '../components/CategoryArticleGallery.astro';
import pageHeaders from '../data/page-headers.json';
import saintIndexRaw from '../data/saint-index.json';
import { BANNERS, type BannerVariant } from '../lib/banners';

const ph = (pageHeaders as Record<string, Record<string, string>>)['on-goi'];
const homeBannerRaw = BANNERS.home;
const homeBanner = (Array.isArray(homeBannerRaw) ? homeBannerRaw[0] : homeBannerRaw) as BannerVariant;
const homeQuoteText = homeBanner.quoteText?.trim() || 'Đồng Tâm Nhất Trí Hướng Về Thiên Chúa';
const homeQuoteWords = homeQuoteText.split(/\s+/).filter(Boolean);
const homeQuoteBreak = Math.ceil(homeQuoteWords.length / 2);
const homeQuoteLines = [homeQuoteWords.slice(0, homeQuoteBreak), homeQuoteWords.slice(homeQuoteBreak)].filter((line) => line.length);

const allArticles = await getCollection('bai-viet', ({ data }) => !data.draft);
const byDate = (a: typeof allArticles[number], b: typeof allArticles[number]) =>
  (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
  || a.data.title.localeCompare(b.data.title, 'vi');

const editorialArticles = allArticles
  .filter(({ id, data }) => (id.startsWith('linh-dao/') || id.startsWith('triet-hoc/') || id.startsWith('than-hoc/')) && !data.translationOf && data.language !== 'en')
  .sort(byDate);

const articleHref = (id: string) => id.startsWith('linh-dao/')
  ? `/linh-dao/bai-viet/${id.replace(/^linh-dao\//, '')}/`
  : `/bai-viet/${id}/`;

const articleDomain = (article: typeof allArticles[number]) => {
  if (article.id.startsWith('linh-dao/')) return article.data.category ?? 'Linh Đạo';
  return article.data.subcategory ?? article.data.category ?? 'Bài Viết';
};

const articleSummary = (article: typeof allArticles[number]) => ({
  id: article.id,
  title: article.data.title,
  href: articleHref(article.id),
  category: articleDomain(article),
  excerpt: article.data.excerpt,
  author: article.data.author,
  image: article.data.image ?? article.data.heroImage,
  date: article.data.date,
});

const featuredEditorial = editorialArticles.find(({ data }) => data.featured) ?? editorialArticles[0];
const homeEditorialArticles = featuredEditorial
  ? [featuredEditorial, ...editorialArticles.filter(({ id }) => id !== featuredEditorial.id)].slice(0, 12)
  : [];
const homeEditorialGroups = homeEditorialArticles.map((article) => ({
  category: articleDomain(article),
  articles: [articleSummary(article)],
}));

const communityPosts = allArticles
  .filter(({ id }) => id.startsWith('sinh-hoat-cong-doan/'))
  .sort(byDate)
  .slice(0, 2);

const communityImage = (index: number) => `/images/on-goi/demo-${(index % 3) + 1}.jpg`;

const saintByDate: Record<string, { name: string; rank: string; bioFile: string }[]> = {};
for (const month of (saintIndexRaw as any).months) {
  for (const saint of month.saints) {
    const key = `${String(month.monthNumber).padStart(2, '0')}-${String(saint.day).padStart(2, '0')}`;
    if (!saintByDate[key]) saintByDate[key] = [];
    saintByDate[key].push({ name: saint.name, rank: saint.rank, bioFile: saint.bioFile ?? '' });
  }
}

const dailyQuoteGroups = [
  {
    key: 'rule',
    label: 'Tu Luật',
    href: '/tu-luat/#tu-luat-3',
    quotes: [
      {
        text: 'Mục đích chính yếu mà anh em quy tụ cùng nhau là để sống hòa hợp dưới một mái nhà, và đồng tâm nhất trí với nhau hướng về Thiên Chúa.',
        cite: 'Thánh Augustinô · <em>Tu Luật</em>, 3',
      },
      {
        text: 'Anh em thân mến, trên hết mọi sự hãy yêu mến Thiên Chúa và rồi yêu thương tha nhân.',
        cite: 'Thánh Augustinô · <em>Tu Luật</em>, 1',
      },
      {
        text: 'Khi cầu nguyện cùng Thiên Chúa bằng thánh vịnh và thánh ca, anh em hãy suy niệm trong lòng điều mà môi miệng cất lên.',
        cite: 'Thánh Augustinô · <em>Tu Luật</em>, 12',
      },
    ],
  },
  {
    key: 'constitution',
    label: 'Hiến Pháp',
    href: '/hien-phap/',
    quotes: [
      {
        text: 'Mục đích của Hội Dòng là hiệp nhất hài hòa với nhau trong tình huynh đệ và tình bạn thiêng liêng, tìm kiếm và thờ lạy Thiên Chúa, và làm việc để phục vụ dân Ngài.',
        cite: '<em>Hiến Pháp</em>, 13',
      },
      {
        text: 'Cộng đoàn là một cái trục mà quanh nó đời sống tu trì của Dòng Thánh Augustinô quay quanh.',
        cite: '<em>Hiến Pháp</em>, 26',
      },
      {
        text: 'Tất cả chúng ta là các tông đồ, vì tất cả chúng ta đều cầu nguyện, làm việc và hỗ trợ lẫn nhau.',
        cite: '<em>Hiến Pháp</em>, 36',
      },
    ],
  },
  {
    key: 'ratio',
    label: 'Ratio Institutionis',
    href: '/ratio/',
    quotes: [
      {
        text: 'Đời sống cộng đoàn tự bản thân nó là một giá trị Tin Mừng chính yếu, mời gọi chúng ta dấn thân trọn vẹn.',
        cite: '<em>Ratio Institutionis</em>, 42',
      },
      {
        text: 'Khi anh em bắt đầu yêu thương, là lúc Thiên Chúa bắt đầu ngự trong anh em.',
        cite: '<em>Ratio Institutionis</em>, 43',
      },
      {
        text: 'Xây dựng một cộng đoàn tốt lành có nghĩa là thực hành giới răn mến Chúa và yêu người.',
        cite: '<em>Ratio Institutionis</em>, 40',
      },
    ],
  },
  {
    key: 'confessions',
    label: 'Tự Thuật',
    href: '/tu-thuat/?book=quyen-1',
    quotes: [
      {
        text: 'Lạy Chúa, Chúa tạo dựng chúng con cho Chúa, và tâm hồn chúng con khắc khoải cho đến khi được nghỉ ngơi trong Chúa.',
        cite: 'Thánh Augustinô · <em>Tự Thuật</em>, I, 1',
      },
      {
        text: 'Căn nhà linh hồn con quá chật hẹp, để Chúa ngự đến: xin Chúa hãy làm cho nó rộng ra.',
        cite: 'Thánh Augustinô · <em>Tự Thuật</em>, I, 5',
      },
      {
        text: 'Con đã yêu mến Chúa quá muộn, ôi Đấng tốt đẹp rất cổ kính và rất tân kỳ! Con đã yêu mến Chúa quá muộn!',
        cite: 'Thánh Augustinô · <em>Tự Thuật</em>, X, 27',
      },
      {
        text: 'Ở đâu con tìm thấy chân lý, là ở đấy con tìm thấy Chúa con, là chính chân lý.',
        cite: 'Thánh Augustinô · <em>Tự Thuật</em>, X, 24',
      },
    ],
  },
];
---

<BaseLayout title={null} bodyClass="page-home no-sidebar" banner={null}>
  {false && (
  <Fragment>
  <div slot="full-bleed" class="og-banner og-slider">
    <img src={homeBanner.imageUrl} alt={homeBanner.altText ?? ''} class="og-slide active" loading="eager" />
    <header class="og-masthead">
      <div class="og-masthead-head">
        <div class="masthead-identity">
          <p class="og-eyebrow" data-oe-target="ph" data-oe="eyebrow" data-oe-html="true" set:html={ph.eyebrow}></p>
          <img src="/images/emblem.svg" alt="" class="og-masthead-emblem" aria-hidden="true" />
        </div>
        <h1 class="og-title" aria-label="Đồng Tâm Nhất Trí Hướng Về Thiên Chúa">
          <span class="home-title-line"><span class="home-title-word" style="--word-delay:0s">Đồng</span><span class="home-title-word" style="--word-delay:.09s">Tâm</span><span class="home-title-word" style="--word-delay:.18s">Nhất</span><span class="home-title-word" style="--word-delay:.27s">Trí</span></span>
          <span class="home-title-line"><span class="home-title-word" style="--word-delay:.4s">Hướng</span><span class="home-title-word" style="--word-delay:.49s">Về</span><span class="home-title-word" style="--word-delay:.58s">Thiên</span><span class="home-title-word" style="--word-delay:.67s">Chúa</span></span>
        </h1>
      </div>
    </header>
  </div>

  <main class="home-hub">
    <section class="home-gateways" aria-label="Gia đình Augustinô" data-reveal>
      <div class="home-gateway-grid">
        <a class="home-gateway home-gateway-augustine" href="/thanh-au-tinh/">
          <img src="/images/banners/banner-triet-hoc.jpg" alt="Thánh Augustinô thành Hippô" loading="lazy" />
          <span class="home-gateway-copy">
            <small>Tổ Phụ Dòng</small>
            <strong>Thánh Augustinô</strong>
            <em>Cuộc đời, tác phẩm và gia sản tư tưởng</em>
          </span>
        </a>
        <a class="home-gateway home-gateway-order" href="/lich-su-dong/">
          <img src="/images/on-goi/banner.avif" alt="Dòng Thánh Augustinô" loading="lazy" />
          <span class="home-gateway-copy">
            <small>Ordo Sancti Augustini</small>
            <strong>Dòng Thánh Augustinô</strong>
            <em>Lịch sử, đặc sủng và sứ vụ</em>
          </span>
        </a>
        <a class="home-gateway home-gateway-vocation" href="/on-goi/">
          <img src="/images/on-goi/demo-3.jpg" alt="Ơn gọi Augustinô" loading="lazy" />
          <span class="home-gateway-copy">
            <small>Đến Và Xem</small>
            <strong>Ơn Gọi Augustinô</strong>
            <em>Cùng sống, cùng tìm kiếm, cùng phục vụ</em>
            <span class="home-gateway-cta">Khám phá ơn gọi <i aria-hidden="true">→</i></span>
          </span>
        </a>
      </div>
    </section>

    <div class="home-daily-row">
      <section class="home-liturgy" aria-labelledby="home-liturgy-title" data-reveal>
      <div class="home-liturgy-date" aria-hidden="true">
        <strong id="homeTodayDay">—</strong>
        <span id="homeTodayMonth">Hôm nay</span>
      </div>
      <div class="home-liturgy-main">
        <div class="home-liturgy-heading">
          <div>
            <p class="home-kicker">Phụng Vụ Hôm Nay</p>
            <h2 id="home-liturgy-title">Hôm Nay Trong Hội Thánh</h2>
          </div>
          <div class="home-liturgy-legend" aria-label="Ký hiệu lịch phụng vụ">
            <span class="home-calendar-key home-calendar-key-general"><i aria-hidden="true"></i>Lịch Chung</span>
            <span class="home-calendar-key home-calendar-key-order"><i aria-hidden="true"></i>Lịch Nhà Dòng</span>
          </div>
        </div>
        <div class="home-liturgy-content" id="homeLiturgyContent" aria-live="polite">
          <p class="home-liturgy-loading">Đang tải lịch phụng vụ…</p>
        </div>
      </div>
      <div class="home-liturgy-actions">
        <a href="/lich-phung-vu/">Mở Lịch Phụng Vụ <span aria-hidden="true">→</span></a>
        <a href="/kinh-sach/">Bài Đọc Kinh Sách <span aria-hidden="true">→</span></a>
      </div>
      </section>

      <section class="home-daily-quotes bv-quotes" aria-labelledby="home-daily-title" data-home-daily-quotes data-reveal>
        <header class="idx-section-heading home-section-heading">
          <h2 id="home-daily-title">Lời Sống Mỗi Ngày</h2>
        </header>
        <div class="home-daily-grid">
          {dailyQuoteGroups.map((group, index) => (
            <a
              class:list={["home-daily-quote", "bvq-slide", index === 0 && "active"]}
              href={group.href}
              data-home-quote-group={group.key}
              data-home-daily-slide
              style={`--quote-order:${index}`}
            >
              <span class="home-daily-source"><small>0{index + 1}</small><b>{group.label}</b></span>
              <blockquote class="bvq-text" data-home-quote-text>{group.quotes[0].text}</blockquote>
              <cite class="bvq-cite" data-home-quote-cite set:html={group.quotes[0].cite}></cite>
              <span class="home-daily-open">Đọc tiếp <i aria-hidden="true">→</i></span>
            </a>
          ))}
        </div>
        <nav class="home-daily-dots bvq-dots" aria-label="Chọn nguồn trích dẫn">
          {dailyQuoteGroups.map((group, index) => (
            <button
              class:list={["bvq-dot", index === 0 && "active"]}
              type="button"
              data-home-daily-index={String(index)}
              aria-label={`Xem trích dẫn ${group.label}`}
              aria-pressed={index === 0 ? "true" : "false"}
            ></button>
          ))}
        </nav>
      </section>
    </div>

    {homeEditorialGroups.length > 0 && (
      <section class="home-editorial" aria-label="Bài viết mới" data-reveal>
        <CategoryArticleGallery
          groups={homeEditorialGroups}
          rowTitle="Bài Viết Mới"
          idPrefix="home-editorial"
          showTitles
          showAuthors
          showCategories
          showFilters={false}
          showAuthorFilters={false}
        />
        <nav class="home-editorial-links" aria-label="Các thư viện bài viết">
          <a href="/linh-dao/">Linh Đạo <span aria-hidden="true">→</span></a>
          <a href="/bai-viet/">Triết – Thần <span aria-hidden="true">→</span></a>
        </nav>
      </section>
    )}

    <section class="home-news" aria-labelledby="home-news-title" data-reveal>
      <header class="idx-section-heading home-section-heading">
        <h2 id="home-news-title">Tin Tức</h2>
        <a href="/tin-tuc/">Xem tất cả <span aria-hidden="true">→</span></a>
      </header>
      <div class="home-news-grid">
        <article class="home-news-source">
          <header>
            <span>Ordo Sancti Augustini</span>
            <h3>Trung Ương Dòng</h3>
          </header>
          <div class="home-news-frame-shell">
            <iframe
              class="home-news-frame"
              data-home-news-frame
              data-news-open-external
              data-news-base="/api/central-news.html"
              title="Tin tức Trung Ương Dòng"
              loading="lazy"
            ></iframe>
          </div>
          <a class="home-source-link" href="/tin-tuc/#journal-live-title">Mở nguồn tin <span aria-hidden="true">→</span></a>
        </article>

        <article class="home-news-source">
          <header>
            <span>Province of Australasia</span>
            <h3>Tỉnh Dòng</h3>
          </header>
          <div class="home-news-frame-shell">
            <iframe
              class="home-news-frame"
              data-home-news-frame
              data-news-open-external
              data-news-base="/api/province-news.html"
              title="Tin tức Tỉnh Dòng Úc Châu"
              loading="lazy"
            ></iframe>
          </div>
          <a class="home-source-link" href="/tin-tuc/#journal-province-title">Mở nguồn tin <span aria-hidden="true">→</span></a>
        </article>

        <article class="home-news-source home-community-news">
          <header>
            <span>OSA Việt Nam</span>
            <h3>Cộng Đoàn</h3>
          </header>
          <div class="home-news-frame-shell home-community-shell">
            <div class="home-community-list">
              {communityPosts.map((post, index) => (
                <ArticleCard
                  href={`/tin-tuc/${post.id}/`}
                  title={post.data.title}
                  category="Cộng Đoàn"
                  excerpt={post.data.excerpt}
                  date={post.data.date}
                  image={post.data.image ?? post.data.heroImage ?? communityImage(index)}
                />
              ))}
            </div>
          </div>
          <a class="home-source-link" href="/tin-tuc/">Xem sinh hoạt cộng đoàn <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </section>

  </main>
  </Fragment>
  )}

  <div
    slot="full-bleed"
    class="og-banner og-slider"
    data-banner-editor-container
    data-banner-key="home"
  >
    <button type="button" class="banner-inline-edit" data-banner-inline-edit hidden aria-label="Sửa banner trang chủ" title="Sửa banner trang chủ">✎</button>
    <div class="banner-variant home-banner-variant" data-vi="0" data-default>
      <img src={homeBanner.imageUrl} alt={homeBanner.altText ?? ''} class="og-slide active" loading="eager" />
    </div>
    <header class="og-masthead">
      <div class="og-masthead-head">
        <div class="masthead-identity">
          <p class="og-eyebrow" data-oe-target="ph" data-oe="eyebrow" data-oe-html="true" set:html={ph.eyebrow}></p>
          <img src="/images/emblem.svg" alt="" class="og-masthead-emblem" aria-hidden="true" />
        </div>
        <h1 class="og-title" aria-label={homeQuoteText} data-banner-field="quoteText" data-banner-vi="0">
          {homeQuoteLines.map((line, lineIndex) => (
            <span class="home-title-line">
              {line.map((word, wordIndex) => (
                <span
                  class="home-title-word"
                  style={`--word-delay:${((lineIndex * homeQuoteBreak + wordIndex) * .09).toFixed(2)}s`}
                >{word}</span>
              ))}
            </span>
          ))}
        </h1>
        {homeBanner.quoteCite && (
          <cite class="og-banner-cite" data-banner-field="quoteCite" data-banner-vi="0" set:html={homeBanner.quoteCite}></cite>
        )}
      </div>
    </header>
  </div>

  {false && (
  <main class="home-editorial">
    <section class="ed-today" aria-labelledby="ed-today-title">
      <header class="ed-today-head">
        <div>
          <p class="ed-kicker">Nhịp Sống Mỗi Ngày</p>
          <h2 id="ed-today-title">Hôm Nay</h2>
        </div>
        <time class="ed-date" aria-label="Ngày hôm nay">
          <strong id="homeTodayDay">—</strong>
          <span id="homeTodayMonth">Hôm nay</span>
        </time>
      </header>

      <div class="ed-today-grid">
        <article class="ed-liturgy" aria-labelledby="ed-liturgy-title">
          <header class="ed-column-head">
            <span aria-hidden="true">01</span>
            <div>
              <small>Phụng Vụ</small>
              <h3 id="ed-liturgy-title">Trong Hội Thánh</h3>
            </div>
          </header>
          <div class="ed-liturgy-content" id="homeLiturgyContent" aria-live="polite">
            <p>Đang tải lịch phụng vụ…</p>
          </div>
          <nav class="ed-links" aria-label="Liên kết phụng vụ">
            <a href="/lich-phung-vu/">Lịch Phụng Vụ <span aria-hidden="true">↗</span></a>
            <a href="/kinh-sach/">Bài Đọc Kinh Sách <span aria-hidden="true">↗</span></a>
          </nav>
        </article>

        <article class="ed-daily" aria-labelledby="ed-daily-title" data-home-daily-quotes>
          <header class="ed-column-head">
            <span aria-hidden="true">02</span>
            <div>
              <small>Trích Dẫn</small>
              <h3 id="ed-daily-title">Lời Sống</h3>
            </div>
          </header>
          <div class="ed-quote-stage">
            {dailyQuoteGroups.map((group, index) => (
              <a
                class:list={["ed-quote-slide", index === 0 && "active"]}
                href={group.href}
                data-home-quote-group={group.key}
                data-home-daily-slide
              >
                <span class="ed-quote-source">{group.label}</span>
                <blockquote data-home-quote-text>{group.quotes[0].text}</blockquote>
                <cite data-home-quote-cite set:html={group.quotes[0].cite}></cite>
                <span class="ed-read-link">Đọc bản văn <i aria-hidden="true">↗</i></span>
              </a>
            ))}
          </div>
          <nav class="ed-quote-tabs" aria-label="Chọn nguồn trích dẫn">
            {dailyQuoteGroups.map((group, index) => (
              <button
                class:list={[index === 0 && "active"]}
                type="button"
                data-home-daily-index={String(index)}
                aria-pressed={index === 0 ? "true" : "false"}
              >{group.label}</button>
            ))}
          </nav>
        </article>
      </div>
    </section>
  </main>
  )}

  {false && (
  <Fragment>
  <section slot="full-bleed" class="hm-hero" aria-labelledby="hm-hero-title">
    <img src={popeLeoBanner.src} alt="Cộng đoàn Dòng Thánh Augustinô" loading="eager" />
    <div class="hm-hero-shade" aria-hidden="true"></div>
    <div class="hm-hero-content">
      <p class="hm-eyebrow">Dòng Thánh Augustinô · Việt Nam</p>
      <h1 id="hm-hero-title">Đồng Tâm Nhất Trí<br /><span>Hướng Về Thiên Chúa</span></h1>
      <p class="hm-hero-lead">Cùng sống, cùng tìm kiếm chân lý và cùng phục vụ trong tình hiệp nhất.</p>
      <nav class="hm-hero-actions" aria-label="Lối vào chính">
        <a class="hm-button hm-button-primary" href="/on-goi/">Khám phá ơn gọi</a>
        <a class="hm-button hm-button-quiet" href="/lich-su-dong/">Tìm hiểu Hội Dòng <span aria-hidden="true">→</span></a>
      </nav>
    </div>
  </section>

  <main class="hm-main">
    <nav class="hm-portals" aria-label="Khám phá Dòng Thánh Augustinô">
      <a class="hm-portal" href="/thanh-au-tinh/">
        <img src="/images/banners/banner-triet-hoc.jpg" alt="Thánh Augustinô thành Hippô" loading="lazy" />
        <span class="hm-portal-overlay" aria-hidden="true"></span>
        <span class="hm-portal-copy">
          <small>Tổ Phụ Dòng</small>
          <strong>Thánh Augustinô</strong>
