            <p class="hm-label">Trích Dẫn Mỗi Ngày</p>
            <h2 id="home-daily-title">Lời Sống</h2>
          </div>
        </header>
        <div class="hm-quote-stage">
          {dailyQuoteGroups.map((group, index) => (
            <a
              class:list={["hm-quote", index === 0 && "active"]}
              href={group.href}
              data-home-quote-group={group.key}
              data-home-daily-slide
            >
              <span class="hm-quote-source">{group.label}</span>
              <blockquote data-home-quote-text>{group.quotes[0].text}</blockquote>
              <cite data-home-quote-cite set:html={group.quotes[0].cite}></cite>
              <span class="hm-quote-link">Đọc bản văn <i aria-hidden="true">→</i></span>
