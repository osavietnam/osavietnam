          ))}
        </div>
        <nav class="hm-quote-dots" aria-label="Chọn nguồn trích dẫn">
          {dailyQuoteGroups.map((group, index) => (
            <button
              class:list={["hm-quote-dot", index === 0 && "active"]}
              type="button"
              data-home-daily-index={String(index)}
