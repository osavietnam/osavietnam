---
import { getCollection } from 'astro:content';
import lifeIndex from '../data/augnet-life-index.json';
import worksIndex from '../data/augnet-works-index.json';
import historyIndex from '../data/augnet-history-index.json';
import communityIndex from '../data/augnet-community-index.json';

interface Props {
  kind?: 'life' | 'works' | 'history' | 'community';
}

const { kind = 'life' } = Astro.props;
const isWorks = kind === 'works';
const isHistory = kind === 'history';
const isCommunity = kind === 'community';
const entries = isCommunity
  ? await getCollection('augnet-community', ({ data }) => !data.draft)
  : isHistory
  ? await getCollection('augnet-history', ({ data }) => !data.draft)
  : isWorks
    ? await getCollection('augustine-works', ({ data }) => !data.draft)
    : await getCollection('augustine-life', ({ data }) => !data.draft);
const entryByCode = new Map(entries.map((entry) => [entry.data.code, entry]));
const entryBySourceUrl = new Map(entries.map((entry) => [entry.data.sourceUrl, entry]));
const lifeCategoryVi: Record<string, string> = {
  'growing-up': 'Thời Niên Thiếu',
  'in-italy': 'Những Năm Tháng tại Ý',
  'in-africa-again': 'Trở Về Châu Phi',
  'augustine-in-general': 'Tổng Quan về Thánh Augustinô',
  'his-era': 'Thời Đại của Ngài',
};

const indexData = (isCommunity ? communityIndex : isHistory ? historyIndex : isWorks ? worksIndex : lifeIndex) as typeof lifeIndex | typeof worksIndex | typeof historyIndex | typeof communityIndex;
const categories = indexData.categories.map((category: any) => ({
  ...category,
  categoryVi: category.categoryVi ?? lifeCategoryVi[category.categorySlug] ?? category.category,
  entries: category.entries.map((item: any) => {
    const contentEntry = entryBySourceUrl.get(item.url) ?? entryByCode.get(item.code);
    const slug = contentEntry?.id.split('/').at(-1) ?? item.url.split('/').filter(Boolean).at(-1) ?? item.code;
    return {
      ...item,
      slug,
      status: contentEntry?.data.translationStatus ?? 'placeholder',
      titleVi: contentEntry?.data.titleVi ?? '',
    };
  }),
}));

const statusLabel: Record<string, string> = {
  placeholder: 'Chưa dịch',
  draft: 'Đang dịch',
  translated: 'Đã dịch',
};
const libraryId = isCommunity ? 'thu-vien-linh-dao-augnet' : isHistory ? 'thu-vien-lich-su-augnet' : isWorks ? 'thu-vien-tac-pham' : 'thu-vien-tieu-su';
const headingId = isCommunity ? 'aug-community-title' : isHistory ? 'aug-history-title' : isWorks ? 'aug-works-title' : 'aug-life-title';
const eyebrow = isCommunity ? 'Augustinian Way of Life' : isHistory ? 'History of the Augustinian Order' : isWorks ? 'Works of Augustine' : 'Life of Augustine';
const heading = isCommunity ? 'Linh Đạo - Augnet' : isHistory ? 'Lịch Sử Dòng Thánh Augustinô - Augnet' : isWorks ? 'Tác Phẩm và Tư Tưởng Thánh Augustinô - Augnet' : 'Cuộc Đời Thánh Augustinô - Augnet';
const routeBase = isCommunity ? '/linh-dao/augnet' : isHistory ? '/lich-su-dong/augnet' : isWorks ? '/thanh-au-tinh/tac-pham' : '/thanh-au-tinh/tieu-su';
const categoryAria = isCommunity ? 'Chủ đề linh đạo cộng đoàn' : isHistory ? 'Chủ đề lịch sử Dòng' : isWorks ? 'Chủ đề tác phẩm và tư tưởng' : 'Chủ đề tiểu sử';
---

<a
  class="augnet-edge-bookmark"
  href={`#${libraryId}`}
  aria-label={`Đến thư viện ${heading}`}
  title={`Đến thư viện ${heading}`}
>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.5h11v17l-5.5-3.4-5.5 3.4v-17Z" /></svg>
  <span>Augnet</span>
</a>
{isCommunity && (
  <a
    class="augnet-edge-bookmark readings-edge-bookmark"
    href="/kinh-sach/?category=__all__&augustin=1"
    aria-label="Đến Bài đọc Kinh Sách của Thánh Augustinô"
    title="Bài đọc Kinh Sách của Thánh Augustinô"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 4.5h5.2c1.1 0 1.8.35 1.8 1.2v13.8c0-.85-.7-1.2-1.8-1.2H5V4.5Zm14 0h-5.2c-1.1 0-1.8.35-1.8 1.2v13.8c0-.85.7-1.2 1.8-1.2H19V4.5Z" />
    </svg>
    <span>Kinh Sách</span>
  </a>
)}

<section class="aug-life-library" id={libraryId} aria-labelledby={headingId} data-augnet-kind={kind}>
  <header class="aug-life-heading lib-masthead">
    <p class="lib-masthead-sub">{eyebrow}</p>
    <h2 class="lib-masthead-title" id={headingId}>{heading}</h2>
    <div class="lib-masthead-rule" aria-hidden="true"><span class="lib-masthead-ornament">✦</span></div>
  </header>

  <div class="aug-life-tools">
    <label class="aug-life-search">
      <span class="sr-only">Tìm bài theo mã hoặc tiêu đề</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" /></svg>
      <input class="aug-life-search-input" type="search" placeholder="Tìm mã hoặc tiêu đề…" autocomplete="off" />
    </label>

    <label class="aug-life-mobile-filter">
      <span class="sr-only">Lọc theo chủ đề</span>
      <select class="aug-life-category-select">
        <option value="all">Tất cả chủ đề</option>
        {categories.map((category) => <option value={category.categorySlug}>{category.categoryVi}</option>)}
      </select>
    </label>
  </div>

  <div class="aug-life-layout">
    <nav class="aug-life-categories" aria-label={categoryAria}>
      <button type="button" class="is-active" data-life-category="all" aria-pressed="true">
        <span>Tất cả</span><small>{indexData.entryCount}</small>
      </button>
      {categories.map((category) => (
        <button type="button" data-life-category={category.categorySlug} aria-pressed="false">
          <span>{category.categoryVi}</span><small>{category.entries.length}</small>
        </button>
      ))}
    </nav>

    <div class="aug-life-results">
      {categories.map((category) => (
        <section class="aug-life-group" data-life-group={category.categorySlug}>
          <header>
            <h3>{category.categoryVi}</h3>
          </header>
          <div class="aug-life-list">
            {category.entries.map((item) => (
              <a
                class="aug-life-item"
                href={`${routeBase}/${item.slug}/`}
                data-life-item
                data-code={item.code}
                data-title={`${item.title} ${item.titleVi}`.trim()}
                data-category={category.categorySlug}
              >
                <span class="aug-life-code">{item.code}</span>
                <span class="aug-life-item-copy">
                  <strong>{item.titleVi || item.title}</strong>
                  {item.titleVi && <small lang="en">{item.title}</small>}
                  {isWorks && item.sectionVi && <small>{item.sectionVi}</small>}
                </span>
                <span class={`aug-life-status is-${item.status}`}>{statusLabel[item.status] ?? item.status}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
              </a>
            ))}
          </div>
        </section>
      ))}

      <div class="aug-life-empty" hidden>
        <strong>Không tìm thấy bài phù hợp</strong>
        <span>Thử nhập mã bài hoặc một phần tiêu đề tiếng Anh.</span>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.aug-life-library').forEach((library) => {
    if (library.dataset.augnetReady === 'true') return;
    library.dataset.augnetReady = 'true';
    const search = library.querySelector<HTMLInputElement>('.aug-life-search-input');
    const select = library.querySelector<HTMLSelectElement>('.aug-life-category-select');
    const buttons = Array.from(library.querySelectorAll<HTMLButtonElement>('[data-life-category]'));
    const groups = Array.from(library.querySelectorAll<HTMLElement>('[data-life-group]'));
    const items = Array.from(library.querySelectorAll<HTMLElement>('[data-life-item]'));
    const empty = library.querySelector<HTMLElement>('.aug-life-empty');
    let activeCategory = 'all';

    const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('vi').trim();

    const filterLibrary = () => {
      const query = normalize(search?.value ?? '');
      let visibleCount = 0;

      items.forEach((item) => {
        const inCategory = activeCategory === 'all' || item.dataset.category === activeCategory;
        const searchable = normalize(`${item.dataset.code ?? ''} ${item.dataset.title ?? ''}`);
        const visible = inCategory && (!query || searchable.includes(query));
        item.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      groups.forEach((group) => {
        const hasVisibleItems = Array.from(group.querySelectorAll<HTMLElement>('[data-life-item]')).some((item) => !item.hidden);
        group.hidden = !hasVisibleItems;
      });

      if (empty) empty.hidden = visibleCount !== 0;
    };

    const scrollResultsToStart = () => {
      const results = library.querySelector<HTMLElement>('.aug-life-results');
      if (!results) return;

      const stickyBars = Array.from(document.querySelectorAll<HTMLElement>('.navbar, .shared-tab-bar, .lsd-tab-bar'));
      const stickyHeight = stickyBars.reduce((total, bar) => {
        const style = getComputedStyle(bar);
        if (style.display === 'none' || style.visibility === 'hidden' || bar.getBoundingClientRect().height === 0) return total;
        return total + bar.getBoundingClientRect().height;
      }, 0);
      const breathingRoom = 16;
      const top = window.scrollY + results.getBoundingClientRect().top - stickyHeight - breathingRoom;
      window.scrollTo({ top: Math.max(0, top), behavior: 'auto' });
    };

    const setCategory = (category: string, jumpToResults = false) => {
      activeCategory = category;
      buttons.forEach((button) => {
        const active = button.dataset.lifeCategory === category;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      if (select) select.value = category;
      filterLibrary();
      if (jumpToResults) requestAnimationFrame(scrollResultsToStart);
    };

    buttons.forEach((button) => button.addEventListener('click', () => setCategory(button.dataset.lifeCategory ?? 'all', true)));
    select?.addEventListener('change', () => setCategory(select.value, true));
    search?.addEventListener('input', filterLibrary);
  });
</script>

<style>
  .aug-life-library {
    width: min(112rem, calc(100% - 3rem));
    margin: 5.4rem auto 2rem;
    padding-top: 3.2rem;
    overflow-anchor: none;
    scroll-margin-top: 9rem;
  }
  .aug-life-heading .lib-masthead-title {
    font-size: clamp(2.8rem, 3.2vw, 4.2rem);
    line-height: 1.18;
  }
  .augnet-edge-bookmark {
    position: fixed;
    top: 46%;
    right: 0;
    z-index: 55;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    width: 4.1rem;
    min-height: 9.6rem;
    padding: .85rem .6rem;
    border: 1px solid rgba(218,195,143,.32);
    border-right: 0;
    border-radius: .75rem 0 0 .75rem;
    background: #253047;
    color: #dfc789;
    box-shadow: none;
    text-decoration: none;
    transform: translateY(-50%);
    transition: color .18s ease, background-color .18s ease, width .18s ease;
  }
  .augnet-edge-bookmark svg {
    width: 1.65rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
  }
  .augnet-edge-bookmark span {
    font: 650 .92rem/1 var(--font-ui);
    letter-spacing: .12em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }
  .augnet-edge-bookmark:hover {
    width: 4.5rem;
    color: #f1d99d;
    background: #2d3950;
  }
  .augnet-edge-bookmark:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .readings-edge-bookmark {
    top:calc(46% + 10.5rem);
  }
  .aug-life-tools { display:flex; justify-content:flex-end; margin-bottom:1.8rem; }
  .aug-life-search { display:flex; align-items:center; width:min(100%, 38rem); min-height:4.4rem; padding:0 1.25rem; border:1px solid rgba(201,191,169,.2); border-radius:.7rem; background:rgba(255,255,255,.025); }
  .aug-life-search:focus-within { border-color:rgba(233,193,118,.66); box-shadow:0 0 0 3px rgba(233,193,118,.09); }
  .aug-life-search svg { width:1.75rem; fill:none; stroke:#c7ae78; stroke-width:1.7; }
  .aug-life-search input { width:100%; min-width:0; padding:.9rem .8rem; border:0; outline:0; background:transparent; color:#d8d4ca; font:500 1.32rem var(--font-ui); }
  .aug-life-search input::placeholder { color:rgba(181,187,183,.58); }
  .aug-life-mobile-filter { display:none; }
  .aug-life-layout { display:grid; grid-template-columns:22rem minmax(0, 1fr); gap:3rem; align-items:start; }
  .aug-life-results {
    min-height: calc(100vh - 13rem);
    min-height: calc(100svh - 13rem);
  }
  .aug-life-categories { position:sticky; top:8.6rem; display:grid; gap:.35rem; }
  .aug-life-categories button { display:flex; align-items:center; justify-content:space-between; gap:1rem; width:100%; padding:.9rem 1rem; border:0; border-radius:.45rem; background:transparent; color:#aeb5b0; cursor:pointer; text-align:left; font:600 1.18rem/1.35 var(--font-ui); transition:background .18s, color .18s; }
  .aug-life-categories button:hover { color:#ddd8cd; background:rgba(201,191,169,.055); }
  .aug-life-categories button.is-active { color:#dcc58f; background:rgba(201,191,169,.09); }
  .aug-life-categories small { min-width:2rem; color:inherit; font-size:.98rem; text-align:right; opacity:.72; }
  .aug-life-group:not([hidden]) ~ .aug-life-group:not([hidden]) { margin-top:2.8rem; }
  .aug-life-group > header { display:flex; align-items:baseline; justify-content:space-between; gap:1rem; margin-bottom:.8rem; }
  .aug-life-group h3 {
    margin:0;
    color:var(--gold);
    font:600 1.75rem/1.3 var(--font-display);
    text-transform:uppercase;
  }
  .aug-life-list { overflow:hidden; border-top:1px solid rgba(233,193,118,.16); }
  .aug-life-item { display:grid; grid-template-columns:5.6rem minmax(0, 1fr) auto 1.8rem; align-items:center; gap:1.2rem; min-height:5.5rem; padding:.8rem .8rem; border-bottom:1px solid rgba(233,193,118,.12); color:inherit; text-decoration:none; transition:background .18s, transform .18s; }
  .aug-life-item:hover { background:rgba(233,193,118,.065); }
  .aug-life-item:focus-visible { outline:2px solid var(--gold); outline-offset:-2px; }
  .aug-life-code { color:#c9ae70; font:700 1.12rem/1 var(--font-ui); letter-spacing:.08em; font-variant-numeric:tabular-nums; }
  .aug-life-item-copy { display:grid; gap:.25rem; min-width:0; }
  .aug-life-item-copy strong { overflow:hidden; color:#d9d5cc; font:500 1.48rem/1.4 var(--font-ui); text-overflow:ellipsis; white-space:nowrap; }
  .aug-life-item-copy small { overflow:hidden; color:#929e9e; font:400 1.05rem/1.35 var(--font-ui); text-overflow:ellipsis; white-space:nowrap; }
  .aug-life-status { padding:.35rem .6rem; border-radius:999px; color:#fff; background:#5f5a53; font:500 .88rem/1 var(--font-ui); white-space:nowrap; }
  .aug-life-status.is-draft { color:#fff; background:#80601d; }
  .aug-life-status.is-translated { color:#fff; background:#2f704f; }
  .aug-life-item > svg { width:1.6rem; fill:none; stroke:rgba(233,193,118,.55); stroke-width:1.7; transition:transform .18s, stroke .18s; }
  .aug-life-item:hover > svg { stroke:var(--gold); transform:translateX(.2rem); }
  .aug-life-empty { padding:4rem 1rem; text-align:center; }
  .aug-life-empty strong, .aug-life-empty span { display:block; }
  .aug-life-empty strong { color:var(--ink-cream); font:600 1.7rem var(--font-display); }
  .aug-life-empty span { margin-top:.5rem; color:var(--ink-cream-soft); font:400 1.2rem var(--font-ui); }
  .aug-life-group[hidden], .aug-life-item[hidden], .aug-life-empty[hidden] { display:none !important; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }

  :global([data-theme="light"]) .aug-life-group h3,
  :global([data-theme="light"]) .aug-life-item-copy strong,
  :global([data-theme="light"]) .aug-life-empty strong { color:var(--accent); }
  :global([data-theme="light"]) .aug-life-code { color:#9c6a2e; }
  :global([data-theme="light"]) .aug-life-item-copy small,
  :global([data-theme="light"]) .aug-life-empty span { color:#5d665d; }
  :global([data-theme="light"]) .aug-life-search { border-color:rgba(26,94,60,.24); background:rgba(255,255,255,.48); }
  :global([data-theme="light"]) .aug-life-search:focus-within { border-color:#2d7057; box-shadow:0 0 0 3px rgba(45,112,87,.09); }
  :global([data-theme="light"]) .aug-life-search svg { stroke:#2d7057; }
  :global([data-theme="light"]) .aug-life-search input { color:var(--accent); }
  :global([data-theme="light"]) .aug-life-categories button { color:#4f6459; }
  :global([data-theme="light"]) .aug-life-categories button:hover { color:var(--accent); background:rgba(26,94,60,.055); }
  :global([data-theme="light"]) .aug-life-categories button.is-active { color:#1a5e3c; background:rgba(26,94,60,.1); }
  :global([data-theme="light"]) .aug-life-list { border-top-color:rgba(26,94,60,.16); }
  :global([data-theme="light"]) .aug-life-item { border-bottom-color:rgba(26,94,60,.11); }
  :global([data-theme="light"]) .aug-life-item:hover { background:rgba(26,94,60,.055); }
  :global([data-theme="light"]) .aug-life-status { color:#fff; background:#5f5a53; }
  :global([data-theme="light"]) .aug-life-status.is-draft { color:#fff; background:#80601d; }
  :global([data-theme="light"]) .aug-life-status.is-translated { color:#fff; background:#2f704f; }
  :global([data-theme="light"]) .augnet-edge-bookmark {
    border-color: rgba(26,94,60,.28);
    background: #e4ece6;
    color: #1d6245;
  }
  :global([data-theme="light"]) .augnet-edge-bookmark:hover {
    background: #d8e5dc;
    color: #124c34;
  }

  @media (max-width: 760px) {
    .aug-life-library { width:100%; margin-top:3.8rem; padding-top:2.4rem; }
    .aug-life-heading .lib-masthead-title { font-size:clamp(2.35rem, 8vw, 3.2rem); }
    .augnet-edge-bookmark {
      top:auto;
      bottom:8.2rem;
      width:3.65rem;
      min-height:7.8rem;
      padding:.7rem .5rem;
    }
    .augnet-edge-bookmark:hover { width:3.9rem; }
    .augnet-edge-bookmark svg { width:1.45rem; }
    .augnet-edge-bookmark span { font-size:.8rem; }
    .readings-edge-bookmark { bottom:16.6rem; }
    .aug-life-tools { display:grid; grid-template-columns:minmax(0, 1fr) auto; gap:.7rem; }
    .aug-life-search { width:auto; min-height:4.1rem; padding:0 .85rem; }
    .aug-life-search input { font-size:1.18rem; }
    .aug-life-mobile-filter { display:block; }
    .aug-life-mobile-filter select { width:4.4rem; height:4.1rem; padding:0 1rem; border:1px solid rgba(233,193,118,.24); border-radius:.7rem; background:var(--bg-main); color:var(--gold); font:600 1.1rem var(--font-ui); text-indent:-9999px; cursor:pointer; }
    .aug-life-mobile-filter { position:relative; }
    .aug-life-mobile-filter::after { content:'☰'; position:absolute; inset:0; display:grid; place-items:center; color:var(--gold); font-size:1.3rem; pointer-events:none; }
    :global([data-theme="light"]) .aug-life-mobile-filter select { border-color:rgba(26,94,60,.24); background:#f4efe5; }
    :global([data-theme="light"]) .aug-life-mobile-filter::after { color:#1a5e3c; }
    .aug-life-layout { display:block; }
    .aug-life-categories { display:none; }
    .aug-life-group:not([hidden]) ~ .aug-life-group:not([hidden]) { margin-top:2.2rem; }
    .aug-life-group h3 { font-size:1.55rem; }
    .aug-life-item { grid-template-columns:4.5rem minmax(0, 1fr) 1.5rem; gap:.65rem; min-height:5.3rem; padding:.75rem .25rem; }
    .aug-life-code { font-size:1rem; }
    .aug-life-item-copy strong { font-size:1.28rem; }
    .aug-life-item-copy small { font-size:.95rem; }
    .aug-life-status { display:none; }
    .aug-life-item > svg { width:1.45rem; }
  }
</style>
