        if (imageAlt) imageAlt.value = '';
        if (imageCaption) imageCaption.value = '';
        imageBuilder?.querySelector<HTMLElement>('[data-article-image-picker]')
          ?.dispatchEvent(new CustomEvent('article-image:refresh'));
        closeImageBuilder();
      });
      formatbar.addEventListener('mousedown', (event) => event.preventDefault());
      formatbar.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
