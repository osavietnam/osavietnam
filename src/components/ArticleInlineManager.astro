nager-taxonomy-add button{color:#102118;background:#e9c176;border-color:#e9c176}.article-manager-taxonomy-message{min-height:1.4em;margin:.85rem 0 0;color:#cfc6b4;font:500 .86rem/1.4 var(--font-ui)}.article-manager-taxonomy-message.is-error{color:#ff9f91}
