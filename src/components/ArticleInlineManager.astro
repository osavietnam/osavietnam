---
import InlineProseEditor from './InlineProseEditor.astro';
import ArticleImagePicker from './ArticleImagePicker.astro';

interface Props {
  kind: 'news' | 'scholar' | 'spirituality' | 'sermon';
}

const { kind } = Astro.props;
const labels = {
  news: 'Tin tức',
  scholar: 'Triết – Thần',
  spirituality: 'Linh đạo',
  sermon: 'Bài giảng – Suy niệm',
};
---

<div class="article-inline-manager" data-article-manager-root data-kind={kind}>
  <button type="button" class="article-manager-trigger" aria-label={`Quản lý bài viết ${labels[kind]}`} title={`Quản lý bài viết ${labels[kind]}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5h16M6.5 16.5 17 6l1.5 1.5L8 18H6.5v-1.5Z"/><path d="m15.5 7.5 1 1"/></svg>
    <span>Quản lý bài viết</span>
  </button>

  <dialog class="article-manager-dialog" aria-labelledby={`article-manager-title-${kind}`}>
    <div class="article-manager-shell">
      <header class="article-manager-head">
        <div>
          <small>Biên tập trực tiếp · {labels[kind]}</small>
          <h2 id={`article-manager-title-${kind}`}>Bài viết</h2>
        </div>
        <div class="article-manager-head-actions">
          <button type="button" class="article-manager-categories">Chuyên mục</button>
          <button type="button" class="article-manager-new">+ Thêm bài</button>
          <button type="button" class="article-manager-close" aria-label="Đóng">×</button>
        </div>
      </header>

      <div class="article-manager-workspace">
        <aside class="article-manager-index">
          <div class="article-manager-search-deck">
            <label class="article-manager-search">
              <span class="sr-only">Tìm bài viết</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/></svg>
              <input type="search" placeholder="Tìm bài viết…" autocomplete="off" />
            </label>
            <label class="article-manager-category-filter-label">
              <span class="sr-only">Lọc theo chuyên mục</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
              <select class="article-manager-category-filter" aria-label="Lọc theo chuyên mục">
                <option value="">Tất cả</option>
              </select>
            </label>
          </div>
          <div class="article-manager-list" role="list"></div>
          <p class="article-manager-empty" hidden>Chưa có bài viết phù hợp.</p>
        </aside>

        <form class="article-manager-form">
          <div class="article-manager-form-empty">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h14v15H5zM8 8h8M8 12h8M8 16h5"/></svg>
            <strong>Chọn một bài để biên tập</strong>
            <span>Hoặc tạo bài mới ngay trên trang này.</span>
          </div>

          <div class="article-manager-fields" hidden>
            <div class="article-manager-idline article-manager-full">
              <label><span>Slug</span><input data-field="slug" type="text" required pattern="[a-z0-9-]+" /></label>
              <code data-article-path></code>
            </div>
            <label><span>Ngôn ngữ</span><select data-field="language"><option value="vi">Tiếng Việt</option><option value="en">English</option></select></label>
            <label data-translation-field hidden><span>Bản chính</span><input data-field="translationOf" type="text" readonly /></label>
            <label class="article-manager-full"><span>Tiêu đề</span><input data-field="title" type="text" required /></label>
            <label class="article-manager-full"><span>Phụ đề</span><input data-field="subtitle" type="text" /></label>
            <label><span>Tác giả</span><input data-field="author" type="text" /></label>
            <label><span>Ngày đăng</span><input data-field="date" type="date" /></label>
            <label><span>Chuyên mục</span><select data-field="category" required></select></label>
            <label data-subcategory-field><span>Chuyên mục con</span><select data-field="subcategory"></select></label>
            <label class="article-manager-full"><span>Mô tả ngắn</span><textarea data-field="excerpt" rows="3"></textarea></label>
            <label class="article-manager-full"><span>Thông tin tác giả <small>mỗi dòng một mục</small></span><textarea data-field="authorDetails" rows="3"></textarea></label>
            <label class="article-manager-full"><span>Từ khóa <small>mỗi dòng một từ khóa</small></span><textarea data-field="tags" rows="3"></textarea></label>
            <ArticleImagePicker dataField="image" label="Ảnh thumbnail" />
            <ArticleImagePicker dataField="heroImage" label="Ảnh hero" />
            <div class="article-manager-checks article-manager-full">
              <label><input data-field="featured" type="checkbox" /><span>{kind === 'news' ? 'Hiển thị trên banner' : 'Bài nổi bật'}</span></label>
              <label><input data-field="draft" type="checkbox" /><span>Chỉ hiển thị trong admin</span></label>
            </div>
            <div class="article-manager-full">
              <InlineProseEditor dataField="body" label="Nội dung bài viết" />
            </div>
          </div>

          <footer class="article-manager-footer" hidden>
            <p class="article-manager-message" role="status"></p>
            <button type="button" class="article-manager-translation" hidden>+ Bản EN</button>
            <a class="article-manager-open" href="#" target="_blank" rel="noopener" hidden>Mở trang ↗</a>
            <button type="button" class="article-manager-delete">Xóa bài</button>
            <button type="submit" class="article-manager-save">Lưu bài viết</button>
          </footer>
        </form>

        <section class="article-manager-taxonomy" hidden aria-label="Quản lý chuyên mục">
          <header>
            <div><small>Dùng chung trên trang công khai và Admin</small><h3>Chuyên mục</h3></div>
            <button type="button" class="article-manager-taxonomy-back">Quay lại bài viết</button>
          </header>
          <div class="article-manager-taxonomy-list"></div>
          <form class="article-manager-taxonomy-add">
            <label><span>Tên chuyên mục mới</span><input type="text" required /></label>
            <button type="submit">+ Thêm chuyên mục</button>
          </form>
          <p class="article-manager-taxonomy-message" role="status"></p>
        </section>
      </div>
    </div>
  </dialog>
</div>

<script>
  type StudioItem = {
    id: string;
    title: string;
    category?: string;
    subtitle?: string;
    draft?: boolean;
    status?: string;
    route?: string;
    updatedAt?: string;
    language?: 'vi' | 'en';
    translationOf?: string;
    featured?: boolean;
  };
  type StudioEntry = {
    id: string;
    fm: Record<string, unknown>;
    body: string;
    extension: string;
    checksum: string;
    route?: string;
  };
  type ProseRoot = HTMLElement & { inlineProseController?: { setMarkdown: (value?: string) => void; getMarkdown: () => string } };
  type TaxonomyCategory = { label: string; folder: string; tone?: string; subcategories?: string[] };

  const articleManagerConfigs = {
    news: {
      folders: ['sinh-hoat-cong-doan'],
      categories: [
        { value: 'Cộng Đoàn', folder: 'sinh-hoat-cong-doan', subs: [] },
        { value: 'Dòng', folder: 'sinh-hoat-cong-doan', subs: [] },
        { value: 'Giáo Hội', folder: 'sinh-hoat-cong-doan', subs: [] },
        { value: 'Giáo Phận', folder: 'sinh-hoat-cong-doan', subs: [] },
      ],
    },
    scholar: {
      folders: ['triet-hoc', 'than-hoc'],
      categories: [
        { value: 'Triết Học', folder: 'triet-hoc', subs: ['Tri Luận', 'Siêu Hình Học', 'Đạo Đức', 'Nhân Học'] },
        { value: 'Thần Học', folder: 'than-hoc', subs: ['Kinh Thánh', 'Thần Học Nền Tảng', 'Luân Lý Kitô Giáo', 'Giáo Hội Học', 'Kitô Học'] },
      ],
    },
    spirituality: {
      folders: ['linh-dao'],
      categories: [
        { value: 'Chung', folder: 'linh-dao', subs: [] },
        { value: 'Chú Giải Thánh Vịnh', folder: 'linh-dao', subs: [] },
        { value: 'Bài Giảng', folder: 'linh-dao', subs: [] },
      ],
    },
    sermon: {
      folders: ['bai-giang-suy-niem'],
      categories: [
        { value: 'Mùa Vọng', folder: 'bai-giang-suy-niem', subs: [] },
        { value: 'Mùa Giáng Sinh', folder: 'bai-giang-suy-niem', subs: [] },
        { value: 'Mùa Chay', folder: 'bai-giang-suy-niem', subs: [] },
        { value: 'Mùa Phục Sinh', folder: 'bai-giang-suy-niem', subs: [] },
        { value: 'Mùa Thường Niên', folder: 'bai-giang-suy-niem', subs: [] },
        { value: 'Lễ Trọng', folder: 'bai-giang-suy-niem', subs: [] },
        { value: 'Lễ Kính', folder: 'bai-giang-suy-niem', subs: [] },
        { value: 'Lễ Nhớ', folder: 'bai-giang-suy-niem', subs: [] },
      ],
    },
  } as const;

  const initArticleManagers = () => {
    document.querySelectorAll<HTMLElement>('[data-article-manager-root]:not([data-article-manager-ready])').forEach((root) => {
      root.dataset.articleManagerReady = 'true';
      const ADMIN = `${window.location.protocol}//${window.location.hostname}:4322`;
      const kind = (root.dataset.kind || 'news') as keyof typeof articleManagerConfigs;
      const fallbackConfig = articleManagerConfigs[kind];
      let categories: TaxonomyCategory[] = fallbackConfig.categories.map((category) => ({
        label: category.value,
        folder: category.folder,
        subcategories: [...category.subs],
      }));
      const trigger = root.querySelector<HTMLButtonElement>('.article-manager-trigger');
      const dialog = root.querySelector<HTMLDialogElement>('.article-manager-dialog');
      const closeButton = root.querySelector<HTMLButtonElement>('.article-manager-close');
      const newButton = root.querySelector<HTMLButtonElement>('.article-manager-new');
      const categoriesButton = root.querySelector<HTMLButtonElement>('.article-manager-categories');
      const search = root.querySelector<HTMLInputElement>('.article-manager-search input');
      const categoryFilter = root.querySelector<HTMLSelectElement>('.article-manager-category-filter');
      const list = root.querySelector<HTMLElement>('.article-manager-list');
      const empty = root.querySelector<HTMLElement>('.article-manager-empty');
      const form = root.querySelector<HTMLFormElement>('.article-manager-form');
      const formEmpty = root.querySelector<HTMLElement>('.article-manager-form-empty');
      const fieldsWrap = root.querySelector<HTMLElement>('.article-manager-fields');
      const footer = root.querySelector<HTMLElement>('.article-manager-footer');
      const message = root.querySelector<HTMLElement>('.article-manager-message');
      const saveButton = root.querySelector<HTMLButtonElement>('.article-manager-save');
      const deleteButton = root.querySelector<HTMLButtonElement>('.article-manager-delete');
      const openLink = root.querySelector<HTMLAnchorElement>('.article-manager-open');
      const pathLabel = root.querySelector<HTMLElement>('[data-article-path]');
      const subcategoryField = root.querySelector<HTMLElement>('[data-subcategory-field]');
      const proseRoot = root.querySelector<ProseRoot>('[data-inline-prose-editor]');
      const translationField = root.querySelector<HTMLElement>('[data-translation-field]');
      const translationButton = root.querySelector<HTMLButtonElement>('.article-manager-translation');
      const workspace = root.querySelector<HTMLElement>('.article-manager-workspace');
      const taxonomyPanel = root.querySelector<HTMLElement>('.article-manager-taxonomy');
      const taxonomyList = root.querySelector<HTMLElement>('.article-manager-taxonomy-list');
      const taxonomyBack = root.querySelector<HTMLButtonElement>('.article-manager-taxonomy-back');
      const taxonomyAdd = root.querySelector<HTMLFormElement>('.article-manager-taxonomy-add');
      const taxonomyInput = taxonomyAdd?.querySelector<HTMLInputElement>('input');
      const taxonomyMessage = root.querySelector<HTMLElement>('.article-manager-taxonomy-message');
      const field = <T extends HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(name: string) => root.querySelector<T>(`[data-field="${name}"]`);
      let items: StudioItem[] = [];
      let active: StudioEntry | null = null;
      let isNew = false;
      let taxonomyReloadTimer = 0;

      if (!trigger || !dialog || !form || !list || !message || !saveButton || !deleteButton) {
        root.remove();
        return;
      }

      const request = async (path: string, options?: RequestInit) => {
        const response = await fetch(ADMIN + path, options);
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || `HTTP ${response.status}`);
        return data;
      };
      const setMessage = (value = '', error = false) => {
        message.textContent = value;
        message.classList.toggle('is-error', error);
      };
      const setValue = (name: string, value: unknown) => {
        const input = field(name);
        if (input) input.value = value == null ? '' : String(value);
      };
      const setListValue = (name: string, value: unknown) => setValue(name, Array.isArray(value) ? value.join('\n') : '');
      const read = (name: string) => field(name)?.value.trim() || '';
      const readList = (name: string) => read(name).split(/\r?\n/).map((value) => value.trim()).filter(Boolean);
      const imageValue = (value: unknown) => {
        if (typeof value === 'string') return value;
        if (value && typeof value === 'object' && 'src' in value) return String((value as { src?: string }).src || '');
        return '';
      };
      const slugify = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
      const categoryConfig = (value = read('category')) => categories.find((category) => category.label === value) ?? categories[0];
      const currentFolder = () => {
        const translationOf = read('translationOf');
        if (read('language') === 'en' && translationOf.includes('/')) return translationOf.split('/').slice(0, -1).join('/');
        if (!isNew && active?.id.includes('/')) return active.id.split('/').slice(0, -1).join('/');
        return categoryConfig()?.folder ?? fallbackConfig.folders[0];
      };
      const currentId = () => `${currentFolder()}/${read('slug')}`;
      const formatDate = (value: unknown) => {
        if (!value) return '';
        const raw = String(value);
        const parsed = new Date(raw);
        return Number.isNaN(parsed.getTime()) ? raw.slice(0, 10) : parsed.toISOString().slice(0, 10);
      };
      const today = () => {
        const date = new Date();
        date.setMinutes(date.getMinutes() - date.getTimezoneOffset());
        return date.toISOString().slice(0, 10);
      };

      const fillCategorySelect = (selected = '') => {
        const select = field<HTMLSelectElement>('category');
        if (!select) return;
        select.replaceChildren(...categories.map((category) => new Option(category.label, category.label)));
        if (selected && !categories.some((category) => category.label === selected)) select.append(new Option(selected, selected));
        select.value = selected || categories[0]?.label || '';
      };
      const fillCategoryFilter = () => {
        if (!categoryFilter) return;
        const selected = categoryFilter.value;
        categoryFilter.replaceChildren(
          new Option('Tất cả', ''),
          ...categories.map((category) => new Option(category.label, category.label)),
        );
        categoryFilter.value = categories.some((category) => category.label === selected) ? selected : '';
      };
      const fillSubcategories = (selected = '') => {
        const select = field<HTMLSelectElement>('subcategory');
        if (!select || !subcategoryField) return;
        const values = [...(categoryConfig()?.subcategories ?? [])];
        if (selected && !values.includes(selected as never)) values.push(selected as never);
        select.replaceChildren(new Option('Không chọn', ''), ...values.map((value) => new Option(value, value)));
        select.value = selected;
        subcategoryField.hidden = values.length === 0;
        updatePath();
      };
      const updatePath = () => {
        if (pathLabel) pathLabel.textContent = read('slug') ? `src/content/bai-viet/${currentId()}.md` : `src/content/bai-viet/${currentFolder()}/…`;
      };

      const itemInScope = (item: StudioItem) => categories.some(({ label, folder }) => item.category === label || item.id.startsWith(`${folder}/`))
        || fallbackConfig.folders.some((folder) => item.id.startsWith(`${folder}/`));
      const renderList = () => {
        const query = (search?.value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
        const selectedCategory = categoryFilter?.value || '';
        const visible = items.filter(itemInScope)
          .filter((item) => !selectedCategory || item.category === selectedCategory)
          .filter((item) => `${item.title} ${item.id} ${item.category || ''}`.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().includes(query));
        list.replaceChildren(...visible.map((item) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'article-manager-list-item';
          button.dataset.id = item.id;
          button.setAttribute('role', 'listitem');
          if (active?.id === item.id) button.classList.add('is-active');
          const title = document.createElement('strong');
          title.textContent = item.title;
          const meta = document.createElement('span');
          const id = document.createElement('code');
          id.textContent = item.id;
          const state = document.createElement('small');
          const isTranslation = item.language === 'en' || Boolean(item.translationOf);
          state.textContent = kind === 'news' && item.featured ? 'Banner' : isTranslation ? 'Bản EN' : item.draft ? 'Bản nháp' : 'Công khai';
          state.className = kind === 'news' && item.featured ? 'is-featured' : isTranslation ? 'is-language' : item.draft ? 'is-draft' : 'is-public';
          meta.append(id, state);
          button.append(title, meta);
          button.addEventListener('click', () => openEntry(item.id));
          return button;
        }));
        if (empty) empty.hidden = visible.length !== 0;
      };

      const loadItems = async () => {
        const result = await request('/api/studio/items?collection=bai-viet');
        items = Array.isArray(result.items) ? result.items : [];
        renderList();
      };
      const loadTaxonomy = async () => {
        const result = await request(`/api/studio/article-taxonomy?kind=${encodeURIComponent(kind)}`);
        if (Array.isArray(result.categories) && result.categories.length) categories = result.categories;
        fillCategoryFilter();
      };
      const showFields = () => {
        if (formEmpty) formEmpty.hidden = true;
        if (fieldsWrap) fieldsWrap.hidden = false;
        if (footer) footer.hidden = false;
      };
      const populate = (entry: StudioEntry | null, creating = false) => {
        active = entry;
        isNew = creating;
        const fm = entry?.fm ?? {};
        const currentSlug = entry?.id.split('/').at(-1) ?? '';
        fillCategorySelect(String(fm.category || categories[0]?.label || ''));
        setValue('slug', currentSlug);
        setValue('language', fm.language || (String(entry?.id || '').endsWith('-en') ? 'en' : 'vi'));
        setValue('translationOf', fm.translationOf || '');
        setValue('title', fm.title);
        setValue('subtitle', fm.subtitle);
        setValue('author', fm.author);
        setValue('date', formatDate(fm.date) || today());
        fillSubcategories(String(fm.subcategory || ''));
        setValue('excerpt', fm.excerpt);
        setListValue('authorDetails', fm.authorDetails);
        setListValue('tags', fm.tags);
        setValue('image', imageValue(fm.image));
        setValue('heroImage', imageValue(fm.heroImage));
        root.querySelectorAll<HTMLElement>('[data-article-image-picker]').forEach((picker) => picker.dispatchEvent(new CustomEvent('article-image:refresh')));
        const featured = field<HTMLInputElement>('featured');
        const draft = field<HTMLInputElement>('draft');
        if (featured) featured.checked = fm.featured === true;
        const isTranslation = String(fm.language || '') === 'en' || Boolean(fm.translationOf);
        if (draft) draft.checked = creating ? !isTranslation : fm.draft === true;
        if (translationField) translationField.hidden = !isTranslation;
        if (translationButton) {
          translationButton.hidden = creating || isTranslation;
          const translation = items.find((item) => item.translationOf === entry?.id || item.id === `${entry?.id}-en`);
          translationButton.textContent = translation ? 'Sửa bản EN' : '+ Bản EN';
          translationButton.dataset.translationId = translation?.id || '';
        }
        const body = field<HTMLTextAreaElement>('body');
        if (body) body.value = entry?.body || '';
        proseRoot?.inlineProseController?.setMarkdown(body?.value || '');
        proseRoot?.dispatchEvent(new CustomEvent('inline-prose:set'));
        deleteButton.hidden = creating;
        if (openLink) {
          const publicId = isTranslation ? String(fm.translationOf || '').trim() : entry?.id;
          const publicItem = items.find((item) => item.id === publicId);
          openLink.hidden = creating || fm.draft === true || (!entry?.route && !publicItem?.route);
          openLink.href = publicItem?.route || entry?.route || '#';
        }
        showFields();
        updatePath();
        setMessage(creating ? 'Bài mới mặc định là bản nháp.' : '');
        renderList();
        requestAnimationFrame(() => field<HTMLInputElement>(creating ? 'title' : 'slug')?.focus());
      };

      const openEntry = async (id: string) => {
        setMessage('Đang tải…');
        saveButton.disabled = true;
        try {
          const entry = await request(`/api/studio/item?collection=bai-viet&id=${encodeURIComponent(id)}`) as StudioEntry;
          populate(entry, false);
        } catch (error) {
          setMessage(error instanceof Error ? error.message : 'Không thể tải bài viết', true);
        } finally {
          saveButton.disabled = false;
        }
      };

      const openManager = async (editId = '') => {
        if (!dialog.open) dialog.showModal();
        setMessage('Đang tải danh sách…');
        try {
          await Promise.all([loadTaxonomy(), loadItems()]);
          setMessage('');
          if (editId) await openEntry(editId);
        } catch (error) {
          setMessage(error instanceof Error ? error.message : 'Không thể tải danh sách bài viết', true);
        }
      };
      const closeManager = () => dialog.close();

      const setTaxonomyMessage = (value = '', error = false) => {
        if (!taxonomyMessage) return;
        taxonomyMessage.textContent = value;
        taxonomyMessage.classList.toggle('is-error', error);
      };
      const taxonomyAction = async (payload: Record<string, unknown>) => {
        const result = await request('/api/studio/article-taxonomy', {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ kind, ...payload }),
        });
        if (Array.isArray(result.categories)) categories = result.categories;
        await loadItems();
        renderTaxonomy();
        fillCategorySelect(read('category'));
        fillSubcategories(read('subcategory'));
        window.clearTimeout(taxonomyReloadTimer);
        taxonomyReloadTimer = window.setTimeout(() => window.location.reload(), 850);
      };
      const renderTaxonomy = () => {
        if (!taxonomyList) return;
        taxonomyList.replaceChildren(...categories.map((category) => {
          const row = document.createElement('div');
          row.className = 'article-manager-taxonomy-row';
          const copy = document.createElement('div');
          copy.className = 'article-manager-taxonomy-copy';
          const label = document.createElement('strong');
          label.textContent = category.label;
          const folder = document.createElement('code');
          folder.textContent = category.folder;
          copy.append(label, folder);
          if (kind === 'scholar') {
            const subcategories = document.createElement('div');
            subcategories.className = 'article-manager-subtaxonomy';
            const subheading = document.createElement('span');
            subheading.className = 'article-manager-subtaxonomy-heading';
            subheading.textContent = 'Chuyên mục con';
            const sublist = document.createElement('div');
            sublist.className = 'article-manager-subtaxonomy-list';
            for (const subcategory of category.subcategories ?? []) {
              const subrow = document.createElement('span');
              subrow.className = 'article-manager-subtaxonomy-item';
              const sublabel = document.createElement('b');
              sublabel.textContent = subcategory;
              const renameSubcategory = document.createElement('button');
              renameSubcategory.type = 'button';
              renameSubcategory.textContent = 'Đổi';
              renameSubcategory.addEventListener('click', async () => {
                const nextLabel = window.prompt('Tên chuyên mục con mới:', subcategory)?.trim();
                if (!nextLabel || nextLabel === subcategory) return;
                try {
                  setTaxonomyMessage('Đang đổi tên chuyên mục con…');
                  await taxonomyAction({ action: 'rename-subcategory', label: category.label, subcategory, nextLabel });
                  setTaxonomyMessage('Đã đổi tên chuyên mục con và cập nhật các bài liên quan. Trang đang tải lại…');
                } catch (error) { setTaxonomyMessage(error instanceof Error ? error.message : 'Không thể đổi tên chuyên mục con', true); }
              });
              const removeSubcategory = document.createElement('button');
              removeSubcategory.type = 'button';
              removeSubcategory.textContent = 'Xóa';
              removeSubcategory.className = 'is-delete';
              removeSubcategory.addEventListener('click', async () => {
                const alternatives = (category.subcategories ?? []).filter((item) => item !== subcategory);
                let replacement = '';
                if (alternatives.length) {
                  const response = window.prompt(`Chuyển các bài thuộc “${subcategory}” sang chuyên mục con nào? Để trống để chuyển về “${category.label}”.`, alternatives[0]);
                  if (response === null) return;
                  replacement = response.trim();
                  if (replacement && !alternatives.includes(replacement)) return setTaxonomyMessage('Chuyên mục con nhận bài không tồn tại.', true);
                } else if (!window.confirm(`Xóa chuyên mục con “${subcategory}”? Các bài hiện có sẽ chuyển về “${category.label}”.`)) return;
                if (alternatives.length && !window.confirm(`Xóa chuyên mục con “${subcategory}” và cập nhật các bài liên quan?`)) return;
                try {
                  setTaxonomyMessage('Đang xóa chuyên mục con…');
                  await taxonomyAction({ action: 'delete-subcategory', label: category.label, subcategory, replacement });
                  setTaxonomyMessage('Đã xóa chuyên mục con an toàn. Trang đang tải lại…');
                } catch (error) { setTaxonomyMessage(error instanceof Error ? error.message : 'Không thể xóa chuyên mục con', true); }
              });
              subrow.append(sublabel, renameSubcategory, removeSubcategory);
              sublist.append(subrow);
            }
            const addSubcategory = document.createElement('button');
            addSubcategory.type = 'button';
            addSubcategory.className = 'article-manager-subtaxonomy-add';
            addSubcategory.textContent = '+ Thêm chuyên mục con';
            addSubcategory.addEventListener('click', async () => {
              const subcategory = window.prompt(`Tên chuyên mục con mới thuộc “${category.label}”:`)?.trim();
              if (!subcategory) return;
              try {
                setTaxonomyMessage('Đang thêm chuyên mục con…');
                await taxonomyAction({ action: 'add-subcategory', label: category.label, subcategory });
                setTaxonomyMessage('Đã thêm chuyên mục con. Trang đang tải lại…');
              } catch (error) { setTaxonomyMessage(error instanceof Error ? error.message : 'Không thể thêm chuyên mục con', true); }
            });
            subcategories.append(subheading, sublist, addSubcategory);
            copy.append(subcategories);
          }
          const actions = document.createElement('div');
          const rename = document.createElement('button');
          rename.type = 'button'; rename.textContent = 'Đổi tên';
          rename.addEventListener('click', async () => {
            const next = window.prompt('Tên chuyên mục mới:', category.label)?.trim();
            if (!next || next === category.label) return;
            try { setTaxonomyMessage('Đang đổi tên…'); await taxonomyAction({ action: 'rename', label: category.label, nextLabel: next }); setTaxonomyMessage('Đã đổi tên và cập nhật các bài liên quan. Trang đang tải lại…'); }
            catch (error) { setTaxonomyMessage(error instanceof Error ? error.message : 'Không thể đổi tên chuyên mục', true); }
          });
          const remove = document.createElement('button');
          remove.type = 'button'; remove.textContent = 'Xóa'; remove.className = 'is-delete';
          remove.disabled = categories.length < 2;
          remove.addEventListener('click', async () => {
            const alternatives = categories.filter((item) => item.label !== category.label);
            const suggested = alternatives[0]?.label || '';
            const replacement = window.prompt(`Các bài thuộc “${category.label}” sẽ được chuyển sang chuyên mục nào?`, suggested)?.trim();
            if (!replacement) return;
            if (!alternatives.some((item) => item.label === replacement)) return setTaxonomyMessage('Chuyên mục nhận bài không tồn tại.', true);
            if (!window.confirm(`Xóa chuyên mục “${category.label}” và chuyển các bài sang “${replacement}”?`)) return;
            try { setTaxonomyMessage('Đang chuyển bài và xóa chuyên mục…'); await taxonomyAction({ action: 'delete', label: category.label, replacement }); setTaxonomyMessage('Đã xóa chuyên mục an toàn. Trang đang tải lại…'); }
            catch (error) { setTaxonomyMessage(error instanceof Error ? error.message : 'Không thể xóa chuyên mục', true); }
          });
          actions.append(rename, remove); row.append(copy, actions); return row;
        }));
      };
      const showTaxonomy = async () => {
        try {
          await loadTaxonomy(); renderTaxonomy(); setTaxonomyMessage('');
          workspace?.classList.add('is-taxonomy');
          if (taxonomyPanel) taxonomyPanel.hidden = false;
        } catch (error) { setMessage(error instanceof Error ? error.message : 'Không thể tải chuyên mục', true); }
      };
      const hideTaxonomy = () => {
        if (taxonomyPanel) taxonomyPanel.hidden = true;
        workspace?.classList.remove('is-taxonomy');
      };

      trigger.addEventListener('click', () => openManager());
      closeButton?.addEventListener('click', closeManager);
      dialog.addEventListener('click', (event) => { if (event.target === dialog) closeManager(); });
      newButton?.addEventListener('click', () => populate(null, true));
      categoriesButton?.addEventListener('click', showTaxonomy);
      taxonomyBack?.addEventListener('click', hideTaxonomy);
      taxonomyAdd?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const label = taxonomyInput?.value.trim() || '';
        if (!label) return;
        try {
          setTaxonomyMessage('Đang thêm chuyên mục…');
          await taxonomyAction({ action: 'add', label });
          if (taxonomyInput) taxonomyInput.value = '';
          setTaxonomyMessage('Đã thêm chuyên mục. Trang đang tải lại…');
        } catch (error) { setTaxonomyMessage(error instanceof Error ? error.message : 'Không thể thêm chuyên mục', true); }
      });
      translationButton?.addEventListener('click', async () => {
        if (!active || isNew) return;
        const existingId = translationButton.dataset.translationId;
        if (existingId) return openEntry(existingId);
        const primary = active;
        const primaryId = primary.id;
        const primarySlug = primaryId.split('/').at(-1) || '';
        const fm = {
          ...primary.fm,
          title: String(primary.fm.subtitle || ''),
          subtitle: String(primary.fm.title || ''),
          featured: false,
          language: 'en',
          translationOf: primaryId,
          draft: false,
        };
        populate({ id: `${primaryId}-en`, fm, body: '', extension: '.md', checksum: '', route: primary.route }, true);
        setValue('slug', `${primarySlug}-en`);
        setMessage('Đang tạo bản EN công khai của bài này. Bản EN không phải là bài nháp độc lập.');
      });
      search?.addEventListener('input', renderList);
      categoryFilter?.addEventListener('change', renderList);
      field<HTMLSelectElement>('category')?.addEventListener('change', () => fillSubcategories());
      field<HTMLSelectElement>('language')?.addEventListener('change', () => {
        const isEnglish = read('language') === 'en';
        if (translationField) translationField.hidden = !isEnglish;
        if (!isEnglish) setValue('translationOf', '');
      });
      field<HTMLInputElement>('slug')?.addEventListener('input', updatePath);
      field<HTMLInputElement>('title')?.addEventListener('input', () => {
        if (isNew && !read('slug')) {
          setValue('slug', slugify(read('title')));
          updatePath();
        }
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const slug = slugify(read('slug'));
        setValue('slug', slug);
        if (!slug) return setMessage('Cần nhập slug hợp lệ.', true);
        proseRoot?.dispatchEvent(new CustomEvent('inline-prose:sync'));
        const body = proseRoot?.inlineProseController?.getMarkdown() ?? field<HTMLTextAreaElement>('body')?.value ?? '';
        const featured = field<HTMLInputElement>('featured');
        const draft = field<HTMLInputElement>('draft');
        const fm = {
          ...(active?.fm || {}),
          title: read('title'), subtitle: read('subtitle'), author: read('author'),
          authorDetails: readList('authorDetails'), category: read('category'),
          subcategory: read('subcategory'), excerpt: read('excerpt'), date: read('date'),
          tags: readList('tags'), image: read('image'), heroImage: read('heroImage'),
          language: read('language') || 'vi', translationOf: read('language') === 'en' ? read('translationOf') : '',
          featured: featured?.checked === true, draft: draft?.checked === true,
        };
        saveButton.disabled = true;
        deleteButton.disabled = true;
        setMessage('Đang lưu…');
        try {
          const result = await request('/api/studio/item', {
            method: isNew ? 'POST' : 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              collection: 'bai-viet', id: currentId(), originalId: active?.id || currentId(),
              fm, body, extension: active?.extension || '.md', checksum: active?.checksum || '',
            }),
          });
          setMessage('Đã lưu. Trang sẽ cập nhật sau hot reload…');
          active = { id: result.id, fm, body, extension: '.md', checksum: result.checksum || '', route: result.route };
          isNew = false;
          window.setTimeout(() => location.reload(), 550);
        } catch (error) {
          setMessage(error instanceof Error ? error.message : 'Không thể lưu bài viết', true);
          saveButton.disabled = false;
          deleteButton.disabled = false;
        }
      });

      deleteButton.addEventListener('click', async () => {
        if (!active || isNew) return;
        const title = String(active.fm.title || active.id);
        if (!window.confirm(`Xóa “${title}”? File sẽ được chuyển vào thư mục khôi phục.`)) return;
        saveButton.disabled = true;
        deleteButton.disabled = true;
        setMessage('Đang xóa…');
        try {
          await request(`/api/studio/item?collection=bai-viet&id=${encodeURIComponent(active.id)}`, { method: 'DELETE' });
          setMessage('Đã chuyển bài vào thư mục khôi phục.');
          window.setTimeout(() => location.reload(), 500);
        } catch (error) {
          setMessage(error instanceof Error ? error.message : 'Không thể xóa bài viết', true);
          saveButton.disabled = false;
          deleteButton.disabled = false;
        }
      });

      root.addEventListener('click', (event) => {
        const edit = (event.target as HTMLElement).closest<HTMLElement>('[data-article-inline-edit]');
        if (!edit) return;
        event.preventDefault();
        event.stopPropagation();
        openManager(edit.dataset.articleInlineEdit || '');
      });
      document.addEventListener('click', (event) => {
        const edit = (event.target as HTMLElement).closest<HTMLElement>('[data-article-inline-edit]');
        if (!edit || root.contains(edit)) return;
        event.preventDefault();
        event.stopPropagation();
        openManager(edit.dataset.articleInlineEdit || '');
      }, true);

      request('/api/studio/manifest').then(() => {
        root.dataset.adminAvailable = 'true';
        document.body.dataset.articleInline = '1';
      }).catch(() => root.remove());
    });
  };

  initArticleManagers();
  document.addEventListener('astro:page-load', initArticleManagers);
</script>

