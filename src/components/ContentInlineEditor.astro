---
import InlineProseEditor from './InlineProseEditor.astro';
import ArticleImagePicker from './ArticleImagePicker.astro';

interface Props {
  entryId: string;
  label?: string;
  variant?: 'primary' | 'en';
  kind?: 'news' | 'scholar' | 'spirituality' | 'sermon';
}

const { entryId, label = 'Sửa bài viết', variant = 'primary', kind = 'scholar' } = Astro.props;
---

<div class="content-inline-editor" data-content-inline-root data-entry-id={entryId} data-content-inline-variant={variant} data-article-kind={kind}>
  <button
    type="button"
    class="content-inline-trigger"
    aria-label={label}
    title={label}
  >
    <span aria-hidden="true">✎</span><span>{label}</span>
  </button>

  <dialog class="content-inline-dialog" aria-labelledby="contentInlineTitle">
    <form method="dialog" class="content-inline-form">
      <header>
        <div>
          <small>Biên tập trực tiếp · Bài viết</small>
          <h2 id="contentInlineTitle">{label}</h2>
        </div>
        <button type="button" class="content-inline-close" aria-label="Đóng">×</button>
      </header>

      <div class="content-inline-fields">
        <label class="content-inline-full"><span>Tiêu đề</span><input data-field="title" type="text" required /></label>
        <label class="content-inline-full"><span>Phụ đề</span><input data-field="subtitle" type="text" /></label>
        <label><span>Tác giả</span><input data-field="author" type="text" /></label>
        <label><span>Ngày đăng</span><input data-field="date" type="date" /></label>
        <label><span>Chuyên mục</span><select data-field="category"></select></label>
        <label data-subcategory-field><span>Chuyên mục con</span><select data-field="subcategory"></select></label>
        <label class="content-inline-full"><span>Mô tả ngắn</span><textarea data-field="excerpt" rows="3"></textarea></label>
        <label class="content-inline-full"><span>Thông tin tác giả <small>mỗi dòng một mục</small></span><textarea data-field="authorDetails" rows="3"></textarea></label>
        <label class="content-inline-full"><span>Bài đọc phụng vụ <small>mỗi dòng một bài</small></span><textarea data-field="readings" rows="3"></textarea></label>
        <label class="content-inline-full"><span>Từ khóa <small>mỗi dòng một từ khóa</small></span><textarea data-field="tags" rows="3"></textarea></label>
        <ArticleImagePicker dataField="image" label="Ảnh thumbnail" />
        <ArticleImagePicker dataField="heroImage" label="Ảnh hero" />
        <div class="content-inline-checks content-inline-full">
          <label><input data-field="featured" type="checkbox" /><span>Bài nổi bật</span></label>
          <label><input data-field="draft" type="checkbox" /><span>Bản nháp</span></label>
        </div>
        <div class="content-inline-full">
          <InlineProseEditor dataField="body" label="Nội dung bài viết" />
        </div>
      </div>

      <footer>
        <p class="content-inline-message" role="status"></p>
        <button type="button" class="content-inline-delete">Xóa bài</button>
        <button type="button" class="content-inline-cancel">Hủy</button>
        <button type="submit" class="content-inline-save">Lưu thay đổi</button>
      </footer>
    </form>
  </dialog>
</div>

<script>
  type Item = {
    id: string;
    fm: Record<string, unknown>;
    body: string;
    extension: string;
    checksum: string;
    route?: string;
  };
  type TaxonomyCategory = { label: string; folder: string; subcategories?: string[] };

  const initializeContentInlineEditors = () => {
    document.querySelectorAll<HTMLElement>('[data-content-inline-root]:not([data-content-inline-ready])').forEach((root) => {
      root.dataset.contentInlineReady = 'true';
      const ADMIN = `${window.location.protocol}//${window.location.hostname}:4322`;
      const entryId = root.dataset.entryId || '';
      const articleKind = root.dataset.articleKind || 'scholar';
      const trigger = root.querySelector<HTMLButtonElement>('.content-inline-trigger');
      const dialog = root.querySelector<HTMLDialogElement>('.content-inline-dialog');
      const form = root.querySelector<HTMLFormElement>('.content-inline-form');
      const title = root.querySelector<HTMLElement>('#contentInlineTitle');
      const message = root.querySelector<HTMLElement>('.content-inline-message');
      const save = root.querySelector<HTMLButtonElement>('.content-inline-save');
      const deleteButton = root.querySelector<HTMLButtonElement>('.content-inline-delete');
      const proseRoot = root.querySelector<HTMLElement>('[data-inline-prose-editor]');
      const subcategoryField = root.querySelector<HTMLElement>('[data-subcategory-field]');
      const field = <T extends HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(name: string) => root.querySelector<T>(`[data-field="${name}"]`);
      let active: Item | null = null;
      let categories: TaxonomyCategory[] = [];

      if (!entryId || !trigger || !dialog || !form || !message || !save) {
        root.remove();
        return;
      }

      const request = async (path: string, options?: RequestInit) => {
        const response = await fetch(ADMIN + path, options);
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || `HTTP ${response.status}`);
        return data;
      };
      const setMessage = (value = '', isError = false) => {
        message.textContent = value;
        message.classList.toggle('is-error', isError);
      };
      const textValue = (name: string, value: unknown) => {
        const input = field(name);
        if (input) input.value = value == null ? '' : String(value);
      };
      const listValue = (name: string, value: unknown) => textValue(name, Array.isArray(value) ? value.join('\n') : '');
      const splitList = (name: string) => (field<HTMLTextAreaElement>(name)?.value || '')
        .split(/\r?\n/).map((item) => item.trim()).filter(Boolean);
      const imageValue = (value: unknown) => {
        if (typeof value === 'string') return value;
        if (value && typeof value === 'object' && 'src' in value) return String((value as { src?: string }).src || '');
        return '';
      };
      const fillCategorySelect = (selected = '') => {
        const select = field<HTMLSelectElement>('category');
        if (!select) return;
        const values = [...categories];
        if (selected && !values.some((category) => category.label === selected)) {
          values.push({ label: selected, folder: entryId.split('/')[0] || '' });
        }
        select.replaceChildren(...values.map((category) => new Option(category.label, category.label)));
        select.value = selected || values[0]?.label || '';
      };
      const fillSubcategorySelect = (selected = '') => {
        const select = field<HTMLSelectElement>('subcategory');
        if (!select) return;
        const currentCategory = field<HTMLSelectElement>('category')?.value || '';
        const category = categories.find((item) => item.label === currentCategory);
        const values = [...(category?.subcategories || [])];
        if (selected && !values.includes(selected)) values.push(selected);
        select.replaceChildren(new Option('Không chọn', ''), ...values.map((value) => new Option(value, value)));
        select.value = selected;
        if (subcategoryField) subcategoryField.hidden = values.length === 0;
      };

      const close = () => {
        active = null;
        dialog.close();
      };

      const open = async () => {
        dialog.showModal();
        setMessage('Đang tải…');
        save.disabled = true;
        try {
          const [entry, taxonomy] = await Promise.all([
            request(`/api/studio/item?collection=bai-viet&id=${encodeURIComponent(entryId)}`),
            request(`/api/studio/article-taxonomy?kind=${encodeURIComponent(articleKind)}`),
          ]);
          active = entry as Item;
          categories = Array.isArray(taxonomy.categories) ? taxonomy.categories : [];
          const fm = active.fm || {};
          if (title) title.textContent = String(fm.title || entryId);
          textValue('title', fm.title);
          textValue('subtitle', fm.subtitle);
          textValue('author', fm.author);
          textValue('date', String(fm.date || '').slice(0, 10));
          fillCategorySelect(String(fm.category || ''));
          fillSubcategorySelect(String(fm.subcategory || ''));
          textValue('excerpt', fm.excerpt);
          listValue('authorDetails', fm.authorDetails);
          listValue('readings', fm.readings);
          listValue('tags', fm.tags);
          textValue('image', imageValue(fm.image));
          textValue('heroImage', imageValue(fm.heroImage));
          root.querySelectorAll<HTMLElement>('[data-article-image-picker]').forEach((picker) => picker.dispatchEvent(new CustomEvent('article-image:refresh')));
          const featured = field<HTMLInputElement>('featured');
          const draft = field<HTMLInputElement>('draft');
          if (featured) featured.checked = fm.featured === true;
          if (draft) draft.checked = fm.draft === true;
          const body = field<HTMLTextAreaElement>('body');
          if (body) body.value = active.body || '';
          proseRoot?.dispatchEvent(new CustomEvent('inline-prose:set'));
          save.disabled = false;
          setMessage('');
          requestAnimationFrame(() => field<HTMLInputElement>('title')?.focus());
        } catch (error) {
          active = null;
          setMessage(error instanceof Error ? error.message : 'Không thể tải bài viết', true);
        }
      };

      trigger.addEventListener('click', open);
      field<HTMLSelectElement>('category')?.addEventListener('change', () => fillSubcategorySelect(''));
      root.querySelector('.content-inline-close')?.addEventListener('click', close);
      root.querySelector('.content-inline-cancel')?.addEventListener('click', close);
      dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });

      deleteButton?.addEventListener('click', async () => {
        if (!active) return;
        const articleTitle = String(active.fm?.title || active.id);
        if (!window.confirm(`Xóa “${articleTitle}”? File sẽ được chuyển vào thư mục khôi phục.`)) return;
        deleteButton.disabled = true;
        save.disabled = true;
        setMessage('Đang xóa…');
        try {
          await request(`/api/studio/item?collection=bai-viet&id=${encodeURIComponent(active.id)}`, { method: 'DELETE' });
          setMessage('Đã chuyển bài vào thư mục khôi phục…');
          const folder = active.id.split('/')[0];
          const route = folder === 'linh-dao' ? '/linh-dao/'
            : folder === 'sinh-hoat-cong-doan' ? '/tin-tuc/'
            : folder === 'bai-giang-suy-niem' ? '/bai-giang-suy-niem/'
            : '/bai-viet/';
          window.setTimeout(() => { location.href = route; }, 350);
        } catch (error) {
          deleteButton.disabled = false;
          save.disabled = false;
          setMessage(error instanceof Error ? error.message : 'Không thể xóa bài viết', true);
        }
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!active || !form.reportValidity()) return;
        proseRoot?.dispatchEvent(new CustomEvent('inline-prose:sync'));
        save.disabled = true;
        setMessage('Đang lưu…');
        const read = (name: string) => field(name)?.value.trim() || '';
        const featured = field<HTMLInputElement>('featured');
        const draft = field<HTMLInputElement>('draft');
        const fm = {
          ...active.fm,
          title: read('title'),
          subtitle: read('subtitle'),
          author: read('author'),
          authorDetails: splitList('authorDetails'),
          category: read('category'),
          subcategory: read('subcategory'),
          excerpt: read('excerpt'),
          date: read('date'),
          readings: splitList('readings'),
          tags: splitList('tags'),
          image: read('image'),
          heroImage: read('heroImage'),
          featured: featured?.checked === true,
          draft: draft?.checked === true,
        };
        try {
          const result = await request('/api/studio/item', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              collection: 'bai-viet', id: active.id, originalId: active.id,
              fm, body: field<HTMLTextAreaElement>('body')?.value || active.body,
              extension: active.extension, checksum: active.checksum,
            }),
          });
          setMessage('Đã lưu. Đang cập nhật trang…');
          window.setTimeout(() => {
            const route = typeof result.route === 'string' ? result.route : location.href;
            location.href = route;
          }, 350);
        } catch (error) {
          save.disabled = false;
          setMessage(error instanceof Error ? error.message : 'Không thể lưu thay đổi', true);
        }
      });

      request('/api/studio/manifest').then(() => {
        root.dataset.adminAvailable = 'true';
        document.body.dataset.contentInline = '1';
      }).catch(() => root.remove());
    });
  };

  initializeContentInlineEditors();
  document.addEventListener('astro:page-load', initializeContentInlineEditors);
</script>

